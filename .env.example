# ─────────────────────────────────────────────
# CoreMail — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

NODE_ENV=production

# Mail Hostname (your mail server's FQDN)
MAIL_HOSTNAME=mail.yourdomain.com

# ─── PostgreSQL ──────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password-32chars

# ─── Redis ───────────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ─── MinIO (Object Storage) ──────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# ─── JWT & Security ──────────────────────────
# Must be at least 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-must-be-at-least-32-characters-long
PEPPER=change-me-pepper-must-be-at-least-32-characters-long

# ─── GeoIP (MaxMind) — Optional ──────────────
# Register free at https://www.maxmind.com/en/geolite2/signup
# Leave empty to disable country filtering
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ─── Log Level ───────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
