# ═════════════════════════════════════════════════════════════════════════════
#  CoreMail 5.8.0 — .env  (neben docker-compose.yml bzw. im Repo-Root)
#
#  Schnell:   bash scripts/setup.sh        → erzeugt diese Datei mit Zufallswerten
#  Manuell:   cp .env.example .env         → die 5 CHANGE-ME-Werte ersetzen
#  Schlüssel: openssl rand -hex 32
#
#  Hostname, Domains, Zertifikate, Konnektoren usw. werden NICHT hier, sondern
#  nach dem Start im Admin-Panel (http://<server>:3000/bcp/) oder per CLI
#  (`docker exec -it coremail coremail --help`) eingerichtet.
# ═════════════════════════════════════════════════════════════════════════════


# ── Pflicht (5 Werte) ─────────────────────────────────────────────────────────

# Signiert Login-Tokens (Webmail, Admin-Panel, JMAP). Mind. 32 Zeichen.
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32

# Zusatz-Geheimnis für Passwort-Hashes. Mind. 32 Zeichen.
# ACHTUNG: nach dem ersten Start NIE ändern — alle Passwörter würden ungültig.
PEPPER=CHANGE-ME-openssl-rand-hex-32

# Passwörter der internen Datenbanken (nur zwischen den Containern genutzt)
POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-hex-20
REDIS_PASSWORD=CHANGE-ME-openssl-rand-hex-20
MINIO_ROOT_PASSWORD=CHANGE-ME-openssl-rand-hex-20


# ── Optional — Defaults passen für die meisten Installationen ────────────────

# Version des App-Images (Docker Hub: magpeek/coremail-app)
#COREMAIL_VERSION=5.8.0

# Protokollierung: error | warn | info | debug
#LOG_LEVEL=info

# Zeitzone des Servers (Logs, Zeitpläne)
#TZ=Europe/Berlin

# MinIO-Benutzername (Konsole: ssh -L 9001:localhost:9001 <server> → http://localhost:9001)
#MINIO_ROOT_USER=minioadmin

# Tägliches Vollbackup / Aufbewahrungsrichtlinien (Cron, UTC) und Backup-Vorhaltezeit
#BACKUP_SCHEDULE=0 2 * * *
#BACKUP_RETENTION_DAYS=30
#RETENTION_SCHEDULE=0 3 * * *

# Ressourcen-Obergrenze des App-Containers
#COREMAIL_CPU_LIMIT=2
#COREMAIL_MEM_LIMIT=2g

# Browser-Push-Benachrichtigungen im Webmail (leer = aus)
#   Schlüssel erzeugen: npx web-push generate-vapid-keys
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com

# Anderer HTTPS-Port, falls 443 am Host belegt ist (Port-Mapping in der Compose anpassen)
#HTTPS_PORT=8443
