# ═════════════════════════════════════════════════════════════════════════════
#  CoreMail 8.0.0 — .env  (next to docker-compose.yml or in the repo root)
#
#  Quick:     bash scripts/setup.sh        → generates this file with random values
#  Manual:    cp .env.example .env         → replace the 5 CHANGE-ME values
#  Keys:      openssl rand -hex 32
#
#  Hostname, domains, certificates, connectors etc. are NOT configured here but
#  after startup in the admin panel (http://<server>:3000/bcp/) or via CLI
#  (`docker exec -it coremail coremail --help`).
# ═════════════════════════════════════════════════════════════════════════════


# ── Required (5 values) ───────────────────────────────────────────────────────

# Signs login tokens (webmail, admin panel, JMAP). At least 32 characters.
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32

# Additional secret for password hashes. At least 32 characters.
# WARNING: NEVER change after the first start — all passwords would become invalid.
PEPPER=CHANGE-ME-openssl-rand-hex-32

# Passwords of the internal databases (used only between the containers;
# MinIO also stores the backups, so it is required with every storage driver)
POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-hex-20
REDIS_PASSWORD=CHANGE-ME-openssl-rand-hex-20
MINIO_ROOT_PASSWORD=CHANGE-ME-openssl-rand-hex-20


# ── Generated by scripts/setup.sh (docs/deployment-security.md) ───────────────

# Backup encryption (AES-256-GCM): 64 hex characters (openssl rand -hex 32).
# KEEP A COPY OFF THIS SERVER — encrypted backups cannot be restored without it.
# Empty = derived from JWT_SECRET + PEPPER (a warning is logged).
#BACKUP_ENCRYPTION_KEY=

# rspamd controller password (web UI via ssh tunnel). The CoreMail container is
# the only address the controller trusts without it.
#RSPAMD_CONTROLLER_PASSWORD=

# Least-privilege database role (no superuser). Only for a NEW database: the role
# is created on the first start of an empty postgres volume (postgres/02-app-role.sh).
# Unset = the app connects as the superuser "coremail" (installations before this
# option). Switching an existing installation: docs/deployment-security.md.
#COREMAIL_DB_USER=coremail_app
#COREMAIL_DB_PASSWORD=


# ── Mail storage (v8.0, docs/storage.md) ──────────────────────────────────────

# Where mail contents, attachments and quarantined mails are stored:
#   filesystem  Docker volume coremail-data (/data/objects) — default for new installations
#   minio       bundled MinIO container — used when this line is missing (installations
#               from before 8.0 keep working unchanged; moving is optional:
#               coremail storage migrate --from minio --to filesystem)
#   s3          external S3: AWS, Backblaze B2, Wasabi, Hetzner, Cloudflare R2 (settings below)
# Never change it on a running installation without migrating first.
OBJECT_STORAGE=filesystem

# External S3 (OBJECT_STORAGE=s3 or a MinIO with TLS). Defaults = bundled MinIO.
#MINIO_ENDPOINT=s3.eu-central-1.amazonaws.com     # host name or https://host[:port]
#MINIO_USE_SSL=true                                # default false (bundled MinIO)
#MINIO_PORT=443                                    # default 9000, or 443 with TLS
#MINIO_REGION=eu-central-1                         # R2: auto
#MINIO_PATH_STYLE=false                            # virtual-host style (bucket.host); default: client decides
#MINIO_CA_FILE=/etc/coremail/s3-ca.pem             # private CA (mount the file into the container)
#MINIO_ACCESS_KEY=
#MINIO_SECRET_KEY=
#MINIO_BUCKET_ATTACHMENTS=coremail-attachments


# ── Optional — defaults suit most installations ───────────────────────────────

# Version of the app image (Docker Hub: magpeek/coremail-app)
#COREMAIL_VERSION=8.0.0

# Logging: error | warn | info | debug
#LOG_LEVEL=info

# Server time zone (logs, schedules)
#TZ=Europe/Berlin

# Encryption key for TOTP (2FA) secrets at rest (AES-256-GCM), 64 hex characters.
# Empty = derived from JWT_SECRET + PEPPER (then rotating either makes 2FA secrets
# unreadable). Can be set later: existing secrets are re-encrypted on next use.
#MFA_ENCRYPTION_KEY=openssl-rand-hex-32

# WebAuthn relying party (default: ServerSettings.publicHostname, origin https://<host>)
#WEBAUTHN_RP_ID=mail.example.com
#WEBAUTHN_ORIGIN=https://mail.example.com

# SSO (OIDC): public base URL for the redirect URI <base>/auth/sso/<providerId>/callback
# (default: ServerSettings publicHostname/useHttps/httpPort)
#COREMAIL_PUBLIC_URL=https://mail.example.com
# LDAP: plain ldap:// without StartTLS is refused unless the directory is on
# localhost or this is set (trusted network only — passwords travel in clear text)
#LDAP_ALLOW_INSECURE=false

# MinIO user name (console: ssh -L 9001:localhost:9001 <server> → http://localhost:9001)
#MINIO_ROOT_USER=minioadmin

# Daily full backup / retention policies (cron, UTC) and backup retention period
#BACKUP_SCHEDULE=0 2 * * *
#BACKUP_RETENTION_DAYS=30
#RETENTION_SCHEDULE=0 3 * * *

# Database schema updates that would DELETE data stop the start (nothing is
# changed). Set to true for ONE start after a backup — CoreMail then writes
# /data/backups/pre-migrate-<timestamp>.sql.gz (volume coremail-data) first.
#COREMAIL_ALLOW_SCHEMA_DATA_LOSS=false

# Subnet prefix of the dedicated app <-> rspamd network (<prefix>.0/29, app = .2,
# rspamd = .3). Change only if 10.253.253.0/29 collides with a host/LAN network.
#RSPAMD_NET_PREFIX=10.253.253

# Resource limits of the app container
#COREMAIL_CPU_LIMIT=2
#COREMAIL_MEM_LIMIT=2g

# Browser push notifications in webmail (empty = off)
#   Generate keys: npx web-push generate-vapid-keys
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com

# Different HTTPS port if 443 is already in use on the host (adjust port mapping in the Compose file)
#HTTPS_PORT=8443

# ── Security / networking (v6) ────────────────────────────────────────────────

# Reverse proxy trust for port 3000 (default: off). Port 3000 and the integrated
# HTTPS proxy serve clients DIRECTLY — trusting X-Forwarded-For there lets anyone
# spoof their IP (rate-limit bypass, forged audit IPs). Set it ONLY when a proxy
# that overwrites X-Forwarded-For (Traefik, Caddy, nginx, Synology DSM) is the
# sole way to reach port 3000:  a hop count ("1"), or the proxy address/CIDR
# ("172.18.0.0/16", "loopback", "uniquelocal"). Requests via the integrated
# HTTPS proxy (port 443) never honour forwarded headers.
# Without it, behind a proxy all clients share one IP for rate limiting.
#TRUST_PROXY=

# One-time token for the setup wizard. If unset, a random token is printed to
# the log at start while setup is pending:  docker logs coremail | grep -i "setup token"
# Set it (>= 16 characters) for multi-instance deployments.
#SETUP_TOKEN=

# Internal services (auth, backup, security-filter, CalDAV, JMAP, ActiveSync,
# Autodiscover) listen on 127.0.0.1. Multi-host deployments (Kubernetes) set 0.0.0.0
# AND an INTERNAL_API_TOKEN (shared secret for /internal/* service routes).
#INTERNAL_BIND_HOST=127.0.0.1
#INTERNAL_API_TOKEN=

# Outbound smarthost (BCP → SMTP configuration): its TLS certificate is verified.
# Only for a smarthost with a self-signed certificate: true disables the check.
#SMARTHOST_TLS_INSECURE=false
