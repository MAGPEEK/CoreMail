# ─────────────────────────────────────────────────────────────────────────────
# CoreMail — Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an.
# ─────────────────────────────────────────────────────────────────────────────

# Betriebsmodus
NODE_ENV=production

# Vollständiger Hostname des Mailservers (FQDN), z.B. mail.firma.de
MAIL_HOSTNAME=mail.example.com

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Starkes Passwort (mind. 32 Zeichen): openssl rand -hex 20
POSTGRES_PASSWORD=change-me-strong-postgres-password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ─── MinIO (Objektspeicher für Anhänge & Backups) ────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# ─── JWT & Sicherheit ─────────────────────────────────────────────────────────
# Mind. 64 Zeichen: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-must-be-at-least-64-characters-long-generate-with-openssl
# Pepper für bcrypt-Hashes: openssl rand -hex 32
PEPPER=change-me-pepper-must-be-at-least-32-characters-long

# ─── GeoIP (MaxMind) — optional ───────────────────────────────────────────────
# Kostenloses Konto: https://www.maxmind.com/en/geolite2/signup
# Leer lassen, um Country-Filtering zu deaktivieren.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ─── Backup ───────────────────────────────────────────────────────────────────
# Cron-Ausdruck für automatischen Vollbackup (Standard: täglich 02:00 UTC)
BACKUP_SCHEDULE=0 2 * * *
# Aufbewahrungsdauer in Tagen
BACKUP_RETENTION_DAYS=30

# ─── Grafana (Observability-Profil) ───────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# ─── Log-Level ────────────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info

# ─── TLS-Zertifikate (nginx) ──────────────────────────────────────────────────
# Lege deine Zertifikate unter infra/docker/nginx/certs/ ab:
#   fullchain.pem  — Zertifikat + Zwischenzertifikate
#   privkey.pem    — Privater Schlüssel
# Für Entwicklung: siehe scripts/gen-dev-certs.sh
