# ═══════════════════════════════════════════════════════════════════════════════
# CoreMail v2.1.36 — Umgebungsvariablen
#
# Schnellstart:
#   cp .env.example .env
#   # Alle "CHANGE-ME"-Werte ersetzen (siehe Abschnitt "Pflichtfelder")
#   docker compose up -d
#
# Schlüssel generieren:
#   openssl rand -hex 32    → für JWT_SECRET, PEPPER, Passwörter
#   npx web-push generate-vapid-keys  → für VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY
# ═══════════════════════════════════════════════════════════════════════════════


# ── Pflichtfelder ─────────────────────────────────────────────────────────────
# Diese Werte MÜSSEN vor dem ersten Start gesetzt werden.

# JWT-Signaturschlüssel — mind. 32 Zeichen
# Generieren: openssl rand -hex 32
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32

# bcrypt-Pepper für Passwort-Hashes — mind. 32 Zeichen
# Generieren: openssl rand -hex 32
# ACHTUNG: Änderung invalidiert alle bestehenden Passwörter!
PEPPER=CHANGE-ME-openssl-rand-hex-32

# PostgreSQL-Passwort
POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-hex-20

# Redis-Passwort
REDIS_PASSWORD=CHANGE-ME-openssl-rand-hex-20

# MinIO-Passwort (mind. 8 Zeichen)
MINIO_ROOT_PASSWORD=CHANGE-ME-openssl-rand-hex-20


# ── MinIO ─────────────────────────────────────────────────────────────────────
# Benutzername für MinIO-Admin-Konsole (http://<host>:9001)
MINIO_ROOT_USER=minioadmin


# ── Betriebsumgebung ──────────────────────────────────────────────────────────
NODE_ENV=production

# Log-Level: error | warn | info | debug
LOG_LEVEL=info


# ── Backup ────────────────────────────────────────────────────────────────────
# Cron-Ausdruck für automatischen Vollbackup (UTC)
# Standard: täglich 02:00 Uhr
BACKUP_SCHEDULE=0 2 * * *

# Anzahl Tage, wie lange Backups aufbewahrt werden
BACKUP_RETENTION_DAYS=30

# Cron-Ausdruck für Aufbewahrungsrichtlinien-Job (UTC)
# Standard: täglich 03:00 Uhr
RETENTION_SCHEDULE=0 3 * * *


# ── VAPID Web Push — optional ─────────────────────────────────────────────────
# Ermöglicht Browser-Push-Benachrichtigungen für neue Mails.
# Leer lassen um Push zu deaktivieren.
#
# Schlüssel generieren:
#   npx web-push generate-vapid-keys
#
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Pflicht wenn VAPID aktiv: mailto: oder https: URL
VAPID_SUBJECT=mailto:admin@example.com


# ── SMTP-Gateway-Modus — optional ────────────────────────────────────────────
# Relay-Betrieb: CoreMail empfängt Mails und leitet sie an einen vorgelagerten
# MTA weiter (z.B. Exchange on-prem, Postfix, Office 365 Smart Host).
# Standard: deaktiviert (false)
GATEWAY_MODE=false

# Hostname/IP des vorgelagerten SMTP-Servers
# GATEWAY_UPSTREAM_HOST=smtp.intern.example.com

# SMTP-Port des Upstream-Servers (Standard: 25)
# GATEWAY_UPSTREAM_PORT=25

# STARTTLS/TLS für Upstream-Verbindung (true | false)
# GATEWAY_UPSTREAM_TLS=false

# SMTP-Auth für Upstream (leer lassen wenn keine Auth nötig)
# GATEWAY_UPSTREAM_USER=
# GATEWAY_UPSTREAM_PASS=

# Kommagetrennte Domains die relayed werden (leer = alle Domains)
# GATEWAY_DOMAINS=example.com,corp.internal

# Spam-/Virenschutz vor dem Relay ausführen (empfohlen)
GATEWAY_FILTER=true


# ── GeoIP / Country-Filtering — optional ──────────────────────────────────────
# Kostenloses MaxMind-Konto: https://www.maxmind.com/en/geolite2/signup
# Leer lassen um Country-Filtering zu deaktivieren.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=


# ── S/MIME — optional ─────────────────────────────────────────────────────────
# Globales Passwort für PKCS#12-Zertifikatsbundles in MinIO.
# Leer lassen wenn Zertifikate ohne Passwort sind.
# SMIME_P12_PASSWORD=


# ── Hostname / Mailserver-Konfiguration ──────────────────────────────────────
# Der Mailserver-Hostname (FQDN) wird im Admin-Panel unter
# "Server-Einstellungen" konfiguriert und in der Datenbank gespeichert.
# Er gilt global für SMTP-EHLO-Banner, IMAP/POP3-Begrüßung und Autodiscover.
#
# Migrations-Hinweis: Falls MAIL_HOSTNAME gesetzt ist, wird der Wert beim
# ersten Start automatisch in die Datenbank übernommen (einmalig).
# Danach kann die Variable entfernt werden.
# MAIL_HOSTNAME=mail.example.com
