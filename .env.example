# ═════════════════════════════════════════════════════════════════════════════
#  CoreMail 5.9.0 — .env  (next to docker-compose.yml or in the repo root)
#
#  Quick:     bash scripts/setup.sh        → generates this file with random values
#  Manual:    cp .env.example .env         → replace the 5 CHANGE-ME values
#  Keys:      openssl rand -hex 32
#
#  Hostname, domains, certificates, connectors etc. are NOT configured here but
#  after startup in the admin panel (http://<server>:3000/bcp/) or via CLI
#  (`docker exec -it coremail coremail --help`).
# ═════════════════════════════════════════════════════════════════════════════


# ── Required (5 values) ───────────────────────────────────────────────────────

# Signs login tokens (webmail, admin panel, JMAP). At least 32 characters.
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32

# Additional secret for password hashes. At least 32 characters.
# WARNING: NEVER change after the first start — all passwords would become invalid.
PEPPER=CHANGE-ME-openssl-rand-hex-32

# Passwords of the internal databases (used only between the containers)
POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-hex-20
REDIS_PASSWORD=CHANGE-ME-openssl-rand-hex-20
MINIO_ROOT_PASSWORD=CHANGE-ME-openssl-rand-hex-20


# ── Optional — defaults suit most installations ───────────────────────────────

# Version of the app image (Docker Hub: magpeek/coremail-app)
#COREMAIL_VERSION=5.9.0

# Logging: error | warn | info | debug
#LOG_LEVEL=info

# Server time zone (logs, schedules)
#TZ=Europe/Berlin

# MinIO user name (console: ssh -L 9001:localhost:9001 <server> → http://localhost:9001)
#MINIO_ROOT_USER=minioadmin

# Daily full backup / retention policies (cron, UTC) and backup retention period
#BACKUP_SCHEDULE=0 2 * * *
#BACKUP_RETENTION_DAYS=30
#RETENTION_SCHEDULE=0 3 * * *

# Resource limits of the app container
#COREMAIL_CPU_LIMIT=2
#COREMAIL_MEM_LIMIT=2g

# Browser push notifications in webmail (empty = off)
#   Generate keys: npx web-push generate-vapid-keys
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com

# Different HTTPS port if 443 is already in use on the host (adjust port mapping in the Compose file)
#HTTPS_PORT=8443
