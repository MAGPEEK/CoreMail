# ═════════════════════════════════════════════════════════════════════════════
#  CoreMail 10.6.1 — .env  (next to docker-compose.yml or in the repo root)
#
#  This file is OPTIONAL (10.4). Without it every Compose variant starts and
#  the coremail container generates all secrets into ./secrets/coremail.env next
#  to the Compose file (docs/setup.md "Automatic secrets"). A value set here always
#  wins and is copied into ./secrets/ — existing installations keep theirs.
#
#  Quick:     bash scripts/setup.sh        → generates this file with random values
#  Manual:    cp .env.example .env         → set only what you want to choose yourself
#  Keys:      openssl rand -hex 32
#
#  Hostname, domains, certificates, connectors etc. are NOT configured here but
#  after startup in the admin panel (setup wizard: http://<server>:3000/setup) or
#  via CLI (`docker exec -it coremail coremail --help`).
# ═════════════════════════════════════════════════════════════════════════════


# ── Secrets — all optional ────────────────────────────────────────────────────
# Each one: generated automatically into ./secrets/coremail.env when empty.
# Back up ./secrets/ (or this file) off the server either way.

# Signs login tokens (webmail, admin panel, JMAP). At least 32 characters.
JWT_SECRET=

# Additional secret for password hashes. At least 32 characters.
# WARNING: NEVER change after the first start — all passwords would become invalid.
PEPPER=

# Passwords of the internal databases (used only between the containers).
# PostgreSQL takes its password only when its volume is created: set
# POSTGRES_PASSWORD before the FIRST start or leave it empty.
# MINIO_ROOT_PASSWORD: used by docker-compose.yml and the Synology file (MinIO
# also stores the backups), the full variant only with the minio profile.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_PASSWORD=

# Where the secrets directory lives (default ./secrets next to the Compose file;
# Synology: /volume1/docker/coremail/secrets).
#COREMAIL_SECRETS_PATH=


# ── Also generated when empty (docs/deployment-security.md) ───────────────────

# Backup encryption (AES-256-GCM): 64 hex characters (openssl rand -hex 32).
# KEEP A COPY OFF THIS SERVER — encrypted backups cannot be restored without it.
# Empty = generated into ./secrets/coremail.env on a FRESH installation; an
# existing installation keeps deriving it from JWT_SECRET + PEPPER.
#BACKUP_ENCRYPTION_KEY=

# rspamd controller password (web UI via ssh tunnel). The CoreMail container is
# the only address the controller trusts without it. Empty = generated.
#RSPAMD_CONTROLLER_PASSWORD=

# Least-privilege database role (no superuser). Only for a NEW database: the role
# is created on the first start of an empty postgres volume (postgres/02-app-role.sh).
# Unset = the app connects as the superuser "coremail" (installations before this
# option). Switching an existing installation: docs/deployment-security.md.
#COREMAIL_DB_USER=coremail_app
#COREMAIL_DB_PASSWORD=


# ── Mail storage (docs/storage.md) ────────────────────────────────────────────

# Where mail contents, attachments and quarantined mails are stored:
#   filesystem  Docker volume coremail-data (/data/objects) — default for new installations
#   minio       bundled MinIO container — used when this line is missing (existing
#               installations keep working unchanged; moving is optional:
#               coremail storage migrate --from minio --to filesystem)
#   s3          external S3: AWS, Backblaze B2, Wasabi, Hetzner, Cloudflare R2 (settings below)
# Never change it on a running installation without migrating first.
OBJECT_STORAGE=filesystem

# External S3 (OBJECT_STORAGE=s3 or a MinIO with TLS). Defaults = bundled MinIO.
#MINIO_ENDPOINT=s3.eu-central-1.amazonaws.com     # host name or https://host[:port]
#MINIO_USE_SSL=true                                # default false (bundled MinIO)
#MINIO_PORT=443                                    # default 9000, or 443 with TLS
#MINIO_REGION=eu-central-1                         # R2: auto
#MINIO_PATH_STYLE=false                            # virtual-host style (bucket.host); default: client decides
#MINIO_CA_FILE=/etc/coremail/s3-ca.pem             # private CA (mount the file into the container)
#MINIO_ACCESS_KEY=
#MINIO_SECRET_KEY=
#MINIO_BUCKET_ATTACHMENTS=coremail-attachments


# ── Optional — defaults suit most installations ───────────────────────────────

# Version of the app image (Docker Hub: magpeek/coremail-app)
#COREMAIL_VERSION=10.6.1

# Logging: error | warn | info | debug
#LOG_LEVEL=info

# Server time zone (logs, schedules)
#TZ=Europe/Berlin

# Encryption key for TOTP (2FA) secrets and certificate private keys at rest
# (AES-256-GCM), 64 hex characters. Empty = derived from JWT_SECRET + PEPPER (then
# rotating either makes them unreadable — docs/certificates.md). Can be set later:
# existing values are re-encrypted on next use / next start.
#MFA_ENCRYPTION_KEY=openssl-rand-hex-32

# WebAuthn relying party for passkeys and security keys (docs/passkeys.md).
# RP ID default: frozen at the first passkey registration (BCP → Authentifizierung →
# Passkeys), else ServerSettings.publicHostname. Origins default: the public base URL
# (COREMAIL_PUBLIC_URL, else scheme + host + external port) plus the BCP's related
# origins. WEBAUTHN_ORIGIN takes a comma-separated list.
#WEBAUTHN_RP_ID=mail.example.com
#WEBAUTHN_ORIGIN=https://mail.example.com
#WEBAUTHN_RP_NAME=CoreMail

# SSO (OIDC): public base URL for the redirect URI <base>/auth/sso/<providerId>/callback
# (default: ServerSettings publicHostname/useHttps/httpPort)
#COREMAIL_PUBLIC_URL=https://mail.example.com
# LDAP: plain ldap:// without StartTLS is refused unless the directory is on
# localhost or this is set (trusted network only — passwords travel in clear text)
#LDAP_ALLOW_INSECURE=false

# MinIO user name (console: ssh -L 9001:localhost:9001 <server> → http://localhost:9001)
#MINIO_ROOT_USER=minioadmin

# Backup automation lives in BCP → Backup & Restore → Zeitpläne. BACKUP_SCHEDULE (cron, UTC)
# and BACKUP_RETENTION_DAYS are only the defaults of "Empfohlene Sicherung einrichten" there
# (nightly full backup + database backup) — they never start a backup by themselves.
# RETENTION_SCHEDULE runs the mailbox retention policies. Details: docs/backup.md
#BACKUP_SCHEDULE=0 2 * * *
#BACKUP_RETENTION_DAYS=30
#RETENTION_SCHEDULE=0 3 * * *

# Database schema updates that would DELETE data stop the start (nothing is
# changed). Set to true for ONE start after a backup — CoreMail then writes
# /data/backups/pre-migrate-<timestamp>.sql.gz (volume coremail-data) first.
#COREMAIL_ALLOW_SCHEMA_DATA_LOSS=false

# Subnet prefix of the dedicated app <-> rspamd network (<prefix>.0/29, app = .2,
# rspamd = .3). Change only if 10.253.253.0/29 collides with a host/LAN network.
#RSPAMD_NET_PREFIX=10.253.253

# Resource limits of the app container
#COREMAIL_CPU_LIMIT=2
#COREMAIL_MEM_LIMIT=2g

# Browser push notifications in webmail (empty = off)
#   Generate keys: npx web-push generate-vapid-keys
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com

# Different HTTPS port if 443 is already in use on the host. Not passed through by
# default: uncomment HTTPS_PORT in the Compose file's coremail environment and adjust
# the port mapping there.
#HTTPS_PORT=8443

# ── Security / networking ─────────────────────────────────────────────────────

# Reverse proxy trust for port 3000 (default: off). Port 3000 and the integrated
# HTTPS proxy serve clients DIRECTLY — trusting X-Forwarded-For there lets anyone
# spoof their IP (rate-limit bypass, forged audit IPs). Set it ONLY when a proxy
# that overwrites X-Forwarded-For (Traefik, Caddy, nginx, Synology DSM) is the
# sole way to reach port 3000:  a hop count ("1"), or the proxy address/CIDR
# ("172.18.0.0/16", "loopback", "uniquelocal"). Requests via the integrated
# HTTPS proxy (port 443) never honour forwarded headers.
# Without it, behind a proxy all clients share one IP for rate limiting.
#TRUST_PROXY=

# One-time token for the setup wizard. If unset, a random token is written to
# ./secrets/setup-token at start while setup is pending (without a secrets
# directory: printed to the log, docker logs coremail | grep -i "setup token").
# Set it (>= 16 characters) for multi-instance deployments.
#SETUP_TOKEN=

# Branding defaults (optional). Used while nothing is set in BCP → Branding
# (or after "Reset"); the BCP / `coremail branding set` values win.
# BRANDING_NAME: product name in the UI, browser title and system mails (1–40 characters).
# BRANDING_COLOR: primary colour #rrggbb. Details: docs/branding.md
#BRANDING_NAME=CoreMail
#BRANDING_COLOR=#006d77

# Internal services (auth, backup, security-filter, CalDAV, JMAP, ActiveSync,
# Autodiscover) listen on 127.0.0.1. Multi-host deployments (Kubernetes) set 0.0.0.0
# AND an INTERNAL_API_TOKEN (shared secret for /internal/* service routes).
#INTERNAL_BIND_HOST=127.0.0.1
#INTERNAL_API_TOKEN=

# Outbound smarthost (BCP → SMTP configuration): its TLS certificate is verified.
# Only for a smarthost with a self-signed certificate: true disables the check.
#SMARTHOST_TLS_INSECURE=false


# ── Tuning and escape hatches ─────────────────────────────────────────────────
# All optional: unset or empty = the default shown. The shipped Compose files pass
# the variables below through to the app container unless a comment says otherwise.

# Schema sync (docs/deployment-security.md)
# Pre-migration pg_dump before a destructive or unique-constraint schema change:
# required (default) | skip (you made your own backup, e.g. external PostgreSQL >= 17)
#COREMAIL_SCHEMA_BACKUP=required
# Directory of that dump (volume coremail-data)
#COREMAIL_SCHEMA_BACKUP_DIR=/data/backups

# Quotas, recoverable items, out of office (docs/mailbox-quotas-recovery.md)
# Days deleted items stay recoverable before they are purged (0 = never purge)
#DELETED_ITEM_RETENTION_DAYS=30
# Purged items: delete unreferenced raw/attachment objects (delete | dry-run | off)
#DELETED_ITEM_PURGE_OBJECTS=delete
# RCPT TO reply for a full mailbox: true = 552 5.2.2 (permanent), false = 452 4.2.2
# (sender retries), N >= 100 = 452 until usage reaches N % of the quota, then 552
#QUOTA_FULL_PERMANENT=true
# Seconds the mailbox usage is cached per process
#QUOTA_USAGE_CACHE_SEC=60
# Days a sender is remembered for an open-ended out-of-office (one reply per sender)
#OOF_REPLY_MEMORY_DAYS=366

# Global API rate limit of the api-gateway (docs/api-gateway-security.md). Normally set in
# BCP → Settings → Security; a variable set here overrides the BCP value.
# Passed through by docker-compose.yml only.
# Signed-in requests count per user, anonymous ones per client IP.
#API_RATE_LIMIT_ENABLED=true
#API_RATE_LIMIT_WINDOW_MIN=15
#API_RATE_LIMIT_PER_USER=3000
#API_RATE_LIMIT_PER_IP=500

# Inbound filtering (docs/mail-security.md)
# The three local-spoof settings are set in BCP → Protection → Spoofing;
# a variable set here overrides the BCP value.
# Unauthenticated mail claiming a local domain: policy (follow our DMARC record) | junk | reject
#LOCAL_SPOOF_ACTION=policy
# Trusted third-party senders that may use a local domain (IPs/CIDRs and domains, comma-separated)
#LOCAL_SPOOF_ALLOW=
# ARC sealers whose passing chain overrides the local-domain and DMARC checks (comma-separated)
#ARC_TRUSTED_SEALERS=
# Internal error in the content pipeline: false = defer with 451 (default), true = accept unscanned
#SECURITY_FILTER_FAIL_OPEN=false
# Regex matcher steps for all transport + inbox rule conditions of one message
#RULE_PATTERN_STEP_BUDGET=5000000
# Cap for all rules of one message together (default 4 x the per-rule budget)
#RULE_PATTERN_MESSAGE_STEP_BUDGET=20000000
# Webmail draft autosave writes per user and window
#DRAFT_WRITE_RATE_LIMIT=60
#DRAFT_WRITE_RATE_WINDOW_SEC=60

# SMTP (docs/smtp.md, docs/mail-security.md)
# true = allow delivery to MX hosts with private/loopback addresses (lab setups only)
#OUTBOUND_ALLOW_PRIVATE_MX=false
# Hours in the queue before the sender gets one delay notification (0 = off)
#OUTBOUND_DELAY_DSN_HOURS=4
# Max. tarpit delay per reply on port 25 after repeated errors (0 = off, cap 30000)
#SMTP_TARPIT_MAX_DELAY_MS=5000
# ESMTP extensions on all listeners: SMTPUTF8 (RFC 6531), DSN (RFC 3461),
# CHUNKING + BINARYMIME (RFC 3030). false switches one off.
#SMTP_EXT_SMTPUTF8=true
#SMTP_EXT_DSN=true
#SMTP_EXT_CHUNKING=true

# Brute-force exemptions and connection limits (docs/mail-protocol-limits.md)
# IPs/CIDRs exempt from the per-IP login lockout (loopback is always exempt)
#MAIL_AUTH_EXEMPT_CIDRS=
# IPs/CIDRs without the IMAP/POP3 per-IP connection cap (loopback is always exempt)
#MAIL_CONN_EXEMPT_CIDRS=
#IMAP_MAX_CONNS=2000            # concurrent IMAP connections per process
#IMAP_MAX_CONNS_PER_IP=50       # per client IP (offices behind one NAT address)
#IMAP_MAX_CONNS_PER_USER=20     # authenticated sessions per user
#IMAP_SORT_MAX_MESSAGES=100000  # larger mailboxes answer SORT/THREAD with NO [LIMIT]
#POP3_MAX_CONNS=1000            # concurrent POP3 connections per process
#POP3_MAX_CONNS_PER_IP=50       # per client IP
# JMAP uploads per account (docs/jmap.md): MB of live uploads (0 = off) and number of blobs
#JMAP_UPLOAD_QUOTA_MB=500
#JMAP_UPLOAD_MAX_BLOBS=10000
# Autoconfig / Apple profile requests per minute and client IP (docs/clients.md)
#AUTOCONFIG_RATE_LIMIT=60

# Web / REST API (docs/api-gateway-security.md)
# Extra origins or host names accepted for cookie-authenticated auth requests
# (comma-separated; for unusual reverse-proxy setups)
#COREMAIL_ALLOWED_ORIGINS=
# Dedicated key (>= 32 characters) for audit export signatures; empty = derived
# from JWT_SECRET + PEPPER. Rotating it invalidates earlier signatures.
#AUDIT_EXPORT_SIGNING_KEY=
# Redirect plain HTTP (port 80/3000) to HTTPS; false when TLS ends at your own proxy
#HTTP_REDIRECT_HTTPS=true
# Port in the redirect URL — the HTTPS port clients reach (e.g. 8443 for 8443:443)
#HTTPS_PUBLIC_PORT=443
# Webmail / REST sending: recipients per message, messages per user and window
#MAIL_SEND_MAX_RECIPIENTS=500
#MAIL_SEND_RATE_LIMIT=30
#MAIL_SEND_RATE_WINDOW_SEC=60
# Image proxy requests per user and window (0 = off)
#IMAGE_PROXY_RATE_LIMIT=120
#IMAGE_PROXY_RATE_WINDOW_SEC=60
# Max. size of an MBOX import / restore upload in bytes (default 500 MiB)
#BACKUP_IMPORT_MAX_BYTES=524288000
# Restore of stored archives: max. decrypted archive size (default 20 GiB, needs as much free
# space in the container's temp directory) and max. size of one message (default 150 MiB).
# Not passed through by the shipped Compose files: add them to the coremail environment.
#BACKUP_RESTORE_MAX_BYTES=21474836480
#BACKUP_RESTORE_MAX_MESSAGE_BYTES=157286400
# SSO: true = an admin's IdP MFA counts as CoreMail MFA when the provider has requireMfa off
#OIDC_TRUST_IDP_MFA_FOR_ADMINS=false

# Autodiscover / autoconfig / Apple profile host names (default: MAIL_HOSTNAME,
# used only until the setup wizard has created the server settings; after that
# BCP → Server settings applies). SMTP_HOSTNAME is also accepted as an
# Authentication-Results authserv-id of this server. Empty or unset = the default.
#SMTP_HOSTNAME=mail.example.com
#POP3_HOSTNAME=mail.example.com

# Background indexing of References headers of older messages for threading (on | off, default on)
#REFERENCES_BACKFILL=on
# Time budget (ms) of the lazy References indexing inside one IMAP THREAD=REFERENCES
# command (at most 200 messages; the rest is left to the background job; 0 = off)
#REFERENCES_LAZY_BUDGET_MS=1500
