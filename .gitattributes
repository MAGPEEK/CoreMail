# Files that are executed or parsed inside Linux containers must keep LF line
# endings even on Windows checkouts (core.autocrlf=true) — a CRLF shebang makes
# the app container fail with "exec /entrypoint.sh failed: No such file or directory".
*.sh                    text eol=lf
Dockerfile*             text eol=lf
infra/docker/**         text eol=lf
# The release asset (scripts/release-assets.sh): its sh -c blocks must not carry CR
deploy/**               text eol=lf
