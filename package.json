{
  "name": "coremail",
  "version": "10.6.1",
  "private": true,
  "packageManager": "pnpm@11.28.9",
  "description": "CoreMail — self-hosted open-source mail and groupware server",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "db:generate": "pnpm --filter @coremail/storage prisma generate",
    "db:migrate": "pnpm --filter @coremail/storage prisma migrate dev",
    "db:push": "pnpm --filter @coremail/storage prisma db push",
    "docker:build": "docker build -f infra/docker/Dockerfile.app -t coremail-app:local .",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:up:minimal": "docker compose -f infra/docker/docker-compose.minimal.yml up -d",
    "docker:up:full": "docker compose -f infra/docker/docker-compose.full.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down --remove-orphans",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "docker:ps": "docker compose -f infra/docker/docker-compose.yml ps",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
