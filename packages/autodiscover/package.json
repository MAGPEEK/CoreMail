{
  "name": "@coremail/autodiscover",
  "version": "9.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "node --import tsx --test src/v2.test.ts src/v1-auth.test.ts src/v1-response.test.ts src/autoconfig.test.ts src/settings.test.ts"
  },
  "dependencies": {
    "@coremail/auth-ldap": "workspace:*",
    "@coremail/core": "workspace:*",
    "@coremail/storage": "workspace:*",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
