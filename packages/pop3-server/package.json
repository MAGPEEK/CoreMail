{
  "name": "@coremail/pop3-server",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch & node --watch dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/stls.test.ts src/retr.test.ts"
  },
  "dependencies": {
    "@coremail/core": "workspace:*",
    "@coremail/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.11",
    "node-forge": "^1.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  }
}
