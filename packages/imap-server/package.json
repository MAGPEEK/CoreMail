{
  "name": "@coremail/imap-server",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/server/tokenizer.test.ts src/server/command-reader.test.ts src/commands/search-parser.test.ts src/server/starttls.test.ts src/fetch/fetch.test.ts"
  },
  "dependencies": {
    "@coremail/auth-ldap": "workspace:*",
    "@coremail/core": "workspace:*",
    "@coremail/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.16.0",
    "typescript": "^5.5.0",
    "node-forge": "^1.3.1",
    "@types/node-forge": "^1.3.11"
  }
}
