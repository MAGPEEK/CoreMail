generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
  // Explicitly OpenSSL 3 target only — omit "native" because auto-detection fails on Alpine
  binaryTargets   = ["linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  USER
  HELP_DESK
  RECIPIENT_MANAGEMENT
  COMPLIANCE_MANAGEMENT
  HYGIENE_MANAGEMENT
  SERVER_MANAGEMENT
  VIEW_ONLY_ORG
  ORGANIZATION_MANAGEMENT
}

enum SharedMailboxPermType {
  FULL_ACCESS
  SEND_AS
  SEND_ON_BEHALF
  READ_ONLY
}

enum LogLevel {
  ERROR
  WARN
  INFO
  DEBUG
}

enum JobStatus {
  PENDING
  PROCESSING
  // v3.18.26 — extended for backup job lifecycle (RTO/RPO tracking)
  SCHEDULED        // waiting for the next cron tick
  RUNNING          // currently processing (synonym for PROCESSING, clearer name)
  RETRYING         // retry in progress after a failure
  COMPLETED
  FAILED
  ABORTED          // manually aborted by the user
  EXPIRED          // snapshot was deleted by retention
}

enum AuthSource {
  LOCAL
  LDAP
  OIDC
}

// v5.6.1: enum GroupType removed (DistributionGroup feature deleted)

enum ResourceType {
  ROOM
  EQUIPMENT
}

// ─────────────────────────────────────────────
// Domains & Users
// ─────────────────────────────────────────────

model Domain {
  id                 String               @id @default(cuid())
  name               String               @unique
  dkimPrivateKey     String
  dkimSelector       String               @default("coremail")
  active             Boolean              @default(true)
  primary            Boolean              @default(false)
  users              User[]
  sharedMailboxes    SharedMailbox[]
  ldapConfig         LdapConfig?
  oidcProviders      OidcProvider[]
  // v5.6.1: distributionGroups relation removed
  resourceMailboxes  ResourceMailbox[]
  aliases            EmailAlias[]
  createdAt          DateTime             @default(now())

  @@map("domains")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  displayName     String
  passwordHash    String?
  authSource      AuthSource     @default(LOCAL)
  externalId      String?        // LDAP objectGUID or OIDC sub
  role            UserRole       @default(USER)
  quotaBytes      BigInt         @default(5368709120)
  usedBytes       BigInt         @default(0)
  active          Boolean        @default(true)
  domain          Domain         @relation(fields: [domainId], references: [id])
  domainId        String
  mailbox         Mailbox?
  calendars       Calendar[]
  contacts        Contact[]
  sessions        Session[]
  mfa             UserMfa?
  appPasswords    AppPassword[]
  sharedPerms     SharedMailboxPerm[]
  delegatedAccess MailboxDelegate[]    @relation("MailboxDelegateGrantee")
  calendarSharesGranted  CalendarShare[] @relation("CalendarShareOwner")
  calendarSharesReceived CalendarShare[] @relation("CalendarShareGrantee")
  activeSyncDevices ActiveSyncDevice[]
  certificates    UserCertificate[]
  smimeSettings   SmimeSettings?
  pushSubscriptions PushSubscription[]
  // v5.6.0: OAuth relations (oauthCodes/Tokens/Consents) removed
  categories          Category[]
  aliases             EmailAlias[]        @relation("UserAliases")
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([domainId])
  @@index([externalId])
  @@map("users")
}

// ─────────────────────────────────────────────
// Authentication
// ─────────────────────────────────────────────

// Password reset token (self-service)
// - Token is stored as a SHA-256 hash (never in plaintext)
// - Expires after 15 minutes (configurable via ServerSettings)
// - Single use (usedAt is set on redemption)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique  // SHA-256(token) — plaintext token only sent by e-mail
  expiresAt DateTime
  usedAt    DateTime?           // null = not redeemed yet
  ipAddress String    @default("")
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Session {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  tokenHash   String   @unique
  ipAddress   String
  userAgent   String   @default("")
  mfaVerified Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserMfa {
  id                  String  @id @default(cuid())
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String  @unique
  totpSecret          String?
  totpEnabled         Boolean @default(false)
  webAuthnCredentials Json    @default("[]")
  backupCodes         String[]
  backupCodesUsed     Int     @default(0)
  emailOtpEnabled     Boolean @default(false)

  @@map("user_mfa")
}

model AppPassword {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  hash        String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("app_passwords")
}

model LdapConfig {
  id           String   @id @default(cuid())
  domain       Domain   @relation(fields: [domainId], references: [id])
  domainId     String   @unique
  host         String
  port         Int      @default(636)
  ssl          Boolean  @default(true)
  baseDN       String
  bindDN       String
  bindPassword String
  userFilter   String   @default("(sAMAccountName={{username}})")
  userDN       String
  groupFilter  String?
  attributeMap Json     @default("{}")
  syncEnabled  Boolean  @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())

  @@map("ldap_configs")
}

model OidcProvider {
  id             String   @id @default(cuid())
  domain         Domain   @relation(fields: [domainId], references: [id])
  domainId       String
  name           String
  discoveryUrl   String
  clientId       String
  clientSecret   String
  claimMap       Json     @default("{}")
  autoProvision  Boolean  @default(true)
  forcedDomains  String[]
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("oidc_providers")
}

// ─────────────────────────────────────────────
// Mail Storage
// ─────────────────────────────────────────────

model Mailbox {
  id              String           @id @default(cuid())
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String?          @unique
  sharedBox       SharedMailbox?   @relation(fields: [sharedBoxId], references: [id])
  sharedBoxId     String?          @unique
  resourceMailbox ResourceMailbox?
  uidValidity     Int              @default(1)
  uidNext         Int              @default(1)
  highestModSeq   BigInt           @default(0)
  folders         Folder[]
  delegates       MailboxDelegate[]
  createdAt       DateTime         @default(now())

  @@map("mailboxes")
}

model Folder {
  id          String    @id @default(cuid())
  mailbox     Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  mailboxId   String
  name        String
  displayName String
  parent      Folder?   @relation("FolderTree", fields: [parentId], references: [id])
  parentId    String?
  children    Folder[]  @relation("FolderTree")
  messages    Message[]
  totalCount  Int       @default(0)
  unreadCount Int       @default(0)
  changeKey   String    @default("")
  subscribed  Boolean   @default(true)
  isFavorite  Boolean   @default(false)
  sortOrder   Int       @default(0)
  color       String?
  createdAt   DateTime  @default(now())
  // Personal tag on folder (user assignment)
  retentionTag   RetentionTag? @relation("FolderRetentionTag", fields: [retentionTagId], references: [id])
  retentionTagId String?

  @@unique([mailboxId, name])
  @@index([mailboxId])
  @@map("folders")
}

model Message {
  id           String      @id @default(cuid())
  folder       Folder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId     String
  uid          Int
  modSeq       BigInt
  flags        String[]
  subject      String      @default("")
  fromAddr     String      @default("")
  fromName     String      @default("")
  toAddrs      String[]
  ccAddrs      String[]
  bccAddrs     String[]
  replyTo      String?
  messageId    String?     // RFC 2822 Message-ID header
  inReplyTo    String?
  date         DateTime
  bodyText     String      @default("")
  bodyHtml     String      @default("")
  rawSize      Int         @default(0)
  storagePath  String?     // MinIO object key for large messages
  changeKey    String      @default("")
  deletedAt    DateTime?   // soft-delete (30 day recovery window)
  // Phase 9: S/MIME metadata JSON — { signed, valid, signerEmail, decrypted, ... }
  smimeMeta    String?
  pinnedAt     DateTime?   // user pinned this message (top of list)
  snoozeUntil  DateTime?   // hide until this time, then reappear in inbox
  // Phase 10: spam persistence (rspamd score at delivery time)
  spamScore    Float?      // null = not scanned, 0..15 = rspamd score
  // Phase 10: scheduled send — the mail is created in "Sent Items" immediately,
  // but only sent at the scheduled time via BullMQ delay.
  scheduledAt     DateTime?   // time of the scheduled send
  scheduledStatus String?     // 'PENDING' | 'SENT' | 'CANCELLED' | null
  scheduledJobId  String?     // BullMQ job ID for cancellation (delay job in smtp-outbound)
  // ── Retention (Phase 9 / Exchange 2019 compliant) ────────────────────────────
  // Effective tag computed by the MFA or set by the user
  retentionTag     RetentionTag? @relation("MessageRetentionTag", fields: [retentionTagId], references: [id])
  retentionTagId   String?
  // Computed time from which the tag action is executed (date + retentionDays)
  retentionExpiresAt DateTime?
  // When the item was moved to "Recoverable Items\Deletions" by the MFA (soft delete)
  softDeletedAt    DateTime?
  // v5.7.1: JMAP thread assignment (RFC 8621 §3). Set lazily by the jmap-server:
  // reply (inReplyTo) to a known message → its threadId, otherwise own id.
  threadId         String?
  attachments  Attachment[]
  categories   MessageCategory[]
  createdAt    DateTime    @default(now())

  @@unique([folderId, uid])
  @@index([folderId, date])
  @@index([folderId, modSeq])
  @@index([messageId])
  @@index([deletedAt])
  @@index([snoozeUntil])
  @@index([retentionTagId])
  @@index([retentionExpiresAt])
  @@index([softDeletedAt])
  @@index([threadId])
  @@map("messages")
}

model Attachment {
  id          String   @id @default(cuid())
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId   String
  contentId   String?
  filename    String
  mimeType    String
  size        Int
  sha256      String
  storagePath String
  inline      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([messageId])
  @@index([sha256])
  @@map("attachments")
}

// ─────────────────────────────────────────────
// Mail categories (Outlook-style tags)
// ─────────────────────────────────────────────
model Category {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  color      String   @default("#3B82F6")
  isFavorite Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  messages   MessageCategory[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model MessageCategory {
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId  String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  assignedAt DateTime @default(now())

  @@id([messageId, categoryId])
  @@index([categoryId])
  @@map("message_categories")
}

// ─────────────────────────────────────────────
// Shared Mailboxes
// ─────────────────────────────────────────────

model SharedMailbox {
  id          String              @id @default(cuid())
  email       String              @unique
  displayName String
  domain      Domain              @relation(fields: [domainId], references: [id])
  domainId    String
  quotaBytes  BigInt              @default(10737418240)
  usedBytes   BigInt              @default(0)
  active      Boolean             @default(true)
  permissions SharedMailboxPerm[]
  mailbox     Mailbox?
  aliases     EmailAlias[]        @relation("SharedMailboxAliases")
  createdAt   DateTime            @default(now())

  @@index([domainId])
  @@map("shared_mailboxes")
}

// ── E-mail aliases ────────────────────────────────────────────────────────────
// An alias is an additional receiving address whose mail is delivered to an existing
// mailbox (user or shared mailbox). Exactly ONE target must be
// set (targetUserId XOR targetSharedId) — validated in application code,
// Prisma cannot express this directly.
model EmailAlias {
  id              String         @id @default(cuid())
  // Full e-mail address, e.g. "info@firma.com" — case-insensitive unique
  address         String         @unique
  // Local part before the @ (for UI display, sorting)
  localPart       String
  // The domain the alias address belongs to (FK)
  domain          Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId        String
  // Target: user mailbox
  targetUser      User?          @relation("UserAliases", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUserId    String?
  // Target: Shared Mailbox
  targetShared    SharedMailbox? @relation("SharedMailboxAliases", fields: [targetSharedId], references: [id], onDelete: Cascade)
  targetSharedId  String?
  description     String         @default("")
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([targetUserId])
  @@index([targetSharedId])
  @@index([domainId])
  @@map("email_aliases")
}

model SharedMailboxPerm {
  id              String               @id @default(cuid())
  sharedMailbox   SharedMailbox        @relation(fields: [sharedMailboxId], references: [id], onDelete: Cascade)
  sharedMailboxId String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  permission      SharedMailboxPermType
  grantedAt       DateTime             @default(now())
  grantedBy       String

  // Multiple permissions per user possible (Exchange-style: Full Access + Send As + …)
  @@unique([sharedMailboxId, userId, permission])
  @@index([sharedMailboxId, userId])
  @@map("shared_mailbox_perms")
}

// ─────────────────────────────────────────────
// Mailbox delegation (user mailbox access rights)
// ─────────────────────────────────────────────
// Gives user B access to the mailbox of user A (Exchange Delegate Access)
// Permissions analogous to SharedMailboxPerm: FULL_ACCESS / SEND_AS / SEND_ON_BEHALF / READ_ONLY
model MailboxDelegate {
  id          String               @id @default(cuid())
  mailbox     Mailbox              @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  mailboxId   String
  grantee     User                 @relation("MailboxDelegateGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  granteeId   String
  permission  SharedMailboxPermType
  grantedAt   DateTime             @default(now())
  grantedBy   String

  @@unique([mailboxId, granteeId])
  @@index([granteeId])
  @@map("mailbox_delegates")
}

// ─────────────────────────────────────────────
// Calendaring
// ─────────────────────────────────────────────

model Calendar {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  color       String          @default("#0078D4")
  icon        String?         // lucide icon name (e.g. "Home", "Plane")
  sortOrder   Int             @default(0)
  isDefault   Boolean         @default(false)
  syncToken   String          @default("")
  events      CalendarEvent[]
  shares      CalendarShare[]
  createdAt   DateTime        @default(now())

  @@index([userId])
  @@map("calendars")
}

enum CalendarPermType {
  READ
  WRITE
}

model CalendarShare {
  id         String           @id @default(cuid())
  calendar   Calendar         @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId String
  owner      User             @relation("CalendarShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  grantee    User             @relation("CalendarShareGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  granteeId  String
  permission CalendarPermType
  comment    String?
  // v3.18.16 A3: grantee-local color (overrides the owner color only for this user)
  localColor String?
  // v3.18.16 A8: grantee-local sort order in the "Shared with me" section
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())

  @@unique([calendarId, granteeId])
  @@index([granteeId])
  @@index([calendarId])
  @@map("calendar_shares")
}

model CalendarEvent {
  id          String   @id @default(cuid())
  calendar    Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId  String
  uid         String   @unique // iCal UID
  icalData    String
  summary     String
  description String   @default("")
  location    String   @default("")
  dtStart     DateTime
  dtEnd       DateTime
  allDay      Boolean  @default(false)
  recurring   Boolean  @default(false)
  rrule       String?
  organizer   String?
  attendees   Json     @default("[]")
  status      String   @default("CONFIRMED")
  // v3.18.15: privacy level for shared calendars. Values: PUBLIC | PRIVATE | CONFIDENTIAL
  //  PUBLIC       → details visible to owner and all grantees (default)
  //  PRIVATE      → grantees only see "Busy", no details (subject/location/notes masked)
  //  CONFIDENTIAL → grantees do not see the event at all (completely hidden)
  // The owner sees ALL events unchanged. Maps to iCal `CLASS:` (RFC 5545 §3.8.1.3).
  classification String @default("PUBLIC")
  // v3.18.25 A5: iMIP/iTIP — sequence counter is incremented on every UPDATE (subject,
  // date, attendee change). Mail clients (Outlook, Gmail) only show
  // the HIGHEST sequence — old REPLY mails with a lower sequence are
  // ignored.
  sequence    Int      @default(0)
  changeKey   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([calendarId, dtStart])
  @@map("calendar_events")
}

// ─────────────────────────────────────────────
// Contacts
// ─────────────────────────────────────────────

model Contact {
  id          String  @id @default(cuid())
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  vcardData   String
  displayName String
  email       String  @default("")
  email2      String  @default("")
  phone       String  @default("")
  mobile      String  @default("")
  company     String  @default("")
  department  String  @default("")
  jobTitle    String  @default("")
  notes       String  @default("")
  photoUrl    String?
  changeKey   String  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([email])
  @@map("contacts")
}

// ─────────────────────────────────────────────
// Tasks & Notes
// ─────────────────────────────────────────────

model Task {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  body        String   @default("")
  status      String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED | DEFERRED
  priority    String   @default("NORMAL")       // LOW | NORMAL | HIGH
  dueDate     DateTime?
  completedAt DateTime?
  reminder       DateTime?
  reminderByMail Boolean   @default(false)
  changeKey      String    @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("tasks")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  subject   String   @default("Notiz")
  body      String   @default("")
  color     String   @default("YELLOW")
  changeKey String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notes")
}

// ─────────────────────────────────────────────
// User Settings & Mail Rules
// ─────────────────────────────────────────────

model UserSettings {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  signature               String    @default("")
  signatureAutoNew        Boolean   @default(true)
  signatureAutoReply      Boolean   @default(false)
  oofEnabled              Boolean   @default(false)
  oofInternal             String    @default("")
  oofExternal             String    @default("")
  oofExternalEnabled      Boolean   @default(true)
  oofExternalOnlyContacts Boolean   @default(false)
  oofUseTimeRange         Boolean   @default(false)
  oofStart                DateTime?
  oofEnd                  DateTime?
  // Personal inactivity timeout (null = use global setting)
  inactivityTimeoutMinutes Int?
  updatedAt               DateTime  @updatedAt

  @@map("user_settings")
}

model MailRule {
  id             String   @id @default(cuid())
  userId         String
  name           String
  enabled        Boolean  @default(true)
  priority       Int      @default(0)
  conditions     Json     @default("[]")
  exceptions     Json     @default("[]")
  actions        Json     @default("[]")
  stopProcessing Boolean  @default(false)
  matchAll       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, priority])
  @@map("mail_rules")
}

// ─────────────────────────────────────────────
// Backup Jobs
// ─────────────────────────────────────────────

model BackupJob {
  id          String    @id @default(cuid())
  userId      String?
  scope       String    // "user" | "domain" | "full"
  format      String    // "mbox" | "eml" | "full" | "zip"
  status      JobStatus @default(PENDING)
  progress    Int       @default(0)
  downloadUrl String?
  expiresAt   DateTime?
  errorMsg    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  // v3.18.26 — extended status logging fields (see v3.18.26 research)
  startedAt   DateTime?
  durationMs  Int?              // (finishedAt - startedAt) — for RTO measurement
  sizeBytes   BigInt?           // backup size in the S3 bucket
  messageCount Int?             // how many messages the backup contained
  errorClass  String?           // NETWORK | STORAGE | PERMISSION | CORRUPT | UNKNOWN
  retryCount  Int       @default(0)
  triggeredBy String    @default("MANUAL")  // CRON | MANUAL | EVENT | RESTORE | API
  progressMeta Json?    @default("{}")      // { phase, current, total, currentFolder }
  scheduleId  String?              // reference to BackupSchedule when triggered by a schedule

  @@index([userId])
  @@index([status])
  @@index([scheduleId])
  @@map("backup_jobs")
}

/// v3.18.26 — backup scheduling in the DB instead of an env variable.
/// Admins can define cron expressions, choose a format, filter target users.
model BackupSchedule {
  id           String    @id @default(cuid())
  name         String                              // descriptive name, e.g. "Daily Full Backup"
  cron         String                              // cron expression, e.g. "0 2 * * *"
  enabled      Boolean   @default(true)
  scope        String    @default("full")          // user | full | domain
  format       String    @default("zip")           // mbox | zip | eml
  targetUserId String?                              // null = all users
  retentionDays Int      @default(30)              // snapshot is deleted after this many days
  lastRunAt    DateTime?
  lastStatus   String?                              // last JobStatus
  lastJobId    String?                              // reference to the last BackupJob
  nextRunAt    DateTime?                            // computed by the scheduler
  createdBy    String?                              // userId of the admin who created the schedule
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([enabled])
  @@map("backup_schedules")
}

// ─────────────────────────────────────────────
// System Logs
// ─────────────────────────────────────────────

model SystemLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     LogLevel
  service   String
  category  String   @default("SYSTEM")
  message   String
  metadata  Json?
  userId    String?
  messageId String?

  @@index([timestamp])
  @@index([service, timestamp])
  @@index([level, timestamp])
  @@index([category, timestamp])
  @@map("system_logs")
}

// ─────────────────────────────────────────────
// Security Filter
// ─────────────────────────────────────────────

model Blacklist {
  id         String   @id @default(cuid())
  pattern    String
  patternType String  @default("EXACT") // EXACT | WILDCARD | REGEX
  scope      String   @default("GLOBAL") // GLOBAL | DOMAIN | USER
  scopeId    String?  // domainId or userId for non-global
  comment    String   @default("")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([scope, scopeId])
  @@map("blacklist")
}

model Quarantine {
  id          String   @id @default(cuid())
  messageId   String?
  fromAddr    String
  toAddr      String
  subject     String   @default("")
  reason      String   // VIRUS | SPAM | POLICY
  details     Json     @default("{}")
  rawPath     String   // MinIO path to raw message
  released    Boolean  @default(false)
  releasedAt  DateTime?
  releasedBy  String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([reason])
  @@map("quarantine")
}

// ─────────────────────────────────────────────
// Phase 6 — ActiveSync (EAS)
// ─────────────────────────────────────────────

model ActiveSyncDevice {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId        String   // EAS DeviceId header
  deviceType      String   @default("")  // EAS DeviceType (iPhone, Android, etc.)
  deviceFriendlyName String @default("")
  policyKey       String   @default("0")
  status          String   @default("OK") // OK | PENDING | BLOCKED | WIPED
  lastSyncAt      DateTime?
  remoteWipeAt    DateTime?
  createdAt       DateTime @default(now())
  folderSyncKey   String   @default("0")
  syncKeys        Json     @default("{}") // folderId → syncKey map

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("active_sync_devices")
}

// ─────────────────────────────────────────────
// Phase 6 — S/MIME Certificates
// ─────────────────────────────────────────────

model UserCertificate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("My Certificate")
  fingerprint   String   @unique  // SHA-256 hex
  subject       String   // X.509 Subject DN
  issuer        String   // X.509 Issuer DN
  notBefore     DateTime
  notAfter      DateTime
  storagePath   String   // MinIO path to encrypted PKCS#12
  signingDefault Boolean @default(false)
  encryptDefault Boolean @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("user_certificates")
}

// v5.6.1: DistributionGroup + DistributionGroupMember models deleted.
// Tables are dropped via `prisma db push --accept-data-loss` on container
// start. Recommendation for distribution-list mail: external tools such as
// Sympa, GNU mailman, or simple e-mail aliases in the mail client.

// ─────────────────────────────────────────────
// Phase 7 — Resource Mailboxes (Rooms & Equipment)
// ─────────────────────────────────────────────

model ResourceMailbox {
  id                  String           @id @default(cuid())
  email               String           @unique
  displayName         String
  resourceType        ResourceType     @default(ROOM)
  domain              Domain           @relation(fields: [domainId], references: [id])
  domainId            String
  capacity            Int?
  location            String           @default("")
  phone               String           @default("")
  autoAccept          Boolean          @default(true)
  autoDeclineConflict Boolean          @default(true)
  allowRecurring      Boolean          @default(true)
  maxDurationMinutes  Int?
  bookingWindowDays   Int              @default(180)
  requireApproval     Boolean          @default(false)
  delegateIds         String[]
  active              Boolean          @default(true)
  mailboxId           String?          @unique
  mailbox             Mailbox?         @relation(fields: [mailboxId], references: [id])
  calendar            ResourceCalendar?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([domainId])
  @@map("resource_mailboxes")
}

model ResourceCalendar {
  id         String           @id @default(cuid())
  resource   ResourceMailbox  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId String           @unique
  bookings   ResourceBooking[]
  createdAt  DateTime         @default(now())

  @@map("resource_calendars")
}

model ResourceBooking {
  id         String           @id @default(cuid())
  calendar   ResourceCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId String
  uid        String           @unique // iCal UID
  summary    String
  organizer  String
  attendees  Json             @default("[]")
  dtStart    DateTime
  dtEnd      DateTime
  status     String           @default("ACCEPTED") // ACCEPTED | DECLINED | TENTATIVE | PENDING
  icalData   String
  createdAt  DateTime         @default(now())

  @@index([calendarId, dtStart])
  @@index([dtStart, dtEnd])
  @@map("resource_bookings")
}

// (Phase 7 Public Folders — completely removed in v3.18.31)
// (Phase 8 eDiscovery & Legal Hold — completely removed in v3.18.5)

// ─────────────────────────────────────────────
// Phase 8 — Transport Rules
// ─────────────────────────────────────────────

model TransportRule {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  // conditions: [{field: "from"|"to"|"subject"|"body"|"hasAttachment", op: "contains"|"equals"|"regex", value}]
  conditions  Json     @default("[]")
  // actions: [{type: "addHeader"|"removeHeader"|"redirect"|"reject"|"addRecipient"|"setSubjectPrefix", value}]
  actions     Json     @default("[]")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, priority])
  @@map("transport_rules")
}

// ─────────────────────────────────────────────
// Phase 9 — S/MIME Inline Settings
// ─────────────────────────────────────────────

model SmimeSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Automatically sign all outgoing messages
  autoSign       Boolean  @default(false)
  // Automatically encrypt outgoing messages when recipient cert is available
  autoEncrypt    Boolean  @default(false)
  // Verify incoming S/MIME signatures and show result in UI
  verifyIncoming Boolean  @default(true)
  // Attempt to decrypt incoming encrypted messages automatically
  decryptIncoming Boolean @default(true)
  updatedAt      DateTime @updatedAt

  @@map("smime_settings")
}

// (Phase 9 Journaling — completely removed in v3.13.6)

// ─────────────────────────────────────────────
// Phase 9 — Retention Policies
// ─────────────────────────────────────────────

enum RetentionAction {
  ARCHIVE        // Move to Archive folder
  DELETE         // Permanently delete
  MOVE_TO_FOLDER // Move to a specified folder
}

enum RetentionScope {
  ALL_ITEMS      // Apply to all mail items
  INBOX          // Only Inbox
  SENT_ITEMS     // Only Sent Items
  DELETED_ITEMS  // Only Deleted Items / Trash
  JUNK           // Only Junk/Spam folder
}

model RetentionPolicy {
  id          String               @id @default(cuid())
  name        String
  description String               @default("")
  enabled     Boolean              @default(true)
  // ── Legacy fields (pre-tags) — new policies keep defaults here and use `tags` exclusively ──
  retentionDays Int                 @default(0)
  action      RetentionAction       @default(ARCHIVE)
  targetFolder String?
  scope       RetentionScope        @default(ALL_ITEMS)
  // ── New (Exchange 2019 compliant tag model) ──
  policyTags  RetentionPolicyTag[]
  assignments RetentionPolicyAssignment[]
  createdBy   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("retention_policies")
}

// ── Retention Tag — analogous to Exchange 2019: DPT / RPT / Personal ─────────────
enum RetentionTagType {
  DPT       // Default Policy Tag — applies to all items when nothing more specific matches
  RPT       // Retention Policy Tag — binds to a default folder
  PERSONAL  // Personal Tag — applied manually by the user to items/folders
}

// Which default folder an RPT binds to
enum RetentionFolderTarget {
  INBOX
  SENT_ITEMS
  DELETED_ITEMS
  JUNK_EMAIL
  DRAFTS
  OUTBOX
  RECOVERABLE_ITEMS
  ARCHIVE
  ALL_OTHER  // for DPT binding "all other folders"
}

// The three Exchange 2019 actions
enum RetentionTagAction {
  MOVE_TO_ARCHIVE             // → Archive folder
  DELETE_AND_ALLOW_RECOVERY   // → Recoverable Items\Deletions (soft delete, 14 days)
  PERMANENTLY_DELETE          // → Recoverable Items\Purges (hard delete if no hold)
  MARK_AS_PAST_RETENTION_LIMIT // marking only, no move (for reporting)
}

model RetentionTag {
  id              String                @id @default(cuid())
  name            String                @unique
  description     String                @default("")
  type            RetentionTagType
  action          RetentionTagAction    @default(DELETE_AND_ALLOW_RECOVERY)
  retentionDays   Int                   // days until the action is triggered
  // RPT only: which default folder it is bound to
  folderTarget    RetentionFolderTarget?
  enabled         Boolean               @default(true)
  isSystem        Boolean               @default(false) // built-in (e.g. "Default 2-Year Delete"), not deletable
  policyTags      RetentionPolicyTag[]
  messages        Message[]             @relation("MessageRetentionTag")
  folders         Folder[]              @relation("FolderRetentionTag")
  createdBy       String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([type])
  @@map("retention_tags")
}

// ── M:N — tags in policies ────────────────────────────────────────────────────
model RetentionPolicyTag {
  policy    RetentionPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyId  String
  tag       RetentionTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String
  createdAt DateTime        @default(now())

  @@id([policyId, tagId])
  @@map("retention_policy_tags")
}

// ── Managed Folder Assistant — run history ───────────────────────────────────
model ManagedFolderRun {
  id                 String   @id @default(cuid())
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  // Hard limit per run (work-cycle cap); 0 = unlimited
  workCycleSeconds   Int      @default(0)
  mailboxesScanned   Int      @default(0)
  itemsScanned       Int      @default(0)
  itemsArchived      Int      @default(0)
  itemsSoftDeleted   Int      @default(0)  // → Deletions
  itemsHardDeleted   Int      @default(0)  // → Purges / deleted
  itemsSkippedHold   Int      @default(0)
  throttled          Boolean  @default(false)
  errorMessage       String?

  @@index([startedAt])
  @@map("managed_folder_runs")
}

enum RetentionAssignmentTarget {
  USER           // Assigned to a specific user mailbox
  DOMAIN         // Assigned to all users of a domain
  GLOBAL         // Applies to all mailboxes in the org
}

model RetentionPolicyAssignment {
  id         String                   @id @default(cuid())
  policy     RetentionPolicy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyId   String
  target     RetentionAssignmentTarget @default(GLOBAL)
  // userId or domainId, empty string for GLOBAL
  targetId   String                   @default("")
  createdAt  DateTime                 @default(now())

  @@unique([policyId, target, targetId])
  @@index([policyId])
  @@map("retention_policy_assignments")
}

// ─────────────────────────────────────────────
// Phase 10 — Audit Log
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  // Actor — null means system action
  actorId    String?
  actorEmail String?
  // Action string: "mailbox.create", "user.delete", "auth.login", "rule.update", etc.
  action     String
  // Target resource
  targetType String?  // "user" | "domain" | "mailbox" | "rule" | "session" | ...
  targetId   String?
  targetName String?
  // Request context
  ipAddress  String?
  userAgent  String?
  // Optional before/after diff (JSON)
  changes    Json?
  // Outcome
  success    Boolean  @default(true)
  errorMsg   String?

  @@index([timestamp])
  @@index([actorId, timestamp])
  @@index([action, timestamp])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Security Attack Events (MITRE ATT&CK Logging)
// ─────────────────────────────────────────────

// Attack event log — persists security incidents for the admin dashboard
// + historical analysis. Populated by the SMTP IP limiter, security filter, etc.
model AttackEvent {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  // Attack type: AUTH_BRUTE_FORCE | IP_RATE_LIMIT | DNSBL_HIT | VIRUS | SPAM | DMARC_FAIL | RELAY_ATTEMPT
  type      String
  // Source IP of the attacker
  ip        String
  // Optional target user / e-mail address
  target    String?
  // Additional details (JSON: count, zone, score, etc.)
  detail    Json?
  // Service that detected the attack
  service   String   @default("smtp")

  @@index([timestamp])
  @@index([ip, timestamp])
  @@index([type, timestamp])
  @@map("attack_events")
}

// ─────────────────────────────────────────────
// Phase 10 — VAPID Push Subscriptions
// ─────────────────────────────────────────────

// v5.7.1: JMAP PushSubscription (RFC 8620 §7.2) — separate from the
// MWA VAPID table because JMAP needs deviceClientId/verificationCode/expires/types.
// Not bound to an account, belongs to the authenticated user.
model JmapPushSubscription {
  id               String    @id @default(cuid())
  userId           String
  deviceClientId   String
  url              String
  keysP256dh       String?
  keysAuth         String?
  verificationCode String?
  verified         Boolean   @default(false)
  expires          DateTime?
  types            String[]  // empty = all types
  createdAt        DateTime  @default(now())

  @@unique([userId, deviceClientId])
  @@index([userId])
  @@map("jmap_push_subscriptions")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Web Push endpoint URL (browser-specific)
  endpoint  String   @unique
  // ECDH keys for payload encryption
  p256dhKey String
  authKey   String
  userAgent String?
  // Topics the client is subscribed to
  topics    String[] // e.g. ["mail.new", "calendar.reminder"]
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// v5.6.0: OAuth2 / Modern Auth completely removed.
// Models OAuthClient, OAuthConsent, OAuthAuthorizationCode, OAuthToken
// were deleted in v5.6.0. Tables are dropped via `prisma db push
// --accept-data-loss` on container start.
//
// MFA bypass for mail clients: app passwords (AppPassword model)
// — works with IMAP, SMTP, POP3, EWS.

// ── SMTP server settings (singleton) ────────────────────────────────────
model SmtpSettings {
  id                   String   @id @default("singleton")

  // ESMTP extensions (disabled = not advertised)
  extStarttls          Boolean  @default(true)
  extAuthPlain         Boolean  @default(true)
  extAuthLogin         Boolean  @default(true)
  extAuthCramMd5       Boolean  @default(false)
  extPipelining        Boolean  @default(true)
  extSize              Boolean  @default(true)
  ext8bitmime          Boolean  @default(true)
  extEnhancedStatus    Boolean  @default(true)
  extSmtputf8          Boolean  @default(false)
  extDsn               Boolean  @default(true)
  extChunking          Boolean  @default(false)

  // Local delivery
  localDeliveryEnabled Boolean  @default(true)

  // SMTP banner
  bannerOverride       Boolean  @default(false)
  bannerText           String   @default("")

  // Relaying
  relayingEnabled      Boolean  @default(false)
  relayDomains         Json     @default("[]")
  relayRequireAuth     Boolean  @default(true)
  relayTrustedIps      Json     @default("[]")

  // Greylisting (SMTP level)
  greylistingEnabled   Boolean  @default(true)
  greylistWaitSec      Int      @default(300)
  greylistTtlHours     Int      @default(4)
  greylistWhitelist    Json     @default("[]")

  // Connection settings
  maxConnections       Int      @default(100)
  maxConnectionsPerIp  Int      @default(10)
  maxMessageSizeMb     Int      @default(25)
  maxRecipients        Int      @default(100)
  connectionTimeoutSec Int      @default(300)
  greetingDelaySec     Int      @default(0)
  maxAuthFailures      Int      @default(5)

  // Outbound delivery
  // outboundMode: "mx" = direct MX delivery (default) | "smarthost" = relay via a fixed host
  outboundMode         String   @default("mx")
  smarthostHost        String   @default("")
  smarthostPort        Int      @default(587)
  smarthostTls         Boolean  @default(true)   // STARTTLS (opportunistic)
  smarthostImplicitTls Boolean  @default(false)  // Implicit TLS (port 465 style)
  smarthostUsername    String   @default("")
  smarthostPassword    String   @default("")     // plaintext — stored locally in the DB only

  // Spam/virus filter before outbound delivery (rspamd + ClamAV)
  outboundFilterEnabled Boolean @default(true)

  updatedAt            DateTime @updatedAt

  @@map("smtp_settings")
}

// ── Security settings (singleton) ─────────────────────────────────────
model SecuritySettings {
  id                    String   @id @default("singleton")
  // Greylisting
  greylistEnabled       Boolean  @default(true)
  greylistWaitSec       Int      @default(300)
  greylistTtlHours      Int      @default(4)
  // DNSBL
  dnsblEnabled          Boolean  @default(true)
  dnsblZones            Json     @default("[\"zen.spamhaus.org\",\"bl.spamcop.net\"]")
  // GeoIP country filter
  geoipMode             String   @default("DISABLED")
  geoipCountries        Json     @default("[]")
  // Attachment filter
  attachmentEnabled     Boolean  @default(true)
  attachmentMaxSizeMb   Int      @default(50)
  attachmentBlockedExt  Json     @default("[\"exe\",\"vbs\",\"js\",\"bat\",\"cmd\",\"scr\",\"pif\",\"msi\",\"hta\",\"com\"]")
  // Rspamd — basic settings
  rspamdEnabled              Boolean  @default(true)
  rspamdGreylistScore        Float    @default(4.0)
  rspamdSpamScore            Float    @default(6.0)
  rspamdRejectScore          Float    @default(15.0)
  // Rspamd — Autolearn
  rspamdAutolearn            Boolean  @default(true)
  rspamdAutolearnSpam        Float    @default(12.0)
  rspamdAutolearnHam         Float    @default(-0.5)
  // Rspamd — e-mail headers
  rspamdAddSpamHeader        Boolean  @default(true)
  rspamdExtendedHeaders      Boolean  @default(true)
  rspamdRewriteSubject       Boolean  @default(false)
  rspamdSubjectTag           String   @default("[SPAM]")
  // Rspamd — modules
  rspamdPhishingEnabled      Boolean  @default(true)
  rspamdFuzzyEnabled         Boolean  @default(true)
  rspamdUrlEnabled           Boolean  @default(true)
  rspamdMxCheckEnabled       Boolean  @default(true)
  // ClamAV — basic settings
  clamavEnabled              Boolean  @default(true)
  clamavAction               String   @default("quarantine")  // quarantine | reject | pass
  clamavBlockOnFailure       Boolean  @default(false)
  // ClamAV — scan options
  clamavScanArchives         Boolean  @default(true)
  clamavScanHtml             Boolean  @default(true)
  clamavBlockEncryptedArch   Boolean  @default(false)
  clamavMaxFileSizeMb        Int      @default(25)
  clamavMaxScanSizeMb        Int      @default(100)
  updatedAt                  DateTime @updatedAt

  @@map("security_settings")
}

// ── Queue settings (singleton) ──────────────────────────────────────────
model QueueSettings {
  id                      String   @id @default("singleton")
  // Retry behavior
  maxRetryAttempts        Int      @default(10)
  retryBackoffDelaySec    Int      @default(60)
  // Retention periods
  deadLetterRetentionDays Int      @default(7)
  outboundRetentionHours  Int      @default(48)
  completedRetentionHours Int      @default(24)
  // Automatic cleanup
  autoFlushDead           Boolean  @default(false)
  // Notifications
  notifyOnDeadLetter      Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  @@map("queue_settings")
}

// ─────────────────────────────────────────────
// DNSBL — configurable per zone (instead of a string array)
// ─────────────────────────────────────────────

enum DnsblAction {
  REJECT       // reject directly (550)
  TAG          // let the mail through but mark as spam / increase score
  SCORE_ONLY   // rspamd score only, no action of its own
}

// DNS hostname (e.g. zen.spamhaus.org) as unique; further fields per zone
model DnsblZone {
  id           String      @id @default(cuid())
  host         String      @unique
  name         String
  description  String?
  enabled      Boolean     @default(true)
  action       DnsblAction @default(REJECT)
  // Score weight (0–100) for rspamd integration
  weight       Int         @default(5)
  // true = DNSWL (whitelist); a hit skips further filters
  isWhitelist  Boolean     @default(false)
  sortOrder    Int         @default(0)
  // Built-in preset (not deletable, can only be disabled)
  isBuiltin    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  hits         DnsblHit[]

  @@index([enabled])
  @@map("dnsbl_zones")
}

model DnsblHit {
  id        String    @id @default(cuid())
  zone      DnsblZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  zoneId    String
  ip        String
  hitAt     DateTime  @default(now())
  // Response code of the DNSBL server (e.g. 127.0.0.2)
  response  String?

  @@index([zoneId, hitAt])
  @@index([ip])
  @@index([hitAt])
  @@map("dnsbl_hits")
}

// ── Server settings (singleton) ─────────────────────────────────────────
// Stores public URLs for Autodiscover, EWS, OWA, EAS, IMAP, SMTP.
// Outlook 2019/2022/365 reads these automatically via Autodiscover.
model ServerSettings {
  id              String   @id @default("singleton")
  // Public hostname (for Autodiscover + TLS certificate)
  publicHostname  String   @default("mail.local")
  // Protocol: http or https
  useHttps        Boolean  @default(false)
  // HTTP port (external, e.g. 8080 on Synology or 443 behind a reverse proxy)
  httpPort        Int      @default(8080)
  // Exchange Web Services (Outlook Desktop)
  ewsUrl          String   @default("http://mail.local:8080/EWS/Exchange.asmx")
  // Outlook Web Access
  owaUrl          String   @default("http://mail.local:8080/owa/")
  // Exchange ActiveSync (Mobile)
  easUrl          String   @default("http://mail.local:8080/Microsoft-Server-ActiveSync")
  // Autodiscover base URL
  autodiscoverBase String  @default("http://mail.local:8080")
  // IMAP
  imapHost        String   @default("mail.local")
  imapPort        Int      @default(993)
  imapSsl         Boolean  @default(true)
  // POP3
  pop3Host        String   @default("mail.local")
  pop3Port        Int      @default(995)
  pop3Ssl         Boolean  @default(true)
  // SMTP Submission
  smtpHost        String   @default("mail.local")
  smtpPort        Int      @default(587)
  smtpTls         Boolean  @default(true)
  // ── Organization ─────────────────────────────────────────────────────────
  orgName         String   @default("CoreMail")
  orgDescription  String   @default("")
  adminEmail      String   @default("")
  language        String   @default("de")
  timezone        String   @default("Europe/Berlin")
  welcomeMessage  String   @default("")
  logoUrl         String   @default("")

  // ── Mail limits ──────────────────────────────────────────────────────────
  maxMessageSizeMb    Int  @default(25)
  maxAttachmentSizeMb Int  @default(25)
  trashRetentionDays  Int  @default(30)

  // ── Security policies ────────────────────────────────────────────────
  minPasswordLength          Int     @default(8)
  maxLoginAttempts           Int     @default(5)
  sessionTimeoutMinutes      Int     @default(480)
  // 0 = disabled; > 0 = minutes until automatic logout on browser inactivity
  inactivityTimeoutMinutes   Int     @default(30)
  requireMfaForAdmins        Boolean @default(false)
  // v3.18.30: audit log globally on/off. Default on. The toggle itself is audited.
  auditLogEnabled            Boolean @default(true)
  allowSelfRegistration      Boolean @default(false)
  // Allows users to reset their own password via an e-mail link
  selfServicePasswordReset   Boolean @default(true)

  // ── Protocols ────────────────────────────────────────────────────────────
  // v5.7.0: MAPI over HTTP (Outlook "Exchange account") can optionally be enabled.
  // Default OFF: /mapi/* returns 404 and Autodiscover does not announce a
  // <Protocol Type="mapiHttp"> → Outlook sets itself up as an IMAP account.
  // Hot reload via Redis CHANNEL_SETTINGS_RELOAD (no container restart).
  mapiHttpEnabled    Boolean @default(false)
  // v5.7.1: JMAP (RFC 8620/8621 + extensions) on /jmap/* and
  // /.well-known/jmap. Default ON; off → 404. Hot reload like MAPI.
  jmapEnabled        Boolean @default(true)

  // ── Maintenance ───────────────────────────────────────────────────────────────
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String  @default("Der Server befindet sich derzeit in Wartung. Bitte versuchen Sie es später erneut.")

  // ── TLS certificate (SMTP/IMAP/POP3 implicit TLS: ports 465, 993, 995) ──────
  // Generated automatically as a self-signed certificate on first start.
  // Can be replaced with an official Let's Encrypt certificate via the admin panel.
  tlsCert  String?  // PEM-encoded certificate
  tlsKey   String?  // PEM-encoded private key

  // v5.6.0: jwtPrivateKey/jwtPublicKey/jwtKeyId/jwtKeyCreated removed
  // (RS256 keys were for OAuth2/OIDC — completely out of the stack).
  // JWT back to HS256 + JWT_SECRET env variable.

  updatedAt       DateTime @updatedAt

  @@map("server_settings")
}

// ── Service listeners ──────────────────────────────────────────────────────────
// Configurable listeners per protocol service (SMTP / IMAP / POP3)
// Shows which addresses + ports a service listens on, whether TLS is active, etc.

enum ServiceType {
  SMTP_RECEIVE
  SMTP_SEND
  IMAP
  POP3
}

model ServiceListener {
  id        String      @id @default(cuid())
  service   ServiceType
  address   String      @default("0.0.0.0")
  port      Int
  ssl       Boolean     @default(false)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("service_listeners")
}

// ── Mail connectors (send / receive connectors) ─────────────────────────────

enum ConnectorType {
  SEND      // Outbound connections to relay/smarthost
  RECEIVE   // Inbound connections (accepted sources)
}

model MailConnector {
  id               String        @id @default(cuid())
  name             String
  description      String        @default("")
  type             ConnectorType
  enabled          Boolean       @default(true)
  // SEND: target SMTP host / RECEIVE: source addresses (CIDR)
  host             String        @default("")
  port             Int           @default(25)
  tls              Boolean       @default(false)
  requireTls       Boolean       @default(false)
  // RECEIVE: allowed source IPs/ranges (CIDR, empty = all)
  sourceIps        String[]
  // SEND: which domains this connector applies to (empty = fallback for all)
  targetDomains    String[]
  // Auth credentials for SEND
  username         String?
  password         String?       // plaintext internally (should be vault-secured)
  // Priority (lower value = higher priority)
  priority         Int           @default(0)
  createdBy        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([type, enabled])
  @@map("mail_connectors")
}

// ── Organization & sharing policies ────────────────────────────────────────

model SharingPolicy {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  enabled     Boolean  @default(true)
  // Domains allowed to receive calendar/contact shares
  // Empty = all external domains allowed
  allowedDomains String[]
  // What may be shared
  allowCalendar  Boolean @default(true)
  allowContacts  Boolean @default(false)
  // FreeBusy vs. full calendar details
  calendarDetail String  @default("FREEBUSY") // FREEBUSY | LIMITED | FULL
  isDefault      Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sharing_policies")
}

model AddressList {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  // LDAP-like filter: {type: "all"|"users"|"groups"|"rooms", domainId?, department?}
  filter      Json     @default("{}")
  isGal       Boolean  @default(false) // Global address list
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("address_lists")
}

// ── SSL/TLS certificate management ─────────────────────────────────────────────

enum CertType {
  LETSENCRYPT  // Automatic via ACME HTTP-01
  CUSTOM       // Manually uploaded (PEM)
  SELF_SIGNED  // Self-signed (generated internally)
}

enum CertStatus {
  PENDING   // issuance in progress / not issued yet
  ACTIVE    // valid
  EXPIRING  // expires in ≤ 30 days
  EXPIRED   // expired
  ERROR     // error during issuance / renewal
  RENEWING  // renewal in progress
}

model Certificate {
  id          String     @id @default(cuid())
  name        String                          // display name, e.g. "mail.example.com Wildcard"
  domains     String[]                        // primary domain + SANs
  services    String[]                        // assigned services: OWA, ECP, SMTP, IMAP, POP3, EWS, DAV
  type        CertType   @default(LETSENCRYPT)
  status      CertStatus @default(PENDING)
  // PEM data (stored in plaintext for internal use)
  certPem     String?                         // certificate (public)
  keyPem      String?                         // private key
  chainPem    String?                         // CA chain
  // Timestamps
  issuedAt    DateTime?
  expiresAt   DateTime?
  autoRenew      Boolean    @default(true)
  // Integrated HTTPS reverse proxy (only one certificate active at a time)
  isActiveHttps    Boolean    @default(false)
  // Protocol TLS: SMTP / IMAP / POP3 read from ServerSettings.tlsCert/tlsKey.
  // isActiveProtocol marks which certificate is currently stored there (only one).
  isActiveProtocol Boolean    @default(false)
  // Let's Encrypt account key (PEM) — stored per server
  acmeAccount String?                         // ACME Account Key PEM
  acmeEmail   String?                         // e-mail for Let's Encrypt notifications
  lastError   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("certificates")
}

