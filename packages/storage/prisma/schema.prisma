generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
  // Explizit nur OpenSSL-3-Target — "native" weglassen da Auto-Detection in Alpine fehlschlägt
  binaryTargets   = ["linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  USER
  HELP_DESK
  RECIPIENT_MANAGEMENT
  COMPLIANCE_MANAGEMENT
  HYGIENE_MANAGEMENT
  SERVER_MANAGEMENT
  VIEW_ONLY_ORG
  ORGANIZATION_MANAGEMENT
}

enum SharedMailboxPermType {
  FULL_ACCESS
  SEND_AS
  SEND_ON_BEHALF
  READ_ONLY
}

enum LogLevel {
  ERROR
  WARN
  INFO
  DEBUG
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuthSource {
  LOCAL
  LDAP
  OIDC
}

enum GroupType {
  STATIC
  DYNAMIC
}

enum ResourceType {
  ROOM
  EQUIPMENT
}

// ─────────────────────────────────────────────
// Domains & Users
// ─────────────────────────────────────────────

model Domain {
  id                 String               @id @default(cuid())
  name               String               @unique
  dkimPrivateKey     String
  dkimSelector       String               @default("coremail")
  active             Boolean              @default(true)
  primary            Boolean              @default(false)
  users              User[]
  sharedMailboxes    SharedMailbox[]
  ldapConfig         LdapConfig?
  oidcProviders      OidcProvider[]
  distributionGroups DistributionGroup[]
  resourceMailboxes  ResourceMailbox[]
  createdAt          DateTime             @default(now())

  @@map("domains")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  displayName     String
  passwordHash    String?
  authSource      AuthSource     @default(LOCAL)
  externalId      String?        // LDAP objectGUID or OIDC sub
  role            UserRole       @default(USER)
  quotaBytes      BigInt         @default(5368709120)
  usedBytes       BigInt         @default(0)
  active          Boolean        @default(true)
  domain          Domain         @relation(fields: [domainId], references: [id])
  domainId        String
  mailbox         Mailbox?
  calendars       Calendar[]
  contacts        Contact[]
  sessions        Session[]
  mfa             UserMfa?
  appPasswords    AppPassword[]
  sharedPerms     SharedMailboxPerm[]
  activeSyncDevices ActiveSyncDevice[]
  certificates    UserCertificate[]
  smimeSettings   SmimeSettings?
  pushSubscriptions PushSubscription[]
  oauthCodes      OAuthAuthorizationCode[]
  oauthTokens     OAuthToken[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([domainId])
  @@index([externalId])
  @@map("users")
}

// ─────────────────────────────────────────────
// Authentication
// ─────────────────────────────────────────────

model Session {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  tokenHash   String   @unique
  ipAddress   String
  userAgent   String   @default("")
  mfaVerified Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserMfa {
  id                  String  @id @default(cuid())
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String  @unique
  totpSecret          String?
  totpEnabled         Boolean @default(false)
  webAuthnCredentials Json    @default("[]")
  backupCodes         String[]
  backupCodesUsed     Int     @default(0)
  emailOtpEnabled     Boolean @default(false)

  @@map("user_mfa")
}

model AppPassword {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  hash        String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("app_passwords")
}

model LdapConfig {
  id           String   @id @default(cuid())
  domain       Domain   @relation(fields: [domainId], references: [id])
  domainId     String   @unique
  host         String
  port         Int      @default(636)
  ssl          Boolean  @default(true)
  baseDN       String
  bindDN       String
  bindPassword String
  userFilter   String   @default("(sAMAccountName={{username}})")
  userDN       String
  groupFilter  String?
  attributeMap Json     @default("{}")
  syncEnabled  Boolean  @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())

  @@map("ldap_configs")
}

model OidcProvider {
  id             String   @id @default(cuid())
  domain         Domain   @relation(fields: [domainId], references: [id])
  domainId       String
  name           String
  discoveryUrl   String
  clientId       String
  clientSecret   String
  claimMap       Json     @default("{}")
  autoProvision  Boolean  @default(true)
  forcedDomains  String[]
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("oidc_providers")
}

// ─────────────────────────────────────────────
// Mail Storage
// ─────────────────────────────────────────────

model Mailbox {
  id              String           @id @default(cuid())
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String?          @unique
  sharedBox       SharedMailbox?   @relation(fields: [sharedBoxId], references: [id])
  sharedBoxId     String?          @unique
  resourceMailbox ResourceMailbox?
  uidValidity     Int              @default(1)
  uidNext         Int              @default(1)
  highestModSeq   BigInt           @default(0)
  folders         Folder[]
  createdAt       DateTime         @default(now())

  @@map("mailboxes")
}

model Folder {
  id          String    @id @default(cuid())
  mailbox     Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  mailboxId   String
  name        String
  displayName String
  parent      Folder?   @relation("FolderTree", fields: [parentId], references: [id])
  parentId    String?
  children    Folder[]  @relation("FolderTree")
  messages    Message[]
  totalCount  Int       @default(0)
  unreadCount Int       @default(0)
  changeKey   String    @default("")
  subscribed  Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([mailboxId, name])
  @@index([mailboxId])
  @@map("folders")
}

model Message {
  id           String      @id @default(cuid())
  folder       Folder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId     String
  uid          Int
  modSeq       BigInt
  flags        String[]
  subject      String      @default("")
  fromAddr     String      @default("")
  fromName     String      @default("")
  toAddrs      String[]
  ccAddrs      String[]
  bccAddrs     String[]
  replyTo      String?
  messageId    String?     // RFC 2822 Message-ID header
  inReplyTo    String?
  date         DateTime
  bodyText     String      @default("")
  bodyHtml     String      @default("")
  rawSize      Int         @default(0)
  storagePath  String?     // MinIO object key for large messages
  changeKey    String      @default("")
  deletedAt    DateTime?   // soft-delete (30 day recovery window)
  // Phase 9: S/MIME metadata JSON — { signed, valid, signerEmail, decrypted, ... }
  smimeMeta    String?
  attachments  Attachment[]
  createdAt    DateTime    @default(now())

  @@unique([folderId, uid])
  @@index([folderId, date])
  @@index([folderId, modSeq])
  @@index([messageId])
  @@index([deletedAt])
  @@map("messages")
}

model Attachment {
  id          String   @id @default(cuid())
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId   String
  contentId   String?
  filename    String
  mimeType    String
  size        Int
  sha256      String
  storagePath String
  inline      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([messageId])
  @@index([sha256])
  @@map("attachments")
}

// ─────────────────────────────────────────────
// Shared Mailboxes
// ─────────────────────────────────────────────

model SharedMailbox {
  id          String              @id @default(cuid())
  email       String              @unique
  displayName String
  domain      Domain              @relation(fields: [domainId], references: [id])
  domainId    String
  quotaBytes  BigInt              @default(10737418240)
  usedBytes   BigInt              @default(0)
  active      Boolean             @default(true)
  permissions SharedMailboxPerm[]
  mailbox     Mailbox?
  createdAt   DateTime            @default(now())

  @@index([domainId])
  @@map("shared_mailboxes")
}

model SharedMailboxPerm {
  id              String               @id @default(cuid())
  sharedMailbox   SharedMailbox        @relation(fields: [sharedMailboxId], references: [id], onDelete: Cascade)
  sharedMailboxId String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  permission      SharedMailboxPermType
  grantedAt       DateTime             @default(now())
  grantedBy       String

  @@unique([sharedMailboxId, userId])
  @@map("shared_mailbox_perms")
}

// ─────────────────────────────────────────────
// Calendaring
// ─────────────────────────────────────────────

model Calendar {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  color       String          @default("#0078D4")
  isDefault   Boolean         @default(false)
  acl         Json            @default("{}")
  syncToken   String          @default("")
  events      CalendarEvent[]
  createdAt   DateTime        @default(now())

  @@index([userId])
  @@map("calendars")
}

model CalendarEvent {
  id          String   @id @default(cuid())
  calendar    Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId  String
  uid         String   @unique // iCal UID
  icalData    String
  summary     String
  description String   @default("")
  location    String   @default("")
  dtStart     DateTime
  dtEnd       DateTime
  allDay      Boolean  @default(false)
  recurring   Boolean  @default(false)
  rrule       String?
  organizer   String?
  attendees   Json     @default("[]")
  status      String   @default("CONFIRMED")
  changeKey   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([calendarId, dtStart])
  @@map("calendar_events")
}

// ─────────────────────────────────────────────
// Contacts
// ─────────────────────────────────────────────

model Contact {
  id          String  @id @default(cuid())
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  vcardData   String
  displayName String
  email       String  @default("")
  email2      String  @default("")
  phone       String  @default("")
  mobile      String  @default("")
  company     String  @default("")
  department  String  @default("")
  jobTitle    String  @default("")
  notes       String  @default("")
  photoUrl    String?
  changeKey   String  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([email])
  @@map("contacts")
}

// ─────────────────────────────────────────────
// Tasks & Notes
// ─────────────────────────────────────────────

model Task {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  body        String   @default("")
  status      String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED | DEFERRED
  priority    String   @default("NORMAL")       // LOW | NORMAL | HIGH
  dueDate     DateTime?
  completedAt DateTime?
  reminder    DateTime?
  changeKey   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("tasks")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  subject   String   @default("Notiz")
  body      String   @default("")
  color     String   @default("YELLOW")
  changeKey String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notes")
}

// ─────────────────────────────────────────────
// User Settings & Mail Rules
// ─────────────────────────────────────────────

model UserSettings {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  signature               String    @default("")
  signatureAutoNew        Boolean   @default(true)
  signatureAutoReply      Boolean   @default(false)
  oofEnabled              Boolean   @default(false)
  oofInternal             String    @default("")
  oofExternal             String    @default("")
  oofExternalEnabled      Boolean   @default(true)
  oofExternalOnlyContacts Boolean   @default(false)
  oofUseTimeRange         Boolean   @default(false)
  oofStart                DateTime?
  oofEnd                  DateTime?
  updatedAt               DateTime  @updatedAt

  @@map("user_settings")
}

model MailRule {
  id         String   @id @default(cuid())
  userId     String
  name       String
  enabled    Boolean  @default(true)
  priority   Int      @default(0)
  conditions Json     @default("[]")
  actions    Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("mail_rules")
}

// ─────────────────────────────────────────────
// Backup Jobs
// ─────────────────────────────────────────────

model BackupJob {
  id          String    @id @default(cuid())
  userId      String?
  scope       String    // "user" | "domain" | "full"
  format      String    // "mbox" | "eml" | "full"
  status      JobStatus @default(PENDING)
  progress    Int       @default(0)
  downloadUrl String?
  expiresAt   DateTime?
  errorMsg    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
  @@map("backup_jobs")
}

// ─────────────────────────────────────────────
// System Logs
// ─────────────────────────────────────────────

model SystemLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     LogLevel
  service   String
  category  String   @default("SYSTEM")
  message   String
  metadata  Json?
  userId    String?
  messageId String?

  @@index([timestamp])
  @@index([service, timestamp])
  @@index([level, timestamp])
  @@index([category, timestamp])
  @@map("system_logs")
}

// ─────────────────────────────────────────────
// Security Filter
// ─────────────────────────────────────────────

model Blacklist {
  id         String   @id @default(cuid())
  pattern    String
  patternType String  @default("EXACT") // EXACT | WILDCARD | REGEX
  scope      String   @default("GLOBAL") // GLOBAL | DOMAIN | USER
  scopeId    String?  // domainId or userId for non-global
  comment    String   @default("")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([scope, scopeId])
  @@map("blacklist")
}

model Quarantine {
  id          String   @id @default(cuid())
  messageId   String?
  fromAddr    String
  toAddr      String
  subject     String   @default("")
  reason      String   // VIRUS | SPAM | POLICY
  details     Json     @default("{}")
  rawPath     String   // MinIO path to raw message
  released    Boolean  @default(false)
  releasedAt  DateTime?
  releasedBy  String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([reason])
  @@map("quarantine")
}

// ─────────────────────────────────────────────
// Phase 6 — ActiveSync (EAS)
// ─────────────────────────────────────────────

model ActiveSyncDevice {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId        String   // EAS DeviceId header
  deviceType      String   @default("")  // EAS DeviceType (iPhone, Android, etc.)
  deviceFriendlyName String @default("")
  policyKey       String   @default("0")
  status          String   @default("OK") // OK | PENDING | BLOCKED | WIPED
  lastSyncAt      DateTime?
  remoteWipeAt    DateTime?
  createdAt       DateTime @default(now())
  folderSyncKey   String   @default("0")
  syncKeys        Json     @default("{}") // folderId → syncKey map

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("active_sync_devices")
}

// ─────────────────────────────────────────────
// Phase 6 — S/MIME Certificates
// ─────────────────────────────────────────────

model UserCertificate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("My Certificate")
  fingerprint   String   @unique  // SHA-256 hex
  subject       String   // X.509 Subject DN
  issuer        String   // X.509 Issuer DN
  notBefore     DateTime
  notAfter      DateTime
  storagePath   String   // MinIO path to encrypted PKCS#12
  signingDefault Boolean @default(false)
  encryptDefault Boolean @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("user_certificates")
}

// ─────────────────────────────────────────────
// Phase 7 — Distribution Groups
// ─────────────────────────────────────────────

model DistributionGroup {
  id                String                    @id @default(cuid())
  email             String                    @unique
  displayName       String
  description       String                    @default("")
  domain            Domain                    @relation(fields: [domainId], references: [id])
  domainId          String
  groupType         GroupType                 @default(STATIC)
  ldapFilter        String?                   // for DYNAMIC groups
  requireSenderAuth Boolean                   @default(false)
  allowExternal     Boolean                   @default(true)
  moderationEnabled Boolean                   @default(false)
  moderatorIds      String[]
  hiddenFromGal     Boolean                   @default(false)
  active            Boolean                   @default(true)
  members           DistributionGroupMember[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([domainId])
  @@index([email])
  @@map("distribution_groups")
}

model DistributionGroupMember {
  id          String            @id @default(cuid())
  group       DistributionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  memberEmail String            // resolved email address
  memberType  String            @default("USER") // USER | SHARED_MAILBOX | GROUP | EXTERNAL
  addedAt     DateTime          @default(now())
  addedBy     String?           // userId of admin who added

  @@unique([groupId, memberEmail])
  @@index([groupId])
  @@map("distribution_group_members")
}

// ─────────────────────────────────────────────
// Phase 7 — Resource Mailboxes (Rooms & Equipment)
// ─────────────────────────────────────────────

model ResourceMailbox {
  id                  String           @id @default(cuid())
  email               String           @unique
  displayName         String
  resourceType        ResourceType     @default(ROOM)
  domain              Domain           @relation(fields: [domainId], references: [id])
  domainId            String
  capacity            Int?
  location            String           @default("")
  phone               String           @default("")
  autoAccept          Boolean          @default(true)
  autoDeclineConflict Boolean          @default(true)
  allowRecurring      Boolean          @default(true)
  maxDurationMinutes  Int?
  bookingWindowDays   Int              @default(180)
  requireApproval     Boolean          @default(false)
  delegateIds         String[]
  active              Boolean          @default(true)
  mailboxId           String?          @unique
  mailbox             Mailbox?         @relation(fields: [mailboxId], references: [id])
  calendar            ResourceCalendar?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([domainId])
  @@map("resource_mailboxes")
}

model ResourceCalendar {
  id         String           @id @default(cuid())
  resource   ResourceMailbox  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId String           @unique
  bookings   ResourceBooking[]
  createdAt  DateTime         @default(now())

  @@map("resource_calendars")
}

model ResourceBooking {
  id         String           @id @default(cuid())
  calendar   ResourceCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId String
  uid        String           @unique // iCal UID
  summary    String
  organizer  String
  attendees  Json             @default("[]")
  dtStart    DateTime
  dtEnd      DateTime
  status     String           @default("ACCEPTED") // ACCEPTED | DECLINED | TENTATIVE | PENDING
  icalData   String
  createdAt  DateTime         @default(now())

  @@index([calendarId, dtStart])
  @@index([dtStart, dtEnd])
  @@map("resource_bookings")
}

// ─────────────────────────────────────────────
// Phase 7 — Public Folders
// ─────────────────────────────────────────────

model PublicFolder {
  id          String                @id @default(cuid())
  name        String
  displayName String
  description String                @default("")
  parent      PublicFolder?         @relation("PublicFolderTree", fields: [parentId], references: [id])
  parentId    String?
  children    PublicFolder[]        @relation("PublicFolderTree")
  messages    PublicFolderMessage[]
  // ACL: [{userId: string, permission: "READ"|"POST"|"OWNER"}]
  acl         Json                  @default("[]")
  totalCount  Int                   @default(0)
  createdBy   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@map("public_folders")
}

model PublicFolderMessage {
  id          String       @id @default(cuid())
  folder      PublicFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId    String
  subject     String       @default("")
  fromAddr    String
  fromName    String       @default("")
  bodyText    String       @default("")
  bodyHtml    String       @default("")
  date        DateTime
  attachments Json         @default("[]")
  createdAt   DateTime     @default(now())

  @@index([folderId, date])
  @@map("public_folder_messages")
}

// ─────────────────────────────────────────────
// Phase 8 — eDiscovery & Legal Hold
// ─────────────────────────────────────────────

enum EDiscoveryStatus {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
}

model EDiscoverySearch {
  id          String            @id @default(cuid())
  name        String
  description String            @default("")
  status      EDiscoveryStatus  @default(DRAFT)
  // query: { keywords?, senderAddresses?, recipientAddresses?, dateFrom?, dateTo?, hasAttachment? }
  query       Json              @default("{}")
  // empty = all mailboxes
  mailboxIds  String[]
  resultCount Int               @default(0)
  exportPath  String?           // MinIO path to exported archive
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([createdBy])
  @@index([status])
  @@map("ediscovery_searches")
}

model LegalHold {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  // userIds under hold — messages cannot be permanently deleted
  mailboxIds  String[]
  active      Boolean   @default(true)
  appliedBy   String    // userId of admin
  appliedAt   DateTime  @default(now())
  releasedAt  DateTime?

  @@index([active])
  @@map("legal_holds")
}

// ─────────────────────────────────────────────
// Phase 8 — Transport Rules
// ─────────────────────────────────────────────

model TransportRule {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  // conditions: [{field: "from"|"to"|"subject"|"body"|"hasAttachment", op: "contains"|"equals"|"regex", value}]
  conditions  Json     @default("[]")
  // actions: [{type: "addHeader"|"removeHeader"|"redirect"|"reject"|"addRecipient"|"setSubjectPrefix", value}]
  actions     Json     @default("[]")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, priority])
  @@map("transport_rules")
}

// ─────────────────────────────────────────────
// Phase 9 — S/MIME Inline Settings
// ─────────────────────────────────────────────

model SmimeSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Automatically sign all outgoing messages
  autoSign       Boolean  @default(false)
  // Automatically encrypt outgoing messages when recipient cert is available
  autoEncrypt    Boolean  @default(false)
  // Verify incoming S/MIME signatures and show result in UI
  verifyIncoming Boolean  @default(true)
  // Attempt to decrypt incoming encrypted messages automatically
  decryptIncoming Boolean @default(true)
  updatedAt      DateTime @updatedAt

  @@map("smime_settings")
}

// ─────────────────────────────────────────────
// Phase 9 — Journaling Rules (RFC 3462)
// ─────────────────────────────────────────────

enum JournalScope {
  ALL            // All messages (inbound + outbound + internal)
  INBOUND        // Only inbound messages
  OUTBOUND       // Only outbound messages
  INTERNAL       // Only internal (same-domain) messages
}

enum JournalRecipientType {
  ALL_MAILBOXES  // Journal every mailbox in the org
  SPECIFIC_USERS // Only the listed userIds
  DOMAIN         // Every mailbox of a specific domain
}

model JournalingRule {
  id            String               @id @default(cuid())
  name          String
  description   String               @default("")
  enabled       Boolean              @default(true)
  // The journal sink — messages are BCC'd / forwarded to this address
  journalAddress String
  scope         JournalScope         @default(ALL)
  recipientType JournalRecipientType @default(ALL_MAILBOXES)
  // userIds or domainId depending on recipientType
  recipientIds  String[]
  // RFC 3462 journal report wrapping (true = wrap in Journal Report MIME envelope)
  wrapAsReport  Boolean              @default(true)
  createdBy     String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([enabled])
  @@map("journaling_rules")
}

// ─────────────────────────────────────────────
// Phase 9 — Retention Policies
// ─────────────────────────────────────────────

enum RetentionAction {
  ARCHIVE        // Move to Archive folder
  DELETE         // Permanently delete (unless under Legal Hold)
  MOVE_TO_FOLDER // Move to a specified folder
}

enum RetentionScope {
  ALL_ITEMS      // Apply to all mail items
  INBOX          // Only Inbox
  SENT_ITEMS     // Only Sent Items
  DELETED_ITEMS  // Only Deleted Items / Trash
  JUNK           // Only Junk/Spam folder
}

model RetentionPolicy {
  id          String               @id @default(cuid())
  name        String
  description String               @default("")
  enabled     Boolean              @default(true)
  // Number of days after which the action is triggered (based on message date)
  retentionDays Int
  action      RetentionAction      @default(ARCHIVE)
  // For MOVE_TO_FOLDER action: target folder name
  targetFolder String?
  scope       RetentionScope       @default(ALL_ITEMS)
  // If true, items under Legal Hold are skipped even if they match
  respectLegalHold Boolean         @default(true)
  assignments RetentionPolicyAssignment[]
  createdBy   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("retention_policies")
}

enum RetentionAssignmentTarget {
  USER           // Assigned to a specific user mailbox
  DOMAIN         // Assigned to all users of a domain
  GLOBAL         // Applies to all mailboxes in the org
}

model RetentionPolicyAssignment {
  id         String                   @id @default(cuid())
  policy     RetentionPolicy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyId   String
  target     RetentionAssignmentTarget @default(GLOBAL)
  // userId or domainId, empty string for GLOBAL
  targetId   String                   @default("")
  createdAt  DateTime                 @default(now())

  @@unique([policyId, target, targetId])
  @@index([policyId])
  @@map("retention_policy_assignments")
}

// ─────────────────────────────────────────────
// Phase 10 — Audit Log
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  // Actor — null means system action
  actorId    String?
  actorEmail String?
  // Action string: "mailbox.create", "user.delete", "auth.login", "rule.update", etc.
  action     String
  // Target resource
  targetType String?  // "user" | "domain" | "mailbox" | "rule" | "session" | ...
  targetId   String?
  targetName String?
  // Request context
  ipAddress  String?
  userAgent  String?
  // Optional before/after diff (JSON)
  changes    Json?
  // Outcome
  success    Boolean  @default(true)
  errorMsg   String?

  @@index([timestamp])
  @@index([actorId, timestamp])
  @@index([action, timestamp])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Phase 10 — VAPID Push Subscriptions
// ─────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Web Push endpoint URL (browser-specific)
  endpoint  String   @unique
  // ECDH keys for payload encryption
  p256dhKey String
  authKey   String
  userAgent String?
  // Topics the client is subscribed to
  topics    String[] // e.g. ["mail.new", "calendar.reminder"]
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ─────────────────────────────────────────────
// Phase 10 — OAuth2 / Modern Auth (EWS)
// ─────────────────────────────────────────────

model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientSecret String   // bcrypt hash for confidential clients
  name         String
  description  String   @default("")
  redirectUris String[]
  // Available scopes: "mail" | "calendar" | "contacts" | "ews" | "admin"
  allowedScopes String[]
  // Trusted clients skip user consent screen
  trusted      Boolean  @default(false)
  active       Boolean  @default(true)
  createdBy    String
  createdAt    DateTime @default(now())
  tokens       OAuthToken[]
  codes        OAuthAuthorizationCode[]

  @@map("oauth_clients")
}

model OAuthAuthorizationCode {
  id          String      @id @default(cuid())
  code        String      @unique
  client      OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String      // space-separated list
  redirectUri String
  codeChallenge     String?  // PKCE S256
  codeChallengeMethod String? @default("S256")
  expiresAt   DateTime
  used        Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([code])
  @@index([userId])
  @@map("oauth_authorization_codes")
}

model OAuthToken {
  id               String      @id @default(cuid())
  accessToken      String      @unique
  tokenType        String      @default("Bearer")
  scope            String
  expiresAt        DateTime
  refreshToken     String?     @unique
  refreshExpiresAt DateTime?
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId         String
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked          Boolean     @default(false)
  createdAt        DateTime    @default(now())

  @@index([accessToken])
  @@index([refreshToken])
  @@index([userId, clientId])
  @@map("oauth_tokens")
}

// ─────────────────────────────────────────────
// Phase 10 — SMTP Gateway Settings
// ─────────────────────────────────────────────

model GatewaySettings {
  id                  String   @id @default("singleton")
  enabled             Boolean  @default(false)
  upstreamHost        String   @default("")
  upstreamPort        Int      @default(25)
  upstreamTls         Boolean  @default(false)
  upstreamUsername    String?
  upstreamPassword    String?
  // Domains to relay inbound mail for (empty = all accepted domains)
  relayDomains        String[]
  // Apply spam/virus filter before relaying
  filterBeforeRelay   Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  @@map("gateway_settings")
}

// ── Sicherheitseinstellungen (Singleton) ─────────────────────────────────────
model SecuritySettings {
  id                    String   @id @default("singleton")
  // Greylisting
  greylistEnabled       Boolean  @default(true)
  greylistWaitSec       Int      @default(300)
  greylistTtlHours      Int      @default(4)
  // DNSBL
  dnsblEnabled          Boolean  @default(true)
  dnsblZones            Json     @default("[\"zen.spamhaus.org\",\"bl.spamcop.net\"]")
  // GeoIP-Länderfilter
  geoipMode             String   @default("DISABLED")
  geoipCountries        Json     @default("[]")
  // Anhänge-Filter
  attachmentEnabled     Boolean  @default(true)
  attachmentMaxSizeMb   Int      @default(50)
  attachmentBlockedExt  Json     @default("[\"exe\",\"vbs\",\"js\",\"bat\",\"cmd\",\"scr\",\"pif\",\"msi\",\"hta\",\"com\"]")
  // Rspamd
  rspamdEnabled         Boolean  @default(true)
  rspamdGreylistScore   Float    @default(4.0)
  rspamdSpamScore       Float    @default(6.0)
  rspamdRejectScore     Float    @default(15.0)
  // ClamAV
  clamavEnabled         Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  @@map("security_settings")
}

// ── Server-Einstellungen (Singleton) ─────────────────────────────────────────
// Speichert öffentliche URLs für Autodiscover, EWS, OWA, EAS, IMAP, SMTP.
// Outlook 2019/2022/365 liest diese über Autodiscover automatisch aus.
model ServerSettings {
  id              String   @id @default("singleton")
  // Öffentlicher Hostname (für Autodiscover + TLS-Zertifikat)
  publicHostname  String   @default("mail.local")
  // Protokoll: http oder https
  useHttps        Boolean  @default(false)
  // HTTP-Port (extern, z.B. 8080 auf Synology oder 443 hinter Reverse Proxy)
  httpPort        Int      @default(8080)
  // Exchange Web Services (Outlook Desktop)
  ewsUrl          String   @default("http://mail.local:8080/EWS/Exchange.asmx")
  // Outlook Web Access
  owaUrl          String   @default("http://mail.local:8080/owa/")
  // Exchange ActiveSync (Mobile)
  easUrl          String   @default("http://mail.local:8080/Microsoft-Server-ActiveSync")
  // Autodiscover-Basis-URL
  autodiscoverBase String  @default("http://mail.local:8080")
  // IMAP
  imapHost        String   @default("mail.local")
  imapPort        Int      @default(993)
  imapSsl         Boolean  @default(true)
  // POP3
  pop3Host        String   @default("mail.local")
  pop3Port        Int      @default(995)
  pop3Ssl         Boolean  @default(true)
  // SMTP Submission
  smtpHost        String   @default("mail.local")
  smtpPort        Int      @default(587)
  smtpTls         Boolean  @default(true)
  // ── Organisation ─────────────────────────────────────────────────────────
  orgName         String   @default("CoreMail")
  orgDescription  String   @default("")
  adminEmail      String   @default("")
  language        String   @default("de")
  timezone        String   @default("Europe/Berlin")
  welcomeMessage  String   @default("")
  logoUrl         String   @default("")

  // ── Mail-Grenzen ──────────────────────────────────────────────────────────
  maxMessageSizeMb    Int  @default(25)
  maxAttachmentSizeMb Int  @default(25)
  trashRetentionDays  Int  @default(30)

  // ── Sicherheitsrichtlinien ────────────────────────────────────────────────
  minPasswordLength     Int     @default(8)
  maxLoginAttempts      Int     @default(5)
  sessionTimeoutMinutes Int     @default(480)
  requireMfaForAdmins   Boolean @default(false)
  allowSelfRegistration Boolean @default(false)

  // ── Wartung ───────────────────────────────────────────────────────────────
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String  @default("Der Server befindet sich derzeit in Wartung. Bitte versuchen Sie es später erneut.")

  updatedAt       DateTime @updatedAt

  @@map("server_settings")
}

// ── Service-Listeners ──────────────────────────────────────────────────────────
// Konfigurierbare Listener pro Protokoll-Service (SMTP / IMAP / POP3)
// Zeigt welche Adressen + Ports ein Service lauscht, ob TLS aktiv ist, etc.

enum ServiceType {
  SMTP_RECEIVE
  SMTP_SEND
  IMAP
  POP3
}

model ServiceListener {
  id        String      @id @default(cuid())
  service   ServiceType
  address   String      @default("0.0.0.0")
  port      Int
  ssl       Boolean     @default(false)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("service_listeners")
}

// ── Mail-Connectors (Sende- / Empfangsconnectors) ─────────────────────────────

enum ConnectorType {
  SEND      // Ausgehende Verbindungen zu Relay-/Smarthost
  RECEIVE   // Eingehende Verbindungen (akzeptierte Quellen)
}

model MailConnector {
  id               String        @id @default(cuid())
  name             String
  description      String        @default("")
  type             ConnectorType
  enabled          Boolean       @default(true)
  // SEND: Ziel-SMTP-Host / RECEIVE: Quelladressen (CIDR)
  host             String        @default("")
  port             Int           @default(25)
  tls              Boolean       @default(false)
  requireTls       Boolean       @default(false)
  // RECEIVE: Erlaubte Quell-IPs/Ranges (CIDR, leer = alle)
  sourceIps        String[]
  // SEND: Für welche Domains gilt dieser Connector (leer = Fallback für alle)
  targetDomains    String[]
  // Auth-Credentials für SEND
  username         String?
  password         String?       // klartext intern (sollte vault-gesichert sein)
  // Priorität (niedrigerer Wert = höhere Priorität)
  priority         Int           @default(0)
  createdBy        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([type, enabled])
  @@map("mail_connectors")
}

// ── Organisation & Sharing-Richtlinien ────────────────────────────────────────

model SharingPolicy {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  enabled     Boolean  @default(true)
  // Domains die Kalender-/Kontakt-Freigaben empfangen dürfen
  // Leer = alle externen Domains erlaubt
  allowedDomains String[]
  // Was darf geteilt werden
  allowCalendar  Boolean @default(true)
  allowContacts  Boolean @default(false)
  // FreeBusy vs. volle Kalenderdetails
  calendarDetail String  @default("FREEBUSY") // FREEBUSY | LIMITED | FULL
  isDefault      Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sharing_policies")
}

model AddressList {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  // LDAP-artiger Filter: {type: "all"|"users"|"groups"|"rooms", domainId?, department?}
  filter      Json     @default("{}")
  isGal       Boolean  @default(false) // Globale Adressliste
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("address_lists")
}

// ── SSL/TLS Zertifikat-Verwaltung ─────────────────────────────────────────────

enum CertType {
  LETSENCRYPT  // Automatisch via ACME HTTP-01
  CUSTOM       // Manuell hochgeladen (PEM)
  SELF_SIGNED  // Selbstsigniert (intern generiert)
}

enum CertStatus {
  PENDING   // Ausstellung läuft / noch nicht ausgestellt
  ACTIVE    // Gültig
  EXPIRING  // Läuft in ≤ 30 Tagen ab
  EXPIRED   // Abgelaufen
  ERROR     // Fehler beim Ausstellen / Erneuern
  RENEWING  // Erneuerung läuft
}

model Certificate {
  id          String     @id @default(cuid())
  name        String                          // Anzeigename, z.B. "mail.example.com Wildcard"
  domains     String[]                        // Primäre Domain + SANs
  services    String[]                        // Zugewiesene Services: OWA, ECP, SMTP, IMAP, POP3, EWS, DAV
  type        CertType   @default(LETSENCRYPT)
  status      CertStatus @default(PENDING)
  // PEM-Daten (verschlüsselt im Klartext für internen Einsatz)
  certPem     String?                         // Zertifikat (öffentlich)
  keyPem      String?                         // Privat-Schlüssel
  chainPem    String?                         // CA-Chain
  // Zeitstempel
  issuedAt    DateTime?
  expiresAt   DateTime?
  autoRenew   Boolean    @default(true)
  // Let's Encrypt Account Key (PEM) — pro Server gespeichert
  acmeAccount String?                         // ACME Account Key PEM
  acmeEmail   String?                         // E-Mail für Let's Encrypt Benachrichtigungen
  lastError   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("certificates")
}

// ─── External Mail Contacts (Admin-managed, appear in GAL) ───────────────────
model ExternalMailContact {
  id            String   @id @default(cuid())
  email         String   @unique
  displayName   String
  firstName     String   @default("")
  lastName      String   @default("")
  company       String   @default("")
  department    String   @default("")
  phone         String   @default("")
  mobile        String   @default("")
  hiddenFromGal Boolean  @default(false)
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("external_mail_contacts")
}
