model TransportRule {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  // conditions: [{field: "from"|"to"|"subject"|"body"|"hasAttachment", op: "contains"|"equals"|"regex", value}]
  conditions  Json     @default("[]")
  // actions: [{type: "addHeader"|"removeHeader"|"redirect"|"reject"|"addRecipient"|"setSubjectPrefix", value}]
  actions     Json     @default("[]")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, priority])
  @@map("transport_rules")
}

// ─────────────────────────────────────────────
// Phase 9 — S/MIME Inline Settings
// ─────────────────────────────────────────────

model SmimeSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Automatically sign all outgoing messages
  autoSign       Boolean  @default(false)
  // Automatically encrypt outgoing messages when recipient cert is available
