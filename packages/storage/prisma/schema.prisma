// (Phase 9 Journaling — completely removed in v3.13.6)

// ─────────────────────────────────────────────
// Phase 9 — Retention Policies
// ─────────────────────────────────────────────

enum RetentionAction {
  ARCHIVE        // Move to Archive folder
  DELETE         // Permanently delete
  MOVE_TO_FOLDER // Move to a specified folder
}

enum RetentionScope {
  ALL_ITEMS      // Apply to all mail items
  INBOX          // Only Inbox
  SENT_ITEMS     // Only Sent Items
  DELETED_ITEMS  // Only Deleted Items / Trash
  JUNK           // Only Junk/Spam folder
}

model RetentionPolicy {
  id          String               @id @default(cuid())
  name        String
  description String               @default("")
  enabled     Boolean              @default(true)
  // ── Legacy fields (pre-tags) — new policies keep defaults here and use `tags` exclusively ──
  retentionDays Int                 @default(0)
  action      RetentionAction       @default(ARCHIVE)
  targetFolder String?
  scope       RetentionScope        @default(ALL_ITEMS)
  // ── New (tag model) ──
  policyTags  RetentionPolicyTag[]
  assignments RetentionPolicyAssignment[]
  createdBy   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("retention_policies")
}

// ── Retention Tag — DPT / RPT / Personal ────────────────────────────────────────────
enum RetentionTagType {
  DPT       // Default Policy Tag — applies to all items when nothing more specific matches
  RPT       // Retention Policy Tag — binds to a default folder
  PERSONAL  // Personal Tag — applied manually by the user to items/folders
}

// Which default folder an RPT binds to
enum RetentionFolderTarget {
  INBOX
  SENT_ITEMS
  DELETED_ITEMS
  JUNK_EMAIL
  DRAFTS
  OUTBOX
  RECOVERABLE_ITEMS
  ARCHIVE
  ALL_OTHER  // for DPT binding "all other folders"
}

// The three retention actions
enum RetentionTagAction {
  MOVE_TO_ARCHIVE             // → Archive folder
  DELETE_AND_ALLOW_RECOVERY   // → Recoverable Items\Deletions (soft delete, 14 days)
  PERMANENTLY_DELETE          // → Recoverable Items\Purges (hard delete if no hold)
  MARK_AS_PAST_RETENTION_LIMIT // marking only, no move (for reporting)
}

model RetentionTag {
  id              String                @id @default(cuid())
  name            String                @unique
  description     String                @default("")
  type            RetentionTagType
  action          RetentionTagAction    @default(DELETE_AND_ALLOW_RECOVERY)
  retentionDays   Int                   // days until the action is triggered
  // RPT only: which default folder it is bound to
  folderTarget    RetentionFolderTarget?
  enabled         Boolean               @default(true)
  isSystem        Boolean               @default(false) // built-in (e.g. "Default 2-Year Delete"), not deletable
  policyTags      RetentionPolicyTag[]
  messages        Message[]             @relation("MessageRetentionTag")
  folders         Folder[]              @relation("FolderRetentionTag")
  createdBy       String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([type])
  @@map("retention_tags")
}

// ── M:N — tags in policies ────────────────────────────────────────────────────
model RetentionPolicyTag {
  policy    RetentionPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyId  String
  tag       RetentionTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String
  createdAt DateTime        @default(now())

  @@id([policyId, tagId])
  @@map("retention_policy_tags")
}

// ── Retention worker — run history ──────────────────────────────────────────
model ManagedFolderRun {
  id                 String   @id @default(cuid())
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  // Hard limit per run (work-cycle cap); 0 = unlimited
  workCycleSeconds   Int      @default(0)
  mailboxesScanned   Int      @default(0)
  itemsScanned       Int      @default(0)
  itemsArchived      Int      @default(0)
  itemsSoftDeleted   Int      @default(0)  // → Deletions
  itemsHardDeleted   Int      @default(0)  // → Purges / deleted
  itemsSkippedHold   Int      @default(0)
  throttled          Boolean  @default(false)
  errorMessage       String?

  @@index([startedAt])
  @@map("managed_folder_runs")
}

enum RetentionAssignmentTarget {
  USER           // Assigned to a specific user mailbox
  DOMAIN         // Assigned to all users of a domain
  GLOBAL         // Applies to all mailboxes in the org
}

model RetentionPolicyAssignment {
  id         String                   @id @default(cuid())
  policy     RetentionPolicy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyId   String
  target     RetentionAssignmentTarget @default(GLOBAL)
  // userId or domainId, empty string for GLOBAL
  targetId   String                   @default("")
  createdAt  DateTime                 @default(now())

  @@unique([policyId, target, targetId])
  @@index([policyId])
  @@map("retention_policy_assignments")
}

// ─────────────────────────────────────────────
// Phase 10 — Audit Log
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  // Actor — null means system action
  actorId    String?
  actorEmail String?
  // Action string: "mailbox.create", "user.delete", "auth.login", "rule.update", etc.
  action     String
  // Target resource
  targetType String?  // "user" | "domain" | "mailbox" | "rule" | "session" | ...
  targetId   String?
  targetName String?
  // Request context
  ipAddress  String?
  userAgent  String?
  // Optional before/after diff (JSON)
  changes    Json?
  // Outcome
  success    Boolean  @default(true)
  errorMsg   String?

  @@index([timestamp])
  @@index([actorId, timestamp])
  @@index([action, timestamp])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Security Attack Events (MITRE ATT&CK Logging)
// ─────────────────────────────────────────────

// Attack event log — persists security incidents for the admin dashboard
// + historical analysis. Populated by the SMTP IP limiter, security filter, etc.
model AttackEvent {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  // Attack type: AUTH_BRUTE_FORCE | IP_RATE_LIMIT | DNSBL_HIT | VIRUS | SPAM | DMARC_FAIL | RELAY_ATTEMPT
  type      String
  // Source IP of the attacker
  ip        String
  // Optional target user / e-mail address
  target    String?
  // Additional details (JSON: count, zone, score, etc.)
  detail    Json?
  // Service that detected the attack
  service   String   @default("smtp")
  // 10.5: login surface / protocol (smtp, imap, pop3, web, jmap, caldav, activesync,
  // mapi, autodiscover, mcp, http) — null for events written before 10.5 (use `service`).
  protocol  String?

  @@index([timestamp])
  @@index([ip, timestamp])
  @@index([type, timestamp])
  @@index([protocol, timestamp])
  @@map("attack_events")
}

// ─────────────────────────────────────────────
// 10.5 — Attack protection (BCP → Schutz → Angriffsschutz, docs/attack-protection.md)
// ─────────────────────────────────────────────

enum IpAccessKind {
  BLOCK // refused on every protocol at connect (SMTP/IMAP/POP3 raw socket, HTTP gateway)
  ALLOW // never locked: exempt from the per-IP lockout counter, wins over BLOCK
}

// Permanent IP block list and exceptions. Matched as CIDR; cached in every
// service (60 s TTL + CHANNEL_SETTINGS_RELOAD {type:'ip-access'}).
model IpAccessRule {
  id        String       @id @default(cuid())
  kind      IpAccessKind
  // Normalised CIDR (network address/prefix), e.g. 203.0.113.0/24, 2001:db8::/48
  cidr      String
  note      String       @default("")
  // true = added automatically (repeat offender: locked N times within 7 days)
  auto      Boolean      @default(false)
  // null = permanent; expired rules are ignored and purged
  expiresAt DateTime?
  // E-mail of the admin who added it; null for automatic entries
  createdBy String?
  createdAt DateTime     @default(now())

  @@unique([kind, cidr])
  @@index([kind])
  @@map("ip_access_rules")
}

// Singleton (id "singleton"): notifications + repeat-offender escalation.
model AttackProtectionSettings {
  id                    String   @id @default("singleton")
  // Mail to the admin address when IPs/accounts are locked (aggregated, max one per 15 min)
  notifyEnabled         Boolean  @default(true)
  // Recipient; empty = ServerSettings.adminEmail, else the Organization Management admins
  notifyRecipient       String   @default("")
  // Failed logins (all protocols) per 15 min that trigger a notice; 0 = off
  failureAlertThreshold Int      @default(200)
  // Repeat offenders: an IP locked autoBlockThreshold times within 7 days → block list
  autoBlockEnabled      Boolean  @default(true)
  autoBlockThreshold    Int      @default(3)
  // Lifetime of an automatic block list entry in days; 0 = permanent
  autoBlockDays         Int      @default(30)
  updatedAt             DateTime @updatedAt

  @@map("attack_protection_settings")
}

// ─────────────────────────────────────────────
// Phase 10 — VAPID Push Subscriptions
// ─────────────────────────────────────────────

// v5.7.1: JMAP PushSubscription (RFC 8620 §7.2) — separate from the
// MWA VAPID table because JMAP needs deviceClientId/verificationCode/expires/types.
// Not bound to an account, belongs to the authenticated user.
model JmapPushSubscription {
  id               String    @id @default(cuid())
  userId           String
  deviceClientId   String
  url              String
  keysP256dh       String?
  keysAuth         String?
  verificationCode String?
  verified         Boolean   @default(false)
  expires          DateTime?
  types            String[]  // empty = all types
  createdAt        DateTime  @default(now())

  @@unique([userId, deviceClientId])
  @@index([userId])
  @@map("jmap_push_subscriptions")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Web Push endpoint URL (browser-specific)
  endpoint  String   @unique
  // ECDH keys for payload encryption
  p256dhKey String
  authKey   String
  userAgent String?
  // Topics the client is subscribed to
  topics    String[] // e.g. ["mail.new", "calendar.reminder"]
  // 9.4: new-mail notifications show sender + subject (opt-in per device; default: generic text)
  showPreview Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// v5.6.0: OAuth2 / Modern Auth completely removed.
// Models OAuthClient, OAuthConsent, OAuthAuthorizationCode, OAuthToken
// were deleted in v5.6.0. Tables are dropped via `prisma db push
// --accept-data-loss` on container start.
//
// MFA bypass for mail clients: app passwords (AppPassword model)
// — works with IMAP, SMTP, POP3.

// ── SMTP server settings (singleton) ────────────────────────────────────
model SmtpSettings {
  id                   String   @id @default("singleton")

  // ESMTP extensions (disabled = not advertised)
  extStarttls          Boolean  @default(true)
  extAuthPlain         Boolean  @default(true)
  extAuthLogin         Boolean  @default(true)
  extAuthCramMd5       Boolean  @default(false)
  extPipelining        Boolean  @default(true)
  extSize              Boolean  @default(true)
  ext8bitmime          Boolean  @default(true)
  extEnhancedStatus    Boolean  @default(true)
  extSmtputf8          Boolean  @default(false)
  extDsn               Boolean  @default(true)
  extChunking          Boolean  @default(false)

  // Local delivery
  localDeliveryEnabled Boolean  @default(true)

  // SMTP banner
  bannerOverride       Boolean  @default(false)
  bannerText           String   @default("")

  // Relaying
  relayingEnabled      Boolean  @default(false)
  relayDomains         Json     @default("[]")
  relayRequireAuth     Boolean  @default(true)
  relayTrustedIps      Json     @default("[]")

  // Greylisting (SMTP level)
  greylistingEnabled   Boolean  @default(true)
  greylistWaitSec      Int      @default(300)
  greylistTtlHours     Int      @default(4)
  greylistWhitelist    Json     @default("[]")

  // Connection settings
  maxConnections       Int      @default(100)
  maxConnectionsPerIp  Int      @default(10)
  maxMessageSizeMb     Int      @default(25)
  maxRecipients        Int      @default(100)
  connectionTimeoutSec Int      @default(300)
  greetingDelaySec     Int      @default(0)
  maxAuthFailures      Int      @default(5)

  // Outbound delivery
  // outboundMode: "mx" = direct MX delivery (default) | "smarthost" = relay via a fixed host
  outboundMode         String   @default("mx")
  smarthostHost        String   @default("")
  smarthostPort        Int      @default(587)
  smarthostTls         Boolean  @default(true)   // STARTTLS (opportunistic)
  smarthostImplicitTls Boolean  @default(false)  // Implicit TLS (port 465 style)
  smarthostUsername    String   @default("")
  smarthostPassword    String   @default("")     // plaintext — stored locally in the DB only

  // Spam/virus filter before outbound delivery (rspamd + ClamAV)
  outboundFilterEnabled Boolean @default(true)

  updatedAt            DateTime @updatedAt

  @@map("smtp_settings")
}

// ── Security settings (singleton) ─────────────────────────────────────
model SecuritySettings {
  id                    String   @id @default("singleton")
  // Greylisting
  greylistEnabled       Boolean  @default(true)
  greylistWaitSec       Int      @default(300)
  greylistTtlHours      Int      @default(4)
  // DNSBL
  dnsblEnabled          Boolean  @default(true)
  dnsblZones            Json     @default("[\"zen.spamhaus.org\",\"bl.spamcop.net\"]")
  // GeoIP country filter
  geoipMode             String   @default("DISABLED")
  geoipCountries        Json     @default("[]")
  // Attachment filter
  attachmentEnabled     Boolean  @default(true)
  attachmentMaxSizeMb   Int      @default(50)
  attachmentBlockedExt  Json     @default("[\"exe\",\"vbs\",\"js\",\"bat\",\"cmd\",\"scr\",\"pif\",\"msi\",\"hta\",\"com\"]")
  // Rspamd — basic settings
  rspamdEnabled              Boolean  @default(true)
  rspamdGreylistScore        Float    @default(4.0)
  rspamdSpamScore            Float    @default(6.0)
  rspamdRejectScore          Float    @default(15.0)
  // Rspamd — Autolearn
  rspamdAutolearn            Boolean  @default(true)
  rspamdAutolearnSpam        Float    @default(12.0)
  rspamdAutolearnHam         Float    @default(-0.5)
  // Rspamd — e-mail headers
  rspamdAddSpamHeader        Boolean  @default(true)
  rspamdExtendedHeaders      Boolean  @default(true)
  rspamdRewriteSubject       Boolean  @default(false)
  rspamdSubjectTag           String   @default("[SPAM]")
  // Rspamd — modules
  rspamdPhishingEnabled      Boolean  @default(true)
  rspamdFuzzyEnabled         Boolean  @default(true)
  rspamdUrlEnabled           Boolean  @default(true)
  rspamdMxCheckEnabled       Boolean  @default(true)
  // ClamAV — basic settings
  clamavEnabled              Boolean  @default(true)
  clamavAction               String   @default("quarantine")  // quarantine | reject | pass
  clamavBlockOnFailure       Boolean  @default(false)
  // ClamAV — scan options
  clamavScanArchives         Boolean  @default(true)
  clamavScanHtml             Boolean  @default(true)
  clamavBlockEncryptedArch   Boolean  @default(false)
  clamavMaxFileSizeMb        Int      @default(25)
  clamavMaxScanSizeMb        Int      @default(100)
  // The five scan options above are clamd engine limits (clamd.conf in the
  // clamav container). CoreMail cannot apply them; they are kept for
  // compatibility only — see docs/antivirus.md for the clamd.conf settings.
  // ClamAV — CoreMail-side policy (9.2, honoured by security-filter)
  clamavTimeoutSec           Int      @default(20)       // 5..25 s, below the SMTP→filter timeout (30 s)
  clamavScanLimitMb          Int      @default(50)       // 1..50 MB; larger messages are not sent to clamd
  clamavOversizeAction       String   @default("accept") // accept (delivered, tagged) | reject
  clamavHeuristicsAsVirus    Boolean  @default(true)     // Heuristics.* findings count as a virus
  clamavPuaAsVirus           Boolean  @default(true)     // PUA.* findings count as a virus
  clamavEncryptedAsVirus     Boolean  @default(true)     // Heuristics.Encrypted.* findings count as a virus
  // Local-domain anti-spoofing (9.4, BCP → Protection → Spoofing). The environment
  // variables LOCAL_SPOOF_ACTION / LOCAL_SPOOF_ALLOW / ARC_TRUSTED_SEALERS override
  // these columns when set (docs/mail-security.md).
  localSpoofAction           String   @default("policy") // policy | junk | reject
  localSpoofAllow            Json     @default("[]")     // IPs / CIDRs / domains
  arcTrustedSealers          Json     @default("[]")     // ARC sealer domains
  updatedAt                  DateTime @updatedAt

  @@map("security_settings")
}

// ── Queue settings (singleton) ──────────────────────────────────────────
model QueueSettings {
  id                      String   @id @default("singleton")
  // Retry behavior
  maxRetryAttempts        Int      @default(10)
  retryBackoffDelaySec    Int      @default(60)
  // Retention periods
  deadLetterRetentionDays Int      @default(7)
  outboundRetentionHours  Int      @default(48)
  completedRetentionHours Int      @default(24)
  // Automatic cleanup
  autoFlushDead           Boolean  @default(false)
  // Notifications
  notifyOnDeadLetter      Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  @@map("queue_settings")
}

// ─────────────────────────────────────────────
// DNSBL — configurable per zone (instead of a string array)
// ─────────────────────────────────────────────

enum DnsblAction {
  REJECT       // reject directly (550)
  TAG          // let the mail through but mark as spam / increase score
  SCORE_ONLY   // rspamd score only, no action of its own
}

// DNS hostname (e.g. zen.spamhaus.org) as unique; further fields per zone
model DnsblZone {
  id           String      @id @default(cuid())
  host         String      @unique
  name         String
  description  String?
  enabled      Boolean     @default(true)
  action       DnsblAction @default(REJECT)
  // Score weight (0–100) for rspamd integration
  weight       Int         @default(5)
  // true = DNSWL (whitelist); a hit skips further filters
  isWhitelist  Boolean     @default(false)
  sortOrder    Int         @default(0)
  // Built-in preset (not deletable, can only be disabled)
  isBuiltin    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  hits         DnsblHit[]

  @@index([enabled])
  @@map("dnsbl_zones")
}

model DnsblHit {
  id        String    @id @default(cuid())
  zone      DnsblZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  zoneId    String
  ip        String
  hitAt     DateTime  @default(now())
  // Response code of the DNSBL server (e.g. 127.0.0.2)
  response  String?

  @@index([zoneId, hitAt])
  @@index([ip])
  @@index([hitAt])
  @@map("dnsbl_hits")
}

// ── Server settings (singleton) ─────────────────────────────────────────
// Stores public URLs for Autodiscover, webmail, EAS, IMAP, SMTP.
// Desktop clients read these automatically via Autodiscover.
model ServerSettings {
  id              String   @id @default("singleton")
  // Public hostname (for Autodiscover + TLS certificate)
  publicHostname  String   @default("mail.local")
  // Protocol: http or https
  useHttps        Boolean  @default(false)
  // HTTP port (external, e.g. 8080 on Synology or 443 behind a reverse proxy)
  httpPort        Int      @default(8080)
  // Mail Web Access (MWA)
  owaUrl          String   @default("http://mail.local:8080/owa/")
  // ActiveSync (Mobile)
  easUrl          String   @default("http://mail.local:8080/Microsoft-Server-ActiveSync")
  // Autodiscover base URL
  autodiscoverBase String  @default("http://mail.local:8080")
  // Integrated HTTPS proxy (tls-proxy.ts): also accept TLS 1.0/1.1 with the
  // vetted legacy cipher list (@coremail/core tlsProtocolOptions). Default off.
  httpsAllowLegacyTls Boolean @default(false)
  // IMAP
  imapHost        String   @default("mail.local")
  imapPort        Int      @default(993)
  imapSsl         Boolean  @default(true)
  // POP3
  pop3Host        String   @default("mail.local")
  pop3Port        Int      @default(995)
  pop3Ssl         Boolean  @default(true)
  // SMTP Submission
  smtpHost        String   @default("mail.local")
  smtpPort        Int      @default(587)
  smtpTls         Boolean  @default(true)
  // ── Organization ─────────────────────────────────────────────────────────
  orgName         String   @default("CoreMail")
  orgDescription  String   @default("")
  adminEmail      String   @default("")
  language        String   @default("de")
  timezone        String   @default("Europe/Berlin")
  welcomeMessage  String   @default("")
  logoUrl         String   @default("")

  // ── Mail limits ──────────────────────────────────────────────────────────
  maxMessageSizeMb    Int  @default(25)
  maxAttachmentSizeMb Int  @default(25)
  trashRetentionDays  Int  @default(30)

  // ── Security policies ────────────────────────────────────────────────
  minPasswordLength          Int     @default(8)
  maxLoginAttempts           Int     @default(5)
  sessionTimeoutMinutes      Int     @default(480)
  // 0 = disabled; > 0 = minutes until automatic logout on browser inactivity
  inactivityTimeoutMinutes   Int     @default(30)
  // false for existing installations (no silent lock-out); 10.5: the setup
  // wizard (POST /setup/complete) sets it true for fresh installations.
  requireMfaForAdmins        Boolean @default(false)
  // 10.5: "MFA für alle Benutzer erzwingen" (src/auth/mfa-enforcement.ts):
  // a user without a second factor must enrol after the grace period
  // (days from the user's first check after activation); until then the
  // webmail shows a banner. mfaEnforcementSince = when it was switched on
  // (written by the settings route). mfaEnforcementBlocksPrimaryPassword:
  // after the grace period the primary password no longer works on mail
  // protocols for such users (app passwords keep working).
  requireMfaForAllUsers               Boolean   @default(false)
  mfaEnforcementGraceDays             Int       @default(7)
  mfaEnforcementSince                 DateTime?
  mfaEnforcementBlocksPrimaryPassword Boolean   @default(false)
  // v3.18.30: audit log globally on/off. Default on. The toggle itself is audited.
  auditLogEnabled            Boolean @default(true)
  // 9.4: mailbox access audit (delegates / shared mailbox users; action prefix
  // mailbox.foreign.*) — on/off and retention in days of these entries (purged by
  // the api-gateway mailbox-access purger; other audit entries are never purged)
  mailboxAccessAuditEnabled       Boolean @default(true)
  mailboxAccessAuditRetentionDays Int     @default(180)
  allowSelfRegistration      Boolean @default(false)
  // Allows users to reset their own password via an e-mail link
  selfServicePasswordReset   Boolean @default(true)
  // 9.4: API rate limit of the api-gateway (fixed window). Signed-in requests count
  // per user, anonymous ones per client IP; static assets and the live-event stream
  // are exempt. API_RATE_LIMIT_* environment variables override these columns.
  apiRateLimitEnabled        Boolean @default(true)
  apiRateLimitWindowMin      Int     @default(15)
  apiRateLimitPerIp          Int     @default(500)
  apiRateLimitPerUser        Int     @default(3000)
  // 10.5: per-user outgoing message rate for EVERY submission path (SMTP 587/465,
  // webmail/REST, ActiveSync, JMAP, MAPI; storage submission-rate.ts): messages
  // and recipients per sliding hour. A MailFlowPolicy value replaces the numbers
  // per mailbox. sendRateBlockOnExceed: an account that reaches the limit may
  // not send at all for one hour (default off).
  sendRateLimitEnabled       Boolean @default(true)
  sendRateMessagesPerHour    Int     @default(200)
  sendRateRecipientsPerHour  Int     @default(1000)
  sendRateBlockOnExceed      Boolean @default(false)

  // ── Protocols ────────────────────────────────────────────────────────────
  // v5.7.1: JMAP (RFC 8620/8621 + extensions) on /jmap/* and
  // /.well-known/jmap. Default ON; off → 404. Hot reload via
  // Redis CHANNEL_SETTINGS_RELOAD (no container restart).
  // 9.4: the server level of the JMAP protocol switch (ProtocolPolicy). Off →
  // JMAP is refused unless a domain/user switch turns it on; the service answers
  // 404 only while no switch anywhere turns JMAP on.
  jmapEnabled        Boolean @default(true)

  // 10.3: admin MCP interface (/mcp, docs/mcp.md). Default OFF; off → /mcp
  // answers 404 and open MCP sessions end (CHANNEL_SETTINGS_RELOAD {type:'mcp'}).
  // mcpAllowedIps: client IPs / CIDR ranges allowed to reach /mcp (empty = all).
  mcpEnabled         Boolean  @default(false)
  mcpAllowedIps      String[] @default([])

  // ── 10.6: passkeys (docs/passkeys.md, src/auth/passkey-policy.ts) ──
  // passkeysEnabled: server level of the passkey switch (domain / user
  // PasskeyPolicy rows override it). Default OFF on fresh and existing installs.
  // passkeyPasswordlessEnabled: passkeys may also be used for the usernameless
  // sign-in (off = only as second factor / re-authentication).
  // passkeyRpId: the WebAuthn RP ID, frozen at the first passkey registration
  // (null = not frozen yet → the public host name). WEBAUTHN_RP_ID overrides it.
  // passkeyRelatedOrigins: further allowed origins (https://…), also announced
  // in /.well-known/webauthn (Related Origin Requests, WebAuthn L3 §5.11).
  passkeysEnabled            Boolean  @default(false)
  passkeyPasswordlessEnabled Boolean  @default(true)
  passkeyRpId                String?
  passkeyRelatedOrigins      String[] @default([])

  // ── v9.0: mailbox quota defaults (ratios 1.9 / 2.0 / 2.3 GB) ──
  // Percent of the mailbox quota (= ProhibitSendReceiveQuota) at which the
  // warning mail is sent / sending is refused, when the mailbox sets no own level.
  quotaWarningPercent      Int    @default(83)
  quotaProhibitSendPercent Int    @default(87)

  // ── Maintenance ───────────────────────────────────────────────────────────────
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String  @default("Der Server befindet sich derzeit in Wartung. Bitte versuchen Sie es später erneut.")

  // ── TLS certificate (SMTP/IMAP/POP3 implicit TLS: ports 465, 993, 995) ──────
  // Generated automatically as a self-signed certificate on first start.
  // Can be replaced with an official Let's Encrypt certificate via the admin panel.
  tlsCert  String?  // PEM-encoded certificate
  tlsKey   String?  // PEM private key, encrypted at rest (enc:v1, storage private-key-crypto.ts)

  // ── v6: one-time setup wizard ────────────────────────────────────────────────
  // setupCompletedAt is set exactly once (atomic claim in POST /setup/complete)
  // and never cleared — deleting all users does NOT reopen the setup.
  // setupTokenHash: sha256 (hex) of the one-time setup token printed to the
  // api-gateway log at first start (or SETUP_TOKEN env); cleared on completion.
  setupCompletedAt DateTime?
  setupTokenHash   String?
  // 10.4.2: set when the setup wizard reached its summary (POST /setup/finish);
  // closes the secrets download (GET /setup/secrets-download, open only while
  // this is null and at most 24 h after setupCompletedAt). Backfilled
  // installations get it together with setupCompletedAt.
  setupWizardFinishedAt DateTime?

  // 10.4: certificate step of the setup wizard ("letsencrypt" | "proxy" | "later").
  // UNUSED since 10.4.2 (the wizard has no certificate step any more); kept
  // because schema changes stay additive.
  setupCertificateChoice          String?
  // 10.4.2: "Später" on the BCP dashboard card "Zertifikat einrichten" (shown
  // while no trusted certificate covers the public host name). Before 10.4.2 it
  // hid the wizard's "certificate later" hint — same meaning, so it is reused.
  setupCertificateHintDismissedAt DateTime?

  // v5.6.0: jwtPrivateKey/jwtPublicKey/jwtKeyId/jwtKeyCreated removed
  // (RS256 keys were for OAuth2/OIDC — completely out of the stack).
  // JWT back to HS256 + JWT_SECRET env variable.

  updatedAt       DateTime @updatedAt

  @@map("server_settings")
}

// ── Branding (9.3) ─────────────────────────────────────────────────────────────
// Global singleton (id "singleton"): product name, colours, logos, login page.
// NULL productName / primaryColor = environment default (BRANDING_NAME /
// BRANDING_COLOR, else "CoreMail" / #0078d4). Asset keys point to the object
// store (`branding/<sha256>.<ext>`, content-addressed); the content type is kept
// next to the key. `version` increments on every change (cache busting of the
// served index.html and the public GET /api/v1/branding).
model Branding {
  id                  String   @id @default("singleton")
  version             Int      @default(1)
  productName         String?
  primaryColor        String?
  headerColor         String?
  logoLightKey        String?
  logoLightType       String?
  logoDarkKey         String?
  logoDarkType        String?
  faviconKey          String?
  faviconType         String?
  loginBackgroundKey  String?
  loginBackgroundType String?
  loginText           String   @default("")
  // [{ label, url }] — max 5, https:// or mailto: only
  footerLinks         Json     @default("[]")
  allowUserAccent     Boolean  @default(true)
  showPoweredBy       Boolean  @default(true)
  // 10.1: webmail background for users without an own choice: "none" or "builtin:<id>"
  defaultBackground   String   @default("none")
  updatedAt           DateTime @updatedAt

  @@map("branding")
}

// ── Service listeners ──────────────────────────────────────────────────────────
// Configurable listeners per protocol service (SMTP / IMAP / POP3)
// Shows which addresses + ports a service listens on, whether TLS is active, etc.

enum ServiceType {
  SMTP_RECEIVE
  SMTP_SEND
  IMAP
  POP3
}

model ServiceListener {
  id        String      @id @default(cuid())
  service   ServiceType
  address   String      @default("0.0.0.0")
  port      Int
  ssl       Boolean     @default(false)
  active    Boolean     @default(true)
  // Accept TLS 1.0/1.1 (vetted legacy cipher list) on this listener — for old
  // mail clients only. Default off: TLS 1.2+.
  allowLegacyTls Boolean @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("service_listeners")
}

// ── Device SMTP relay (singleton) ─────────────────────────────────────────────
// Unauthenticated relay for internal devices (scanners, printers, monitoring)
// ONLY from `allowedNetworks` (CIDR) on listener port `port`, ONLY for MAIL FROM
// / From: domains in `senderDomains`, at most `maxMessagesPerMinute` per source
// IP. Active only when enabled AND both lists are non-empty. The legacy
// SmtpSettings.relaying* fields are never evaluated (stale data must not open a
// relay on upgrade).
model DeviceRelaySettings {
  id                   String   @id @default("singleton")
  enabled              Boolean  @default(false)
  allowedNetworks      String[]
  senderDomains        String[]
  port                 Int      @default(25)
  maxMessagesPerMinute Int      @default(30)
  updatedAt            DateTime @updatedAt

  @@map("device_relay_settings")
}

// ── Mail connectors (send / receive connectors) ─────────────────────────────

enum ConnectorType {
  SEND      // Outbound connections to relay/smarthost
  RECEIVE   // Inbound connections (accepted sources)
}

model MailConnector {
  id               String        @id @default(cuid())
  name             String
  description      String        @default("")
  type             ConnectorType
  enabled          Boolean       @default(true)
  // SEND: target SMTP host / RECEIVE: source addresses (CIDR)
  host             String        @default("")
  port             Int           @default(25)
  tls              Boolean       @default(false)
  requireTls       Boolean       @default(false)
  // RECEIVE: allowed source IPs/ranges (CIDR, empty = all)
  sourceIps        String[]
  // SEND: which domains this connector applies to (empty = fallback for all)
  targetDomains    String[]
  // Auth credentials for SEND
  username         String?
  password         String?       // plaintext internally (should be vault-secured)
  // Priority (lower value = higher priority)
  priority         Int           @default(0)
  createdBy        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([type, enabled])
  @@map("mail_connectors")
}

// ── Organization & sharing policies ────────────────────────────────────────

model SharingPolicy {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  enabled     Boolean  @default(true)
  // Domains allowed to receive calendar/contact shares
  // Empty = all external domains allowed
  allowedDomains String[]
  // What may be shared
  allowCalendar  Boolean @default(true)
  allowContacts  Boolean @default(false)
  // FreeBusy vs. full calendar details
  calendarDetail String  @default("FREEBUSY") // FREEBUSY | LIMITED | FULL
  isDefault      Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sharing_policies")
}

model AddressList {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  // LDAP-like filter: {type: "all"|"users"|"groups", domainId?, department?}
  filter      Json     @default("{}")
  isGal       Boolean  @default(false) // Global address list
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("address_lists")
}

// ── SSL/TLS certificate management ─────────────────────────────────────────────

enum CertType {
  LETSENCRYPT  // Automatic via ACME HTTP-01
  CUSTOM       // Manually uploaded (PEM)
  SELF_SIGNED  // Self-signed (generated internally)
}

enum CertStatus {
  PENDING   // issuance in progress / not issued yet
  ACTIVE    // valid
  EXPIRING  // expires in ≤ 30 days
  EXPIRED   // expired
  ERROR     // error during issuance / renewal
  RENEWING  // renewal in progress
}

model Certificate {
  id          String     @id @default(cuid())
  name        String                          // display name, e.g. "mail.example.com Wildcard"
  domains     String[]                        // primary domain + SANs
  services    String[]                        // assigned services: OWA (webmail), ECP (BCP), SMTP, IMAP, POP3, DAV — stored keys
  type        CertType   @default(LETSENCRYPT)
  status      CertStatus @default(PENDING)
  // PEM data (stored in plaintext for internal use)
  certPem     String?                         // certificate (public)
  keyPem      String?                         // PEM private key, encrypted at rest (enc:v1, storage private-key-crypto.ts)
  chainPem    String?                         // CA chain
  // Timestamps
  issuedAt    DateTime?
  expiresAt   DateTime?
  autoRenew      Boolean    @default(true)
  // Integrated HTTPS reverse proxy (only one certificate active at a time)
  isActiveHttps    Boolean    @default(false)
  // Protocol TLS: SMTP / IMAP / POP3 read from ServerSettings.tlsCert/tlsKey.
  // isActiveProtocol marks which certificate is currently stored there (only one).
  isActiveProtocol Boolean    @default(false)
  // Let's Encrypt account key (PEM) — stored per server
  acmeAccount String?                         // ACME account key PEM, encrypted at rest (enc:v1, storage private-key-crypto.ts)
  acmeEmail   String?                         // e-mail for Let's Encrypt notifications
  // 9.2.x: Let's Encrypt staging environment (test, untrusted) — kept for retries / renewals
  acmeStaging Boolean    @default(false)
  lastError   String?
  // 9.2.x: classified failure (connection, dns, caa, rate-limited, timeout, …) — lib/acme-errors.ts
  lastErrorCode String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("certificates")
}

// (ExternalMailContact — completely removed in v3.18.33. External recipients
// are entered directly as an address in the compose window.)
