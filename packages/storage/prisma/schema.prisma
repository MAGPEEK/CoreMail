generator client {
  provider        = "prisma-client-js"
  // 10.2: postgresqlExtensions — the pg_trgm extension below is part of the schema
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
  // Explicitly OpenSSL 3 target only — omit "native" because auto-detection fails on Alpine
  binaryTargets   = ["linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // 10.2: pg_trgm (trigram GIN index of the mail search, Message @@index
  // messages_search_trgm_idx; docs/search.md). The lines carrying the optional tag
  // of schema-sync (infra/docker/schema-sync-classify.mjs) are left out when the
  // database cannot provide the extension (role without CREATE on the database) —
  // the search then works without the index. Prisma never drops extensions that
  // are not listed here.
  extensions = [pg_trgm] // schema-sync:optional pg_trgm
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  USER
  HELP_DESK
  RECIPIENT_MANAGEMENT
  COMPLIANCE_MANAGEMENT
  HYGIENE_MANAGEMENT
  SERVER_MANAGEMENT
  VIEW_ONLY_ORG
  ORGANIZATION_MANAGEMENT
}

enum SharedMailboxPermType {
  FULL_ACCESS
  SEND_AS
  SEND_ON_BEHALF
  READ_ONLY
}

enum LogLevel {
  ERROR
  WARN
  INFO
  DEBUG
}

enum JobStatus {
  PENDING
  PROCESSING
  // v3.18.26 — extended for backup job lifecycle (RTO/RPO tracking)
  SCHEDULED        // waiting for the next cron tick
  RUNNING          // currently processing (synonym for PROCESSING, clearer name)
  RETRYING         // retry in progress after a failure
  COMPLETED
  FAILED
  ABORTED          // manually aborted by the user
  EXPIRED          // snapshot was deleted by retention
}

enum AuthSource {
  LOCAL
  LDAP
  OIDC
}

// v5.6.1: enum GroupType removed (DistributionGroup feature deleted)

// ─────────────────────────────────────────────
// Domains & Users
// ─────────────────────────────────────────────

model Domain {
  id                 String               @id @default(cuid())
  name               String               @unique
  dkimPrivateKey     String
  dkimSelector       String               @default("coremail")
  active             Boolean              @default(true)
  primary            Boolean              @default(false)
  users              User[]
  sharedMailboxes    SharedMailbox[]
  ldapConfig         LdapConfig?
  oidcProviders      OidcProvider[]
  // v5.6.1: distributionGroups relation removed
  aliases            EmailAlias[]
  // 9.4: per-protocol access switches of the domain (none = everything inherited)
  protocolPolicy     ProtocolPolicy?
  // 9.4: webmail feature switches + attachment/content policy of the domain
  webmailPolicy      WebmailPolicy?
  // 9.5: admin role assignments limited to this domain (AdminScope)
  adminScopes        AdminScope[]
  // 10.6: passkey switch of the domain (none = inherited from the server)
  passkeyPolicy      PasskeyPolicy?
  createdAt          DateTime             @default(now())

  @@map("domains")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  displayName     String
  passwordHash    String?
  authSource      AuthSource     @default(LOCAL)
  externalId      String?        // LDAP objectGUID or OIDC sub
  // v9.0: OIDC binding (`oidc:<providerId>:<sub>`) of a LOCAL/LDAP account linked
  // via SSO (OidcProvider.allowLinking). OIDC-only accounts keep it in externalId.
  oidcSubject     String?
  role            UserRole       @default(USER)
  quotaBytes      BigInt         @default(5368709120)
  usedBytes       BigInt         @default(0)
  // v9.0: quota levels. quotaBytes = ProhibitSendReceiveQuota;
  // null = server default (ServerSettings.quota*Percent of quotaBytes).
  quotaWarningBytes      BigInt?
  quotaProhibitSendBytes BigInt?
  // Last quota warning mail (at most one per 24 h).
  quotaWarnedAt          DateTime?
  active          Boolean        @default(true)
  // v6.1: set when the LDAP sync deactivated the account (missing in / disabled
  // in the directory) — only such accounts are re-activated by the sync.
  deactivatedBySync Boolean      @default(false)
  // 8.x: last successful login (web/API, SSO, mail protocols). Written by
  // recordLastLogin() (src/auth/last-login.ts), at most once per user per 5 min.
  lastLoginAt     DateTime?
  // 10.5: start of this user's grace period under "MFA für alle Benutzer
  // erzwingen" (ServerSettings.requireMfaForAllUsers). Set on the first check
  // after the enforcement was switched on; a value older than
  // ServerSettings.mfaEnforcementSince is stale (re-activation starts a new
  // grace period). src/auth/mfa-enforcement.ts.
  mfaGraceStartedAt DateTime?
  domain          Domain         @relation(fields: [domainId], references: [id])
  domainId        String
  mailbox         Mailbox?
  calendars       Calendar[]
  contacts        Contact[]
  contactGroups   ContactGroup[]
  sessions        Session[]
  mfa             UserMfa?
  appPasswords    AppPassword[]
  signatures      UserSignature[]
  mailTemplates   MailTemplate[]
  sharedPerms     SharedMailboxPerm[]
  delegatedAccess MailboxDelegate[]    @relation("MailboxDelegateGrantee")
  folderPermissions FolderPermission[] @relation("FolderPermissionGrantee")
  calendarSharesGranted  CalendarShare[] @relation("CalendarShareOwner")
  calendarSharesReceived CalendarShare[] @relation("CalendarShareGrantee")
  activeSyncDevices ActiveSyncDevice[]
  certificates    UserCertificate[]
  smimeSettings   SmimeSettings?
  pushSubscriptions PushSubscription[]
  // v5.6.0: OAuth relations (oauthCodes/Tokens/Consents) removed
  categories          Category[]
  aliases             EmailAlias[]        @relation("UserAliases")
  passwordResetTokens PasswordResetToken[]
  // 9.4: per-protocol access switches of the user (none = everything inherited)
  protocolPolicy      ProtocolPolicy?
  // 9.4: webmail feature switches + attachment/content policy of the user
  webmailPolicy       WebmailPolicy?
  // 9.4: senders whose external images the webmail loads without asking
  trustedImageSenders TrustedImageSender[]
  // 9.4: per-mailbox mail flow (GAL visibility, forwarding, sender lists, limits)
  mailFlowPolicy      MailFlowPolicy?
  // 9.5: management scope of an admin role (none = organisation-wide)
  adminScopes         AdminScope[]
  // 10.3: personal tokens of the admin MCP interface (/mcp)
  mcpTokens           McpToken[]
  // 10.6: passkeys / security keys (WebAuthn), src/auth/webauthn + src/auth/passkeys.ts.
  // webauthnUserId = the stable random WebAuthn user handle (64 bytes, base64url;
  // never personal data), created at the first passkey registration.
  // passwordLoginDisabled = passkey-only account: the web login refuses the
  // password (checked only after it was verified — no oracle); no password
  // reset by mail. Set by an admin (PUT /admin/mailboxes/:id/passkey-policy).
  webauthnUserId        String?                @unique
  passwordLoginDisabled Boolean                @default(false)
  webauthnCredentials   WebAuthnCredential[]
  passkeyRecoveryTokens PasskeyRecoveryToken[]
  passkeyPolicy         PasskeyPolicy?
  // 9.5: profile photo — content-addressed object key (profile-photos/<aa>/<sha256>.jpg,
  // a 512×512 JPEG re-encoded by the api-gateway); null = no photo (initials)
  photoKey            String?
  photoUpdatedAt      DateTime?
  // 10.1: uploaded webmail background — content-addressed object key
  // (backgrounds/<aa>/<sha256>.jpg, a JPEG re-encoded by the api-gateway); null = none
  backgroundKey       String?
  backgroundUpdatedAt DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([domainId])
  @@index([externalId])
  @@map("users")
}

// ─────────────────────────────────────────────
// Admin management scopes (9.5)
// ─────────────────────────────────────────────

// Limits the admin role of a user to domains: one row per (admin, domain). An
// admin without rows manages the whole organisation (backward compatible);
// ORGANIZATION_MANAGEMENT is always organisation-wide (rows are ignored).
// Written only through the api-gateway (organisation role-assignment routes,
// audited, the admin's sessions are revoked). Deleting a domain that still
// scopes an admin is refused (Restrict): a vanished last row would widen the
// admin to the whole organisation.
model AdminScope {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Restrict)
  grantedBy String?
  createdAt DateTime @default(now())

  @@unique([userId, domainId])
  @@index([domainId])
  @@map("admin_scopes")
}

// ─────────────────────────────────────────────
// Admin MCP interface (10.3)
// ─────────────────────────────────────────────

// Personal bearer token of an admin for the MCP endpoint (/mcp, docs/mcp.md).
// Only sha256(token) is stored (`tokenHash`); the token (`cm_mcp_…`) is shown
// once at creation. `prefix` = the first characters for display. `mode` =
// "read" | "write" (read tokens only see read tools). `mfaVerified` = the token
// was created from an MFA-verified session (needed while requireMfaForAdmins is
// on). Every tool runs as the token's admin with its current role and scope.
// Revoked (revokedAt) by the owner, by ORGANIZATION_MANAGEMENT, and by every
// "revoke all sessions" of the owner (role change, deactivation, password
// reset, sign out everywhere — storage auth/sessions.ts revokeAllSessions).
model McpToken {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  tokenHash     String    @unique
  prefix        String
  mode          String    @default("read")
  mfaVerified   Boolean   @default(false)
  expiresAt     DateTime
  lastUsedAt    DateTime?
  lastUsedIp    String?
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?

  @@index([userId])
  @@map("mcp_tokens")
}

// ─────────────────────────────────────────────
// Protocol access (9.4)
// ─────────────────────────────────────────────

// Tri-state switch of one protocol on one level. INHERIT takes the value of the
// next broader level (user → domain → server); on the server level INHERIT means
// the built-in default (src/protocol-access.ts).
enum ProtocolSwitch {
  INHERIT
  ON
  OFF
}

// Per-protocol access switches. One row per level: id 'global' = the server
// level (domainId and userId null), otherwise exactly one of domainId / userId.
// Rows are deleted together with their domain / user. The server level of the
// JMAP switch is ServerSettings.jmapEnabled — the `jmap` column of the 'global'
// row is never written.
model ProtocolPolicy {
  id         String         @id @default(cuid())
  domainId   String?        @unique
  domain     Domain?        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  userId     String?        @unique
  user       User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  imap       ProtocolSwitch @default(INHERIT)
  pop3       ProtocolSwitch @default(INHERIT)
  smtp       ProtocolSwitch @default(INHERIT)
  activesync ProtocolSwitch @default(INHERIT)
  jmap       ProtocolSwitch @default(INHERIT)
  dav        ProtocolSwitch @default(INHERIT)
  webmail    ProtocolSwitch @default(INHERIT)
  mapi       ProtocolSwitch @default(INHERIT)
  updatedAt  DateTime       @updatedAt

  @@map("protocol_policies")
}

// ─────────────────────────────────────────────
// Webmail policies (9.4)
// ─────────────────────────────────────────────

// How the webmail treats external images in mails.
enum ExternalImageMode {
  ASK       // banner, the reader decides (default)
  CONTACTS  // loaded for senders in the reader's contacts / trusted senders, else ask
  BLOCK     // never loaded
}

// Webmail feature switches and attachment/content policy. One row per level:
// id 'global' = the server level, otherwise exactly one of domainId / userId.
// Feature columns: INHERIT takes the broader level (server level: built-in
// default = on). Content columns: NULL = inherit (server level: built-in
// default). Resolution: src/webmail-policy.ts.
model WebmailPolicy {
  id                     String             @id @default(cuid())
  domainId               String?            @unique
  domain                 Domain?            @relation(fields: [domainId], references: [id], onDelete: Cascade)
  userId                 String?            @unique
  user                   User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendar               ProtocolSwitch     @default(INHERIT)
  contacts               ProtocolSwitch     @default(INHERIT)
  tasks                  ProtocolSwitch     @default(INHERIT)
  notes                  ProtocolSwitch     @default(INHERIT)
  rules                  ProtocolSwitch     @default(INHERIT)
  signatures             ProtocolSwitch     @default(INHERIT)
  categories             ProtocolSwitch     @default(INHERIT)
  recoverItems           ProtocolSwitch     @default(INHERIT)
  changePassword         ProtocolSwitch     @default(INHERIT)
  themes                 ProtocolSwitch     @default(INHERIT)
  externalClients        ProtocolSwitch     @default(INHERIT)
  appPasswords           ProtocolSwitch     @default(INHERIT)
  sharedMailboxes        ProtocolSwitch     @default(INHERIT)
  // 9.5: upload / change of the own profile photo
  profilePhoto           ProtocolSwitch     @default(INHERIT)
  // JSON array of file extensions without dot; NULL = inherit
  blockedExtensions      Json?
  downloadOnlyExtensions Json?
  // Max. size of one uploaded attachment in MB; NULL = inherit (server level: no own limit)
  maxUploadMb            Int?
  externalImages         ExternalImageMode?
  updatedAt              DateTime           @updatedAt

  @@map("webmail_policies")
}

// Senders (address, or "@domain") whose external images the webmail loads
// without asking ("Bilder von diesem Absender immer anzeigen").
model TrustedImageSender {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // lower-case address or "@domain"
  sender    String
  createdAt DateTime @default(now())

  @@unique([userId, sender])
  @@map("trusted_image_senders")
}

// ─────────────────────────────────────────────
// Per-mailbox mail flow (9.4)
// ─────────────────────────────────────────────

// Mail flow settings of one user mailbox or Shared Mailbox (exactly one of
// userId / sharedMailboxId). No row = defaults (listed in the address list, no
// forwarding, no sender restriction, the global limits). Enforced through
// @coremail/storage src/mail-flow.ts; see docs/mailbox-management.md.
model MailFlowPolicy {
  id               String         @id @default(cuid())
  userId           String?        @unique
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedMailboxId  String?        @unique
  sharedMailbox    SharedMailbox? @relation(fields: [sharedMailboxId], references: [id], onDelete: Cascade)
  // Not listed in the global address list, autocomplete and directory searches
  hiddenFromGal    Boolean        @default(false)
  // Admin forwarding: every delivered message is also sent to this address
  forwardTo        String?
  // false = forward only (the mailbox keeps no copy)
  forwardKeepCopy  Boolean        @default(true)
  // Lower-case addresses ("a@b.example") or domains ("b.example"); empty = no restriction
  acceptFrom       String[]       @default([])
  rejectFrom       String[]       @default([])
  // null = the global limit
  maxSendSizeMb    Int?
  maxReceiveSizeMb Int?
  maxRecipients    Int?
  // 10.5: per-user outgoing rate (storage submission-rate.ts): messages /
  // recipients per sliding hour; null = the global ServerSettings value.
  // User mailboxes only (send as a Shared Mailbox counts against the user).
  maxMessagesPerHour   Int?
  maxRecipientsPerHour Int?
  updatedAt        DateTime       @updatedAt

  @@map("mail_flow_policies")
}

// ─────────────────────────────────────────────
// Authentication
// ─────────────────────────────────────────────

// Password reset token (self-service)
// - Token is stored as a SHA-256 hash (never in plaintext)
// - Expires after 15 minutes (configurable via ServerSettings)
// - Single use (usedAt is set on redemption)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique  // SHA-256(token) — plaintext token only sent by e-mail
  expiresAt DateTime
  usedAt    DateTime?           // null = not redeemed yet
  ipAddress String    @default("")
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Session {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  /// v7.0.0: sha256(refreshToken) hex — rotated on every /auth/refresh.
  /// Rows written before v7.0.0 hold the raw refresh JWT; they are accepted
  /// once by raw match and migrated to the hash on that refresh.
  tokenHash   String   @unique
  ipAddress   String
  userAgent   String   @default("")
  mfaVerified Boolean  @default(false)
  /// 10.6: how the session was established: "password" (password, optionally
  /// with a second factor, SSO) or "passkey" (usernameless passkey sign-in with
  /// user verification — counts as MFA, mfaVerified = true).
  authMethod  String   @default("password")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserMfa {
  id                  String  @id @default(cuid())
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String  @unique
  totpSecret          String?
  totpEnabled         Boolean @default(false)
  /// v7.0.0: last accepted TOTP time step (unix/30) — replay protection
  totpLastUsedStep    Int?
  /// DEPRECATED (10.6, removed with the next MAJOR): the pre-10.6 security keys
  /// as a JSON array. Copied once into WebAuthnCredential (kind security_key) by
  /// the startup backfill (src/auth/passkey-migration.ts) — nothing else reads it.
  webAuthnCredentials Json    @default("[]")
  backupCodes         String[]
  backupCodesUsed     Int     @default(0)
  emailOtpEnabled     Boolean @default(false)

  @@map("user_mfa")
}

model AppPassword {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  hash        String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("app_passwords")
}

// ─────────────────────────────────────────────
// Passkeys / security keys (10.6) — docs/passkeys.md
// ─────────────────────────────────────────────

// One WebAuthn credential (W3C WebAuthn Level 3). kind "passkey" = registered
// through /auth/passkeys (discoverable, user verification required — usable for
// the usernameless sign-in, re-authentication and as a second factor);
// "security_key" = second factor only (/auth/mfa/webauthn/* and credentials
// migrated from UserMfa.webAuthnCredentials; userHandle null).
// credentialId = base64url of the raw credential id (≤ 1023 bytes, unique across
// all users, §7.1 steps 25/26). publicKey = COSE key bytes; algorithm = COSE alg
// (-8 EdDSA, -7 ES256, -257 RS256). signCount is a BigInt — never serialised raw.
// backupEligible null = unknown (migrated key; adopted at its first use).
// Written only through src/auth/webauthn (ceremonies) and src/auth/passkeys.ts.
model WebAuthnCredential {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId   String    @unique
  publicKey      Bytes
  algorithm      Int
  signCount      BigInt    @default(0)
  transports     String[]  @default([])
  rpId           String
  userHandle     String?
  kind           String    @default("passkey")
  discoverable   Boolean?
  uvInitialized  Boolean   @default(false)
  backupEligible Boolean?
  backupState    Boolean   @default(false)
  aaguid         String?
  attestationFmt String    @default("none")
  name           String
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  lastUsedIp     String?

  @@index([userId])
  @@map("webauthn_credentials")
}

// One-time passkey recovery link issued by an admin (POST
// /admin/mailboxes/:id/passkey-recovery): only sha256(token) is stored, valid
// 24 h, single use (usedAt). Redeeming it registers a new passkey and revokes
// every session of the user. createdById = the issuing admin (no relation).
model PasskeyRecoveryToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("passkey_recovery_tokens")
}

// Passkey switch of a domain or a user (exactly one of domainId / userId):
// INHERIT takes the next broader level (user → domain → server =
// ServerSettings.passkeysEnabled). Resolution: src/auth/passkey-policy.ts.
// TODO(10.6 auth-policy): unify with the per-user MFA policy model once that
// branch is merged.
model PasskeyPolicy {
  id        String         @id @default(cuid())
  domainId  String?        @unique
  domain    Domain?        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  userId    String?        @unique
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  passkeys  ProtocolSwitch @default(INHERIT)
  updatedAt DateTime       @updatedAt

  @@map("passkey_policies")
}

model LdapConfig {
  id           String   @id @default(cuid())
  domain       Domain   @relation(fields: [domainId], references: [id])
  domainId     String   @unique
  host         String
  port         Int      @default(636)
  ssl          Boolean  @default(true)
  baseDN       String
  bindDN       String
  bindPassword String
  userFilter   String   @default("(sAMAccountName={{username}})")
  userDN       String
  groupFilter  String?
  attributeMap Json     @default("{}")
  syncEnabled  Boolean  @default(true)
  lastSyncAt   DateTime?
  // v6.1 — LDAP login + sync (packages/auth-ldap)
  enabled             Boolean  @default(true)  // LDAP login for this domain
  startTls            Boolean  @default(false) // StartTLS on ldap:// (ignored with ssl=true)
  tlsVerify           Boolean  @default(true)  // verify the server certificate (ldaps / StartTLS)
  tlsCaCert           String?                  // optional PEM CA bundle for private CAs
  allowLocalTakeover  Boolean  @default(false) // explicit opt-in: a LOCAL account with the same mail becomes LDAP
  syncIntervalMinutes Int      @default(1440)  // scheduled sync interval (syncEnabled=true)
  lastSyncResult      Json?                    // stats or error of the last sync
  createdAt    DateTime @default(now())

  @@map("ldap_configs")
}

model OidcProvider {
  id             String   @id @default(cuid())
  domain         Domain   @relation(fields: [domainId], references: [id])
  domainId       String
  name           String
  discoveryUrl   String
  clientId       String
  clientSecret   String
  claimMap       Json     @default("{}")
  autoProvision  Boolean  @default(true)
  forcedDomains  String[] // v6.1: allowed e-mail domains for SSO (empty = the provider's own domain only)
  active         Boolean  @default(true)
  // v6.1 — OIDC login (packages/auth-sso)
  scopes               String  @default("openid email profile")
  requireEmailVerified Boolean @default(true)  // email_verified must be true (off only for IdPs that never send it)
  allowLinking         Boolean @default(false) // an existing non-SSO account with the same verified mail may log in
  requireMfa           Boolean @default(false) // CoreMail MFA after the IdP (default: the IdP is trusted as second factor)
  createdAt      DateTime @default(now())

  @@map("oidc_providers")
}

// ─────────────────────────────────────────────
// Mail Storage
// ─────────────────────────────────────────────

model Mailbox {
  id              String           @id @default(cuid())
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String?          @unique
  sharedBox       SharedMailbox?   @relation(fields: [sharedBoxId], references: [id])
  sharedBoxId     String?          @unique
  uidValidity     Int              @default(1)
  uidNext         Int              @default(1)
  highestModSeq   BigInt           @default(0)
  folders         Folder[]
  delegates       MailboxDelegate[]
  folderPermissions FolderPermission[]
  createdAt       DateTime         @default(now())

  @@map("mailboxes")
}

model Folder {
  id          String    @id @default(cuid())
  mailbox     Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  mailboxId   String
  name        String
  displayName String
  parent      Folder?   @relation("FolderTree", fields: [parentId], references: [id])
  parentId    String?
  children    Folder[]  @relation("FolderTree")
  messages    Message[]
  permissions FolderPermission[]
  totalCount  Int       @default(0)
  unreadCount Int       @default(0)
  changeKey   String    @default("")
  subscribed  Boolean   @default(true)
  isFavorite  Boolean   @default(false)
  sortOrder   Int       @default(0)
  color       String?
  createdAt   DateTime  @default(now())
  // Personal tag on folder (user assignment)
  retentionTag   RetentionTag? @relation("FolderRetentionTag", fields: [retentionTagId], references: [id])
  retentionTagId String?
  mapiObject     MapiObject?

  @@unique([mailboxId, name])
  @@index([mailboxId])
  @@map("folders")
}

model Message {
  id           String      @id @default(cuid())
  folder       Folder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId     String
  uid          Int
  modSeq       BigInt
  // v7.1: modSeq at which the row appeared in its mailbox (create, copy, move from
  // another mailbox); never changed afterwards. Lets JMAP Email/changes tell created
  // from updated independently of createdAt (= receivedAt, which clients may
  // backdate). Null on rows written before v7.1.
  createdModSeq BigInt?
  flags        String[]
  subject      String      @default("")
  fromAddr     String      @default("")
  fromName     String      @default("")
  toAddrs      String[]
  ccAddrs      String[]
  bccAddrs     String[]
  replyTo      String?
  messageId    String?     // RFC 2822 Message-ID header
  inReplyTo    String?
  // v9.1: References header (RFC 5322 §3.6.4) as normalized msg-ids "<a@b> <c@d>",
  // oldest first, capped at 100 ids of ≤ 998 chars (first id + the last 99).
  // '' = the message has none; null = not indexed yet (rows written before 9.1:
  // filled lazily by IMAP THREAD=REFERENCES and the background backfill,
  // REFERENCES_BACKFILL). See src/references.ts.
  references   String?
  date         DateTime
  bodyText     String      @default("")
  bodyHtml     String      @default("")
  rawSize      Int         @default(0)
  storagePath  String?     // MinIO object key for large messages
  changeKey    String      @default("")
  deletedAt    DateTime?   // soft-delete tombstone; recoverable for DELETED_ITEM_RETENTION_DAYS (v9.0, default 30), then purged
  // Phase 9: S/MIME metadata JSON — { signed, valid, signerEmail, decrypted, ... }
  smimeMeta    String?
  pinnedAt     DateTime?   // user pinned this message (top of list)
  snoozeUntil  DateTime?   // hide until this time, then reappear in inbox
  // Phase 10: spam persistence (rspamd score at delivery time)
  spamScore    Float?      // null = not scanned, 0..15 = rspamd score
  // Phase 10: scheduled send — the mail is created in "Sent Items" immediately,
  // but only sent at the scheduled time via BullMQ delay.
  scheduledAt     DateTime?   // time of the scheduled send
  scheduledStatus String?     // 'PENDING' | 'SENT' | 'CANCELLED' | null
  scheduledJobId  String?     // BullMQ job ID for cancellation (delay job in smtp-outbound)
  // ── Retention (Phase 9, tag-based) ───────────────────────────────────────────
  // Effective tag computed by the MFA or set by the user
  retentionTag     RetentionTag? @relation("MessageRetentionTag", fields: [retentionTagId], references: [id])
  retentionTagId   String?
  // Computed time from which the tag action is executed (date + retentionDays)
  retentionExpiresAt DateTime?
  // When the item was moved to "Recoverable Items\Deletions" by the MFA (soft delete)
  softDeletedAt    DateTime?
  // v5.7.1: JMAP thread assignment (RFC 8621 §3). Set lazily by the jmap-server:
  // reply (inReplyTo) to a known message → its threadId, otherwise own id.
  threadId         String?
  // 9.4: address of the Disposition-Notification-To header at delivery (read
  // receipt requested); null = none, or delivered before 9.4. The receipt route
  // re-reads the raw header before it answers.
  dispositionNotificationTo String?
  // 9.4: Importance / X-Priority of the message ("high" | "low"), null = normal.
  // Set at delivery, for drafts and their Sent copies; JMAP/EAS do not use it.
  importance       String?
  // 9.4: Sensitivity header of the message ("personal" | "private" |
  // "confidential"), null = normal. Set like importance; the reader shows a badge.
  sensitivity      String?
  // 9.4: follow-up flag of the message ("Zur Nachverfolgung"). 'none' | 'flagged' |
  // 'complete'. Kept in step with the \Flagged keyword by message-store
  // (flagged ⇔ \Flagged; complete clears \Flagged). Rows written before 9.4
  // keep 'none' — readers derive 'flagged' from \Flagged (follow-up.ts).
  flagStatus       String    @default("none")
  flagStartAt      DateTime?
  flagDueAt        DateTime?
  flagReminderAt   DateTime?
  flagCompletedAt  DateTime?
  // w3 folder permissions: the user (grantee of a folder permission) who created
  // the item in a foreign folder (IMAP APPEND / COPY into it) — "own" items for
  // the EditOwned / DeleteOwned rights. Null = not created by a grantee.
  createdBy        String?
  // 9.5: when the backup restore wrote this row (createdAt keeps the original
  // received date). Retention policies give a restored item a grace period from
  // this time (backup-service retention/expiry.ts). Null = not restored.
  restoredAt       DateTime?
  attachments  Attachment[]
  categories   MessageCategory[]
  mapiObject   MapiObject?
  createdAt    DateTime    @default(now())

  @@unique([folderId, uid])
  @@index([folderId, date])
  @@index([folderId, modSeq])
  @@index([messageId])
  @@index([deletedAt])
  @@index([snoozeUntil])
  @@index([retentionTagId])
  @@index([retentionExpiresAt])
  @@index([softDeletedAt])
  @@index([threadId])
  @@index([flagStatus])
  // 10.2: trigram GIN index for the substring search (ILIKE '%…%') of the search
  // suggestions and /mail/search (subject, sender name, sender address). Maintained
  // by PostgreSQL on every insert/update — no application-side indexing. docs/search.md
  @@index([subject(ops: raw("gin_trgm_ops")), fromName(ops: raw("gin_trgm_ops")), fromAddr(ops: raw("gin_trgm_ops"))], type: Gin, map: "messages_search_trgm_idx") // schema-sync:optional pg_trgm
  @@map("messages")
}

model Attachment {
  id          String   @id @default(cuid())
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId   String
  contentId   String?
  filename    String
  mimeType    String
  size        Int
  sha256      String
  storagePath String
  inline      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([messageId])
  @@index([sha256])
  @@map("attachments")
}

// ─────────────────────────────────────────────
// Mail categories (coloured tags)
// ─────────────────────────────────────────────
model Category {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  color      String   @default("#3B82F6")
  isFavorite Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  messages   MessageCategory[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model MessageCategory {
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId  String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  assignedAt DateTime @default(now())

  @@id([messageId, categoryId])
  @@index([categoryId])
  @@map("message_categories")
}

// ─────────────────────────────────────────────
// Shared Mailboxes
// ─────────────────────────────────────────────

model SharedMailbox {
  id          String              @id @default(cuid())
  email       String              @unique
  displayName String
  domain      Domain              @relation(fields: [domainId], references: [id])
  domainId    String
  quotaBytes  BigInt              @default(10737418240)
  usedBytes   BigInt              @default(0)
  // v9.0: quota levels, see User.quotaWarningBytes
  quotaWarningBytes      BigInt?
  quotaProhibitSendBytes BigInt?
  quotaWarnedAt          DateTime?
  active      Boolean             @default(true)
  // 9.4: copy of mail sent as / on behalf of this mailbox into its own Sent folder
  // (in addition to the sender's own Sent; storage src/shared-sent-copy.ts)
  sentCopySendAs       Boolean    @default(false)
  sentCopySendOnBehalf Boolean    @default(false)
  permissions SharedMailboxPerm[]
  mailbox     Mailbox?
  aliases     EmailAlias[]        @relation("SharedMailboxAliases")
  // 9.4: per-mailbox mail flow (GAL visibility, forwarding, sender lists, limits)
  mailFlowPolicy MailFlowPolicy?
  createdAt   DateTime            @default(now())

  @@index([domainId])
  @@map("shared_mailboxes")
}

// ── E-mail aliases ────────────────────────────────────────────────────────────
// An alias is an additional receiving address whose mail is delivered to an existing
// mailbox (user or shared mailbox). Exactly ONE target must be
// set (targetUserId XOR targetSharedId) — validated in application code,
// Prisma cannot express this directly.
model EmailAlias {
  id              String         @id @default(cuid())
  // Full e-mail address, e.g. "info@firma.com" — case-insensitive unique
  address         String         @unique
  // Local part before the @ (for UI display, sorting)
  localPart       String
  // The domain the alias address belongs to (FK)
  domain          Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId        String
  // Target: user mailbox
  targetUser      User?          @relation("UserAliases", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUserId    String?
  // Target: Shared Mailbox
  targetShared    SharedMailbox? @relation("SharedMailboxAliases", fields: [targetSharedId], references: [id], onDelete: Cascade)
  targetSharedId  String?
  description     String         @default("")
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([targetUserId])
  @@index([targetSharedId])
  @@index([domainId])
  @@map("email_aliases")
}

model SharedMailboxPerm {
  id              String               @id @default(cuid())
  sharedMailbox   SharedMailbox        @relation(fields: [sharedMailboxId], references: [id], onDelete: Cascade)
  sharedMailboxId String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  permission      SharedMailboxPermType
  // 9.4: auto-mapping — the mailbox appears in the grantee's webmail folder pane
  // and IMAP namespace on its own; false = only after the grantee adds it
  // (UserSettings.addedSharedMailboxes). Read from the FULL_ACCESS/READ_ONLY row.
  autoMap         Boolean              @default(true)
  grantedAt       DateTime             @default(now())
  grantedBy       String

  // Multiple permissions per user possible (Full Access + Send As + …)
  @@unique([sharedMailboxId, userId, permission])
  @@index([sharedMailboxId, userId])
  @@map("shared_mailbox_perms")
}

// ─────────────────────────────────────────────
// Mailbox delegation (user mailbox access rights)
// ─────────────────────────────────────────────
// Gives user B access to the mailbox of user A (delegate access)
// Permissions analogous to SharedMailboxPerm: FULL_ACCESS / SEND_AS / SEND_ON_BEHALF / READ_ONLY
model MailboxDelegate {
  id          String               @id @default(cuid())
  mailbox     Mailbox              @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  mailboxId   String
  grantee     User                 @relation("MailboxDelegateGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  granteeId   String
  permission  SharedMailboxPermType
  // 9.4: auto-mapping, see SharedMailboxPerm.autoMap
  autoMap     Boolean              @default(true)
  grantedAt   DateTime             @default(now())
  grantedBy   String

  @@unique([mailboxId, granteeId])
  @@index([granteeId])
  @@map("mailbox_delegates")
}

// w3 folder permissions ("Berechtigungen" of a folder): a role on one
// folder of a mailbox for one user or for "Default" (every user of the
// organisation). `rights` is the member-rights bitmask (storage
// folder-permissions.ts). "Anonymous" is never stored (always none for mail).
// Mailbox-level grants (SharedMailboxPerm / MailboxDelegate) stay a floor:
// FULL_ACCESS is always full, READ_ONLY always reads; folder grants add rights.
model FolderPermission {
  id          String   @id @default(cuid())
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId    String
  // Denormalised for the per-user lookups (every grant of a mailbox at once).
  mailbox     Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  mailboxId   String
  // "default" or "user:<userId>" — one row per folder and grantee.
  granteeKey  String
  grantee     User?    @relation("FolderPermissionGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  granteeId   String?
  rights      Int
  // Also valid for subfolders that have no entry of their own for the grantee.
  applyToSubfolders Boolean @default(false)
  grantedBy   String
  grantedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([folderId, granteeKey])
  @@index([granteeId])
  @@index([mailboxId])
  @@index([granteeKey])
  @@map("folder_permissions")
}

// ─────────────────────────────────────────────
// Calendaring
// ─────────────────────────────────────────────

model Calendar {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  color       String          @default("#0078D4")
  icon        String?         // lucide icon name (e.g. "Home", "Plane")
  sortOrder   Int             @default(0)
  isDefault   Boolean         @default(false)
  syncToken   String          @default("")
  events      CalendarEvent[]
  shares      CalendarShare[]
  createdAt   DateTime        @default(now())

  @@index([userId])
  @@map("calendars")
}

enum CalendarPermType {
  READ
  WRITE
}

model CalendarShare {
  id         String           @id @default(cuid())
  calendar   Calendar         @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId String
  owner      User             @relation("CalendarShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  grantee    User             @relation("CalendarShareGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  granteeId  String
  permission CalendarPermType
  comment    String?
  // v3.18.16 A3: grantee-local color (overrides the owner color only for this user)
  localColor String?
  // v3.18.16 A8: grantee-local sort order in the "Shared with me" section
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())

  @@unique([calendarId, granteeId])
  @@index([granteeId])
  @@index([calendarId])
  @@map("calendar_shares")
}

model CalendarEvent {
  id          String   @id @default(cuid())
  calendar    Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId  String
  // iCal UID — unique per calendar (RFC 4791 §5.3.2.1), not server-wide: organizer
  // and invitees on the same server keep their own copy of a meeting (v7.1.0).
  uid         String
  icalData    String
  summary     String
  description String   @default("")
  location    String   @default("")
  dtStart     DateTime
  dtEnd       DateTime
  allDay      Boolean  @default(false)
  recurring   Boolean  @default(false)
  rrule       String?
  organizer   String?
  attendees   Json     @default("[]")
  status      String   @default("CONFIRMED")
  // v3.18.15: privacy level for shared calendars. Values: PUBLIC | PRIVATE | CONFIDENTIAL
  //  PUBLIC       → details visible to owner and all grantees (default)
  //  PRIVATE      → grantees only see "Busy", no details (subject/location/notes masked)
  //  CONFIDENTIAL → grantees do not see the event at all (completely hidden)
  // The owner sees ALL events unchanged. Maps to iCal `CLASS:` (RFC 5545 §3.8.1.3).
  classification String @default("PUBLIC")
  // 9.4: "Anzeigen als" of the master — FREE | TENTATIVE | BUSY | OOF (iCal TRANSP +
  // X-MICROSOFT-CDO-BUSYSTATUS in icalData; overrides carry their own value there).
  showAs      String   @default("BUSY")
  // v3.18.25 A5: iMIP/iTIP — sequence counter is incremented on every UPDATE (subject,
  // date, attendee change). Mail clients only show
  // the HIGHEST sequence — old REPLY mails with a lower sequence are
  // ignored.
  sequence    Int      @default(0)
  changeKey   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([calendarId, uid])
  @@index([calendarId, dtStart])
  @@index([uid])
  @@map("calendar_events")
}

// ─────────────────────────────────────────────
// Contacts
// ─────────────────────────────────────────────

model Contact {
  id          String  @id @default(cuid())
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  vcardData   String
  displayName String
  email       String  @default("")
  email2      String  @default("")
  phone       String  @default("")
  mobile      String  @default("")
  company     String  @default("")
  department  String  @default("")
  jobTitle    String  @default("")
  notes       String  @default("")
  photoUrl    String?
  changeKey   String  @default("")
  // 9.5: structured contact fields. vcardData stays the source of truth; every
  // column below (and the flat ones above) is derived from it in ONE place:
  // storage contacts/contact-vcard.ts contactColumnsFromVcard().
  uid         String   @default("")   // vCard UID without "urn:uuid:" (group members reference it)
  givenName   String   @default("")
  familyName  String   @default("")
  middleName  String   @default("")
  namePrefix  String   @default("")
  nameSuffix  String   @default("")
  nickname    String   @default("")
  fileAs      String   @default("")
  birthday    String   @default("")   // "YYYY-MM-DD" or "--MM-DD" (no year), "" = none
  anniversary String   @default("")   // same format as birthday
  categories  String[] @default([])
  emails      Json     @default("[]") // [{type: work|home|other, value}]
  phones      Json     @default("[]") // [{type: work|home|mobile|fax|pager|other, value}]
  addresses   Json     @default("[]") // [{type, street, city, region, postalCode, country, poBox, extended}]
  urls        Json     @default("[]") // [{type, value}]
  ims         Json     @default("[]") // [{type, value}] (IMPP URI)
  searchText  String   @default("")   // lower-case text of all fields (REST search)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([email])
  @@index([userId, uid])
  @@map("contacts")
}

// 9.5: contact groups ("Kontaktlisten"), an address object of their own in
// CardDAV (vCard 4 KIND:group + MEMBER or the X-ADDRESSBOOKSERVER-KIND/-MEMBER
// form). members and vcardData are kept in step by storage contacts/contact-groups.ts.
model ContactGroup {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  uid       String   @default("")  // vCard UID without "urn:uuid:"
  name      String
  vcardData String
  // [{kind: "card", uid}] (own contact or nested group) | [{kind: "address", address, name}]
  members   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, uid])
  @@map("contact_groups")
}

// ─────────────────────────────────────────────
// Tasks & Notes
// ─────────────────────────────────────────────

model Task {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  body        String   @default("")
  status      String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED | WAITING | DEFERRED
  priority    String   @default("NORMAL")       // LOW | NORMAL | HIGH
  dueDate     DateTime?
  completedAt DateTime?
  reminder       DateTime?
  reminderByMail Boolean   @default(false)
  // 9.4: full task form (all additive)
  startDate         DateTime?
  percentComplete   Int       @default(0)       // 0..100, kept in step with status (task-rules.ts)
  isPrivate         Boolean   @default(false)
  rrule             String?                     // recurring task: RECUR value; completing creates the next one
  totalWorkMinutes  Int?                        // "Gesamtaufwand"
  actualWorkMinutes Int?                        // "Ist-Aufwand"
  mileage           String    @default("")
  billingInfo       String    @default("")
  companies         String    @default("")
  bodyHtml          String    @default("")      // rich-text note (sanitised on display); body = plain text
  changeKey      String    @default("")
  // 9.5: CalDAV task list — iCal UID of the VTODO (null = the task id) and the VTODO a
  // CalDAV client stored last (unknown properties such as CATEGORIES round-trip; the
  // columns above win on every read — caldav-server src/caldav/vtodo.ts)
  uid            String?
  icalData       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, uid])
  @@index([userId])
  @@map("tasks")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  subject   String   @default("Notiz")
  body      String   @default("")
  color     String   @default("YELLOW")
  // 9.5: category names (the user's category list, as for mail)
  categories String[] @default([])
  changeKey String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notes")
}

// ─────────────────────────────────────────────
// User Settings & Mail Rules
// ─────────────────────────────────────────────

model UserSettings {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  signature               String    @default("")
  signatureAutoNew        Boolean   @default(true)
  signatureAutoReply      Boolean   @default(false)
  oofEnabled              Boolean   @default(false)
  oofInternal             String    @default("")
  oofExternal             String    @default("")
  oofExternalEnabled      Boolean   @default(true)
  oofExternalOnlyContacts Boolean   @default(false)
  oofUseTimeRange         Boolean   @default(false)
  oofStart                DateTime?
  oofEnd                  DateTime?
  // v9.0: identifies the current out-of-office period — renewed whenever OOF is
  // switched on or its texts/period change; one auto-reply per sender per period.
  oofPeriodId             String    @default("")
  // Personal inactivity timeout (null = use global setting)
  inactivityTimeoutMinutes Int?
  // 9.3: shared / delegated mailboxes the user hid from the webmail folder pane
  // ("shared:<sharedMailboxId>" / "delegated:<mailboxId>"; access itself is unchanged)
  hiddenSharedMailboxes   String[]  @default([])
  // 9.4: roaming webmail preferences (view, theme, regional, reading, compose,
  // calendar, signature defaults) as versioned JSON — validated and defaulted by
  // api-gateway lib/user-preferences.ts. '{}' = never written (the webmail then
  // imports its browser values once).
  preferences             Json      @default("{}")
  // 9.4: mailboxes granted without auto-mapping that the user added to the folder
  // pane / IMAP namespace (same ref format as hiddenSharedMailboxes)
  addedSharedMailboxes    String[]  @default([])
  updatedAt               DateTime  @updatedAt

  @@map("user_settings")
}

// 9.4: named signatures (several per user). Which one is inserted for new mails /
// replies per identity (own mailbox, shared mailbox) lives in
// UserSettings.preferences (signatures.defaults). UserSettings.signature mirrors
// the own default for new mails (JMAP Identity, pre-9.4 /user/signature clients).
model UserSignature {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  html      String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_signatures")
}

/// Personal mail templates ("Vorlagen", 10.1): subject, body and recipients a
/// new mail starts from. Own templates only; no attachments. The body is
/// untrusted HTML — sanitised by the webmail before saving and on every display.
model MailTemplate {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  subject   String   @default("")
  bodyHtml  String   @default("")
  bodyText  String   @default("")
  toAddrs   String[] @default([])
  ccAddrs   String[] @default([])
  bccAddrs  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("mail_templates")
}

model MailRule {
  id             String   @id @default(cuid())
  userId         String
  name           String
  enabled        Boolean  @default(true)
  priority       Int      @default(0)
  conditions     Json     @default("[]")
  exceptions     Json     @default("[]")
  actions        Json     @default("[]")
  stopProcessing Boolean  @default(false)
  matchAll       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, priority])
  @@map("mail_rules")
}

// ─────────────────────────────────────────────
// Backup Jobs
// ─────────────────────────────────────────────

model BackupJob {
  id          String    @id @default(cuid())
  userId      String?
  scope       String    // "user" | "domain" | "full"
  format      String    // "mbox" | "eml" | "full" | "zip"
  status      JobStatus @default(PENDING)
  progress    Int       @default(0)
  downloadUrl String?
  expiresAt   DateTime?
  errorMsg    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  // v3.18.26 — extended status logging fields (see v3.18.26 research)
  startedAt   DateTime?
  durationMs  Int?              // (finishedAt - startedAt) — for RTO measurement
  sizeBytes   BigInt?           // backup size in the S3 bucket
  messageCount Int?             // how many messages the backup contained
  errorClass  String?           // NETWORK | STORAGE | PERMISSION | CORRUPT | UNKNOWN
  retryCount  Int       @default(0)
  triggeredBy String    @default("MANUAL")  // CRON | MANUAL | EVENT | RESTORE | API
  progressMeta Json?    @default("{}")      // { phase, current, total, currentFolder }
  scheduleId  String?              // reference to BackupSchedule when triggered by a schedule

  @@index([userId])
  @@index([status])
  @@index([scheduleId])
  @@map("backup_jobs")
}

/// v3.18.26 — backup scheduling in the DB instead of an env variable.
/// Admins can define cron expressions, choose a format, filter target users.
model BackupSchedule {
  id           String    @id @default(cuid())
  name         String                              // descriptive name, e.g. "Daily Full Backup"
  cron         String                              // cron expression, e.g. "0 2 * * *"
  enabled      Boolean   @default(true)
  scope        String    @default("full")          // user | full | domain
  format       String    @default("zip")           // mbox | zip | eml
  targetUserId String?                              // null = all users
  retentionDays Int      @default(30)              // snapshot is deleted after this many days
  lastRunAt    DateTime?
  lastStatus   String?                              // last JobStatus
  lastJobId    String?                              // reference to the last BackupJob
  nextRunAt    DateTime?                            // computed by the scheduler
  createdBy    String?                              // userId of the admin who created the schedule
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([enabled])
  @@map("backup_schedules")
}

// ─────────────────────────────────────────────
// System Logs
// ─────────────────────────────────────────────

model SystemLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     LogLevel
  service   String
  category  String   @default("SYSTEM")
  message   String
  metadata  Json?
  userId    String?
  messageId String?

  @@index([timestamp])
  @@index([service, timestamp])
  @@index([level, timestamp])
  @@index([category, timestamp])
  @@map("system_logs")
}

// ─────────────────────────────────────────────
// Security Filter
// ─────────────────────────────────────────────

model Blacklist {
  id         String   @id @default(cuid())
  pattern    String
  patternType String  @default("EXACT") // EXACT | WILDCARD | REGEX
  scope      String   @default("GLOBAL") // GLOBAL | DOMAIN | USER (| USER-JUNK: webmail "Junk" action)
  scopeId    String?  // domainId or userId for non-global
  // 9.4: BLOCK (refused at RCPT TO) | ALLOW (overrides a block, skips the spam verdict
  // when the sender domain is authenticated) — BCP → Protection → Sender lists
  listType   String   @default("BLOCK")
  comment    String   @default("")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([scope, scopeId])
  @@map("blacklist")
}

model Quarantine {
  id          String   @id @default(cuid())
  messageId   String?
  fromAddr    String
  toAddr      String
  subject     String   @default("")
  reason      String   // VIRUS | SPAM | POLICY
  details     Json     @default("{}")
  rawPath     String   // MinIO path to raw message
  released    Boolean  @default(false)
  releasedAt  DateTime?
  releasedBy  String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([reason])
  @@map("quarantine")
}

// ─────────────────────────────────────────────
// Phase 6 — ActiveSync (EAS)
// ─────────────────────────────────────────────

model ActiveSyncDevice {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId        String   // EAS DeviceId header
  deviceType      String   @default("")  // EAS DeviceType (iPhone, Android, etc.)
  deviceFriendlyName String @default("")
  policyKey       String   @default("0")   // final key ([MS-ASPROV] phase 2); "0" = not provisioned
  pendingPolicyKey String?                 // temporary key of a phase-1 Provision, until acknowledged
  // OK | PENDING (awaiting approval — refused) | BLOCKED (refused, Status 129)
  // | WIPED (remote wipe requested: Provision answers RemoteWipe, everything else Status 140)
  status          String   @default("OK")
  // last negotiated MS-ASProtocolVersion (12.1 | 14.0 | 14.1); fallback for a request without one
  protocolVersion String?
  lastSyncAt      DateTime?
  remoteWipeAt    DateTime?                // wipe requested by an admin
  remoteWipeAckAt DateTime?                // device acknowledged the wipe (Provision RemoteWipe Status)
  createdAt       DateTime @default(now())
  folderSyncKey   String   @default("0")
  // folderId → issued SyncKey; `ack:<folderId>` → acknowledged SyncKey; `opts:<folderId>` →
  // sticky Sync options; `ping` → last Ping parameters; `folders` → FolderSync snapshot
  syncKeys        Json     @default("{}")
  items           ActiveSyncItem[]

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("active_sync_devices")
}

// v7.1: which ServerIds a device holds per collection and the message modSeq it holds them at.
// Drives Sync Add vs Change, Delete for items removed/moved away, and suppresses echoes of the
// device's own changes (Sync Change, MoveItems). Rows with pendingKey != "" were sent in the
// response that issued that SyncKey and become the committed state ("") when the device
// presents that key; a retry with the previous key discards them.
model ActiveSyncItem {
  deviceRowId  String
  device       ActiveSyncDevice @relation(fields: [deviceRowId], references: [id], onDelete: Cascade)
  collectionId String
  serverId     String
  pendingKey   String   @default("")
  modSeq       BigInt?  // null only on a pending Delete

  @@id([deviceRowId, collectionId, serverId, pendingKey])
  @@index([deviceRowId, collectionId, pendingKey])
  @@map("active_sync_items")
}

// MAPI over HTTP cached mode (9.5, docs/mapi.md): an object a desktop client created keeps the ID
// the client assigned from its RopGetLocalReplicaIds ranges (clientId, MS-OXCFXICS 3.3.5.2.1) —
// also when a draft is saved again (new row, same ID); pcl = PidTagPredecessorChangeList of the
// version a client uploaded (conflict detection, 3.1.5.6). The row outlives its object
// (SetNull): a retired client ID is still reported deleted to the client.
model MapiObject {
  id        String   @id @default(cuid())
  mailboxId String
  clientId  BigInt?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageId String?  @unique
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId  String?  @unique
  pcl       Bytes?
  updatedAt DateTime @updatedAt

  @@unique([mailboxId, clientId])
  @@index([mailboxId])
  @@map("mapi_objects")
}

// ─────────────────────────────────────────────
// Phase 6 — S/MIME Certificates
// ─────────────────────────────────────────────

model UserCertificate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("My Certificate")
  fingerprint   String   @unique  // SHA-256 hex
  subject       String   // X.509 Subject DN
  issuer        String   // X.509 Issuer DN
  notBefore     DateTime
  notAfter      DateTime
  storagePath   String   // MinIO path to encrypted PKCS#12
  signingDefault Boolean @default(false)
  encryptDefault Boolean @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("user_certificates")
}

