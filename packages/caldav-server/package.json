{
  "name": "@coremail/caldav-server",
  "version": "10.6.1",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "node --import tsx --import ../storage/src/test-support/realtime-off.ts --test src/auth.test.ts src/dav-utils.test.ts src/caldav/routing.test.ts src/caldav/vtodo.test.ts src/caldav/tasks.test.ts src/carddav/carddav.test.ts"
  },
  "dependencies": {
    "@coremail/auth-ldap": "workspace:*",
    "@coremail/core": "workspace:*",
    "@coremail/storage": "workspace:*",
    "express": "^4.22.3",
    "ical.js": "^2.0.1",
    "uuid": "^10.0.0",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
