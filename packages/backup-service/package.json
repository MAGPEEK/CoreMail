{
  "name": "@coremail/backup-service",
  "version": "9.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/retention/expiry.test.ts src/http-utils.test.ts src/export/mbox.test.ts src/scheduler/locks.test.ts src/crypto/backup-crypto.test.ts src/crypto/encrypt-stream.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@coremail/core": "workspace:*",
    "@coremail/storage": "workspace:*",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "archiver": "^7.0.1",
    "cron": "^3.1.7",
    "express": "^4.22.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
