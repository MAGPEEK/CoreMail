{
  "name": "@coremail/jmap-server",
  "version": "5.8.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --import ./src/test-env.ts --test src/dispatcher.test.ts src/state.test.ts src/mail/keywords.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@coremail/core": "workspace:*",
    "@coremail/storage": "workspace:*",
    "bullmq": "^5.76.6",
    "express": "^4.19.2",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.15",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/web-push": "^3.6.3",
    "@types/ws": "^8.5.12",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
